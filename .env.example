# Same existing Sanity project and dataset for the website and Studio.
PUBLIC_SANITY_PROJECT_ID=46mghxoy
PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=46mghxoy
SANITY_STUDIO_DATASET=production
# Only needed for a private dataset. Never prefix a token with PUBLIC_ or SANITY_STUDIO_.
SANITY_API_READ_TOKEN=
# Optional confirmed public URL, for canonical links. Defaults to https://ergysshehu.com.
SITE_URL=
# Instagram Graph API token, used server/build-time only in src/lib/instagram.ts.
# Never prefix with PUBLIC_ or SANITY_STUDIO_. Never commit the real value.
INSTAGRAM_ACCESS_TOKEN=
