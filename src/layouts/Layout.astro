---
import '../styles/portfolio.css';
import {defaults} from '../lib/editorial';
import SocialIcons from '../components/SocialIcons.astro';
interface Props {title?:string;description?:string;name?:string;home?:boolean;image?:string}
const {title='Ergys Shehu — Photographer / Director',description=defaults.seoDescription,name=defaults.name,home=false,image='/images/ergys-shehu-logo.png'}=Astro.props;
const pageUrl=Astro.site?new URL(Astro.url.pathname,Astro.site):undefined;
const imageUrl=Astro.site?new URL(image,Astro.site):undefined;
const personLd={'@context':'https://schema.org','@type':'Person',name:defaults.name,jobTitle:'Photographer & Director',url:'https://ergysshehu.com',sameAs:[defaults.instagram].filter(Boolean),description:defaults.seoDescription};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="icon" href="/favicon.svg"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet"/>{pageUrl && <link rel="canonical" href={pageUrl}/>}<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:site_name" content="Ergys Shehu"/>{pageUrl && <meta property="og:url" content={pageUrl}/>}{imageUrl && <meta property="og:image" content={imageUrl}/>}<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>{imageUrl && <meta name="twitter:image" content={imageUrl}/>}<script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)}/></head>
<body class:list={[{'is-home':home}]}><a class="skip" href="#main" data-en="Skip to content" data-sq="Kalo te përmbajtja">Skip to content</a><div class="scroll-progress" aria-hidden="true"></div><header class="site-header"><a class="ergys-wordmark" href="/" aria-label={name+' home'}><span class="ergys-wordmark-strong">ERGYS</span><span class="ergys-wordmark-light">SHEHU</span></a><nav class="desktop-nav" aria-label="Primary"><a href="/fashion/" data-en="Fashion" data-sq="Modë">Fashion</a><a href="/portraits/" data-en="Portraits" data-sq="Portrete">Portraits</a><a href="/weddings/" data-en="Weddings" data-sq="Dasma">Weddings</a><a href="/films/" data-en="Motion" data-sq="Video">Motion</a><a href="/projects/" data-en="Index" data-sq="Indeksi">Index</a><a href="/about/" data-en="About" data-sq="Rreth">About</a><a href="/journal/" data-en="Journal" data-sq="Ditari">Journal</a><a class="nav-book" href="/book/#contact" data-en="Book now ↗" data-sq="Rezervo ↗">Book now ↗</a><div class="language-switch" data-active="en" role="group" aria-label="Language / Gjuha"><button type="button" data-lang="en" class="is-active" aria-pressed="true">EN</button><button type="button" data-lang="sq" aria-pressed="false">SQ</button></div></nav><details class="mobile-menu"><summary aria-label="Open navigation"><span class="hamburger"><i></i><i></i><i></i></span></summary><div class="mobile-menu-screen"><div class="mobile-menu-head"><a class="mobile-menu-brand" href="/" aria-label={name+' home'}><span class="mobile-menu-brand-strong">ERGYS</span><span class="mobile-menu-brand-light">SHEHU</span></a><button type="button" class="mobile-menu-close" data-menu-close aria-label="Close navigation">✕</button></div><nav aria-label="Mobile navigation"><a href="/#selected" data-en="Photography" data-sq="Fotografi">Photography</a><a href="/fashion/" data-en="Fashion" data-sq="Modë">Fashion</a><a href="/portraits/" data-en="Portraits" data-sq="Portrete">Portraits</a><a href="/weddings/" data-en="Weddings" data-sq="Dasma">Weddings</a><a href="/films/" data-en="Motion" data-sq="Video">Motion</a><a href="/projects/" data-en="Index" data-sq="Indeksi">Index</a><a href="/about/" data-en="About" data-sq="Rreth">About</a><a href="/journal/" data-en="Journal" data-sq="Ditari">Journal</a><a href="/book/#contact" data-en="Contact" data-sq="Kontakt">Contact</a></nav><div class="mobile-menu-footer"><div class="language-switch" data-active="en" role="group" aria-label="Language / Gjuha"><button type="button" data-lang="en" class="is-active" aria-pressed="true">EN</button><button type="button" data-lang="sq" aria-pressed="false">SQ</button></div><a class="mobile-book" href="/book/#contact" data-en="Book now ↗" data-sq="Rezervo ↗">Book now ↗</a><div class="mobile-footer-row"><SocialIcons class="mobile-social"/><div class="mobile-location"><span data-en="Albania" data-sq="Shqipëri">Albania</span><span data-en="Available worldwide" data-sq="I disponueshëm në mbarë botën">Available worldwide</span></div></div></div></div></details></header>
<main id="main"><slot/></main><footer><div class="footer-row"><a href="/" class="footer-name" data-reveal>{name}</a><SocialIcons class="footer-social"/><a class="footer-contact" href="/book/#contact" data-reveal data-en="CONTACT ↗" data-sq="KONTAKT ↗">CONTACT ↗</a></div><span data-reveal data-en={`© ${new Date().getFullYear()} ERGYS SHEHU · ALL RIGHTS RESERVED`} data-sq={`© ${new Date().getFullYear()} ERGYS SHEHU · TË GJITHA TË DREJTAT TË REZERVUARA`}>© {new Date().getFullYear()} ERGYS SHEHU · ALL RIGHTS RESERVED</span><a href="#main" data-reveal data-en="BACK TO TOP ↑" data-sq="KTHEHU LART ↑">BACK TO TOP ↑</a></footer>
<script>
document.documentElement.classList.add('motion-ready');
const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');

// Site-wide EN/SQ toggle. Swaps any [data-en]/[data-sq] pair on the current
// page and remembers the choice (shared across pages via one storage key).
// Pages that haven't marked their body copy yet just keep showing English
// there — this only guarantees the header/footer/nav translate everywhere.
const LANG_KEY='site-lang';
function currentLang(){try{return localStorage.getItem(LANG_KEY)||'en'}catch{return 'en'}}
function applyLang(lang:string){
  document.querySelectorAll<HTMLElement>('[data-en]').forEach(el=>{
    const text=lang==='sq'?el.dataset.sq:el.dataset.en;
    if(text!=null)el.textContent=text;
  });
  document.querySelectorAll('[data-en-placeholder]').forEach(el=>{
    if(!(el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement))return;
    const text=lang==='sq'?el.dataset.sqPlaceholder:el.dataset.enPlaceholder;
    if(text!=null)el.placeholder=text;
  });
  document.querySelectorAll('[data-lang]').forEach(btn=>{
    btn.classList.toggle('is-active',(btn as HTMLElement).dataset.lang===lang);
    btn.setAttribute('aria-pressed',String((btn as HTMLElement).dataset.lang===lang));
  });
  document.querySelectorAll<HTMLElement>('.language-switch').forEach(el=>el.dataset.active=lang);
  document.documentElement.lang=lang;
  try{localStorage.setItem(LANG_KEY,lang)}catch{}
}
applyLang(currentLang());
document.querySelectorAll('[data-lang]').forEach(btn=>btn.addEventListener('click',()=>applyLang((btn as HTMLElement).dataset.lang||'en')));

// Mobile menu: close on link click, Escape, and lock body scroll while open.
const mobileMenu=document.querySelector<HTMLDetailsElement>('.mobile-menu');
document.querySelectorAll('.mobile-menu a').forEach(a=>a.addEventListener('click',()=>{if(mobileMenu)mobileMenu.open=false}));
document.querySelector('[data-menu-close]')?.addEventListener('click',()=>{if(mobileMenu)mobileMenu.open=false});
document.addEventListener('keydown',e=>{if(e.key==='Escape' && mobileMenu?.open){mobileMenu.open=false;mobileMenu.querySelector('summary')?.focus()}});
mobileMenu?.addEventListener('toggle',()=>document.documentElement.classList.toggle('mobile-menu-open',mobileMenu.open));

// Section / element reveals — safe by construction: the CSS only hides content
// once 'motion-ready' is set, and everything is force-shown after a short delay
// regardless of scroll or observer behaviour, so nothing can stay permanently hidden.
if('IntersectionObserver' in window){
  const revealTargets=document.querySelectorAll<HTMLElement>('[data-reveal],[data-image-reveal]');
  if(revealTargets.length){
    const io=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');io.unobserve(entry.target)}})},{threshold:0,rootMargin:'0px 0px -5% 0px'});
    revealTargets.forEach(el=>io.observe(el));
    setTimeout(()=>revealTargets.forEach(el=>el.classList.add('is-visible')),4000);
  }

  // Mobile-only: on the single-column stacked category grid, tint the page
  // background to match whichever card is currently most in view. On
  // desktop's multi-column grid this looked broken on sparse categories (one
  // or two projects meant a huge flat color filling the whole screen), so
  // it's scoped back to mobile, where every card has real scroll room first.
  const stackGrid=document.querySelector<HTMLElement>('.project-grid');
  if(stackGrid && window.matchMedia('(max-width: 700px)').matches){
    const cards=Array.from(stackGrid.querySelectorAll<HTMLElement>('.project-card'));
    if(cards.length){
      // A single IntersectionObserver with many thresholds gives us each
      // card's real intersection ratio as it scrolls under the next one —
      // no getBoundingClientRect()/offsetTop math (which broke down once a
      // card was pinned by position:sticky in this browser — both start
      // mirroring scrollY once "stuck").
      //
      // Card[i]'s melt is driven ONLY by card[i+1]'s ratio, never its own:
      // the incoming card is what's covering it, so as card[i+1] rises
      // into view (ratio 0→1) card[i] melts into darkness underneath it.
      // The card that's actually on top (whichever one nothing is yet
      // covering it) always stays a flat, untouched sharp — never blurred
      // by its own visibility dropping as it scrolls away later, since by
      // then it's not what's being looked at.
      const ratios=new Map<HTMLElement,number>();
      const progress=new Map<HTMLElement,number>();
      const cardImgs=new Map<HTMLElement,HTMLElement|null>();
      cards.forEach(c=>{progress.set(c,0);cardImgs.set(c,c.querySelector<HTMLElement>('.project-image img'))});
      const steps=Array.from({length:41},(_,i)=>i/40);
      const meltIo=new IntersectionObserver(entries=>{
        entries.forEach(entry=>{ratios.set(entry.target as HTMLElement,entry.intersectionRatio)});
      },{threshold:steps});
      cards.forEach(c=>meltIo.observe(c));
      function tickStack(){
        cards.forEach((card,i)=>{
          const nextCard=cards[i+1];
          const target=nextCard?Math.max(0,Math.min(1,ratios.get(nextCard) ?? 0)):0;
          const prev=progress.get(card) ?? 0;
          // Covering up (target rising) eases in slowly; clearing (target
          // falling) catches up fast — a gradual melt going dark, a near-
          // instant clear coming back so re-checking a photo reads live.
          const speed=target>prev?0.13:0.4;
          const next=prev+(target-prev)*speed;
          progress.set(card,next);
          const img=cardImgs.get(card);
          if(img){
            img.style.setProperty('--stack-blur',(next*9).toFixed(2)+'px');
            img.style.setProperty('--stack-brightness',(1-next*0.72).toFixed(3));
            img.style.setProperty('--stack-opacity',(1-next*0.28).toFixed(3));
            img.style.setProperty('--stack-scale',(1-next*0.015).toFixed(4));
          }
        });
        requestAnimationFrame(tickStack);
      }
      requestAnimationFrame(tickStack);
      // The black stacking panel (.work-section/.collection-body) has no
      // background of its own — body.in-stack-grid paints it black for as
      // long as any part of that panel is on screen, watched here instead
      // of just the grid so the heading above the cards turns black at the
      // same moment as the grid, not a beat later.
      const stackSection=stackGrid.closest<HTMLElement>('.work-section, .collection-body') || stackGrid;
      const gridIo=new IntersectionObserver(entries=>{
        entries.forEach(entry=>{document.body.classList.toggle('in-stack-grid',entry.isIntersecting)});
      },{threshold:0});
      gridIo.observe(stackSection);
    }
  }
}

// Light deterrent only, not real protection: block the right-click menu and
// drag-out on photos so casual saving takes an extra step. Screenshots and a
// determined visitor can never be stopped by anything running in the browser.
document.addEventListener('contextmenu',e=>{if((e.target as HTMLElement)?.closest('img'))e.preventDefault()});
document.addEventListener('dragstart',e=>{if((e.target as HTMLElement)?.closest('img'))e.preventDefault()});

// Desktop-only, fine-pointer tilt on project cards — a few px, no rotation.
if(!reducedMotion.matches && window.matchMedia('(hover: hover) and (pointer: fine)').matches){
  document.querySelectorAll<HTMLElement>('.project-card').forEach(card=>{
    card.addEventListener('pointermove',e=>{
      const r=card.getBoundingClientRect();
      const x=((e.clientX-r.left)/r.width-.5)*8;
      const y=((e.clientY-r.top)/r.height-.5)*8;
      card.style.setProperty('--tilt-x',x.toFixed(2)+'px');
      card.style.setProperty('--tilt-y',y.toFixed(2)+'px');
    });
    card.addEventListener('pointerleave',()=>{card.style.setProperty('--tilt-x','0px');card.style.setProperty('--tilt-y','0px')});
  });

  // Grid spotlight: dim every card except the one under the pointer. Tracked
  // per-grid with a short grace delay before clearing, so drifting through
  // the gap between two cards doesn't flash the whole grid back to normal
  // and immediately re-dim — that flicker is what read as "glitchy".
  document.querySelectorAll<HTMLElement>('.project-grid').forEach(grid=>{
    let clearTimer:number|undefined;
    grid.addEventListener('pointerover',e=>{
      const card=(e.target as HTMLElement).closest('.project-card');
      if(!card)return;
      clearTimeout(clearTimer);
      grid.classList.add('is-spotlighting');
      grid.querySelectorAll('.project-card').forEach(c=>c.classList.toggle('is-focused',c===card));
    });
    grid.addEventListener('pointerleave',()=>{
      clearTimer=window.setTimeout(()=>{
        grid.classList.remove('is-spotlighting');
        grid.querySelectorAll('.project-card').forEach(c=>c.classList.remove('is-focused'));
      },220);
    });
  });
}

// Thin scroll-progress line.
const progress=document.querySelector<HTMLElement>('.scroll-progress');
if(progress && !reducedMotion.matches){
  let ticking=false;
  const update=()=>{
    const doc=document.documentElement;
    const max=doc.scrollHeight-doc.clientHeight;
    progress.style.transform=`scaleX(${max>0?Math.min(doc.scrollTop/max,1):0})`;
    ticking=false;
  };
  update();
  document.addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(update);ticking=true}},{passive:true});
}
</script></body></html>
