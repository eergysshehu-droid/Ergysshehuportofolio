---
import '../styles/portfolio.css';
import '../styles/polish-global.css';
import '../styles/polish-home.css';
import '../styles/polish-book.css';
import '../styles/theme.css';
import '../styles/v6.css';

import '../styles/components/mobile-nav.css';
import '../styles/components/footer.css';

import '../styles/pages/mobile-collection.css';
import '../styles/pages/desktop-collection.css';

import {
  defaults,
  PERSON_ID,
  WEBSITE_ID,
  KULT360_ID
} from '../lib/editorial';

import {
  languageFromPath,
  localizedHref,
  localizedPath,
  languageUrls,
  type SiteLang
} from '../lib/i18n';

import SocialIcons from '../components/SocialIcons.astro';

interface Props {
  title?: string;
  description?: string;
  name?: string;
  home?: boolean;
  image?: string;
  noindex?: boolean;
  lang?: SiteLang;
}

const {
  title = 'Ergys Shehu — Photographer, Videographer & Director | Albania',
  description = defaults.seoDescription,
  name = defaults.name,
  home = false,
  image = '/images/ergys-shehu-logo.png',
  noindex = false,
  lang: requestedLang
} = Astro.props;

const lang: SiteLang =
  requestedLang ||
  languageFromPath(Astro.url.pathname);

const isSq = lang === 'sq';

const pageUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;

const imageUrl = Astro.site
  ? new URL(image, Astro.site)
  : undefined;

const alternateUrls =
  languageUrls(
    Astro.url.pathname,
    Astro.site
  );

const enSwitchHref =
  localizedPath(
    Astro.url.pathname,
    'en'
  );

const sqSwitchHref =
  localizedPath(
    Astro.url.pathname,
    'sq'
  );

const href = (
  path: string
) =>
  localizedHref(
    path,
    lang
  );

const personLd = {
  '@context':
    'https://schema.org',

  '@type':
    'Person',

  '@id':
    PERSON_ID,

  name:
    defaults.name,

  url:
    'https://ergysshehu.com/',

  jobTitle:
    'Photographer, Videographer & Director',

  description:
    defaults.seoDescription,

  address: {
    '@type':
      'PostalAddress',

    addressCountry:
      'AL'
  },

  sameAs: [
    defaults.instagram,
    defaults.linkedin,
    defaults.facebook,
    defaults.youtube
  ].filter(Boolean),

  worksFor: {
    '@id':
      KULT360_ID
  },

  ...(imageUrl
    ? {
        image:
          imageUrl.href
      }
    : {})
};

const kult360Ld = {
  '@context':
    'https://schema.org',

  '@type':
    'Organization',

  '@id':
    KULT360_ID,

  name:
    'Kult 360 Foundation',

  url:
    defaults.kult360
};

const websiteLd = {
  '@context':
    'https://schema.org',

  '@type':
    'WebSite',

  '@id':
    WEBSITE_ID,

  name:
    'Ergys Shehu',

  url:
    'https://ergysshehu.com/',

  description:
    defaults.seoDescription,

  inLanguage: [
    'en',
    'sq'
  ],

  publisher: {
    '@id':
      PERSON_ID
  }
};

const webPageLd = {
  '@context':
    'https://schema.org',

  '@type':
    'WebPage',

  '@id':
    pageUrl
      ? pageUrl.href +
        '#webpage'
      : undefined,

  url:
    pageUrl?.href,

  name:
    title,

  inLanguage:
    lang,

  isPartOf: {
    '@id':
      WEBSITE_ID
  },

  about: {
    '@id':
      PERSON_ID
  }
};
---

<!doctype html>

<html lang={lang}>
<head>

  <script is:inline>
    document.documentElement.classList.add(
      'image-load-system'
    );
  </script>

  <meta charset="UTF-8"/>

<meta
  name="viewport"
  content="width=device-width, initial-scale=1, viewport-fit=cover"
/>

  <title>
    {title}
  </title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content={
      noindex
        ? 'noindex,nofollow'
        : 'index,follow,max-image-preview:large'
    }
  />

  <link
    rel="icon"
    href="/favicon.ico"
    sizes="32x32"
  />

  <link
    rel="icon"
    href="/favicon.svg"
    type="image/svg+xml"
  />

  <link
    rel="icon"
    href="/favicon-16x16.png"
    sizes="16x16"
    type="image/png"
  />

  <link
    rel="icon"
    href="/favicon-32x32.png"
    sizes="32x32"
    type="image/png"
  />

  <link
    rel="icon"
    href="/favicon-48x48.png"
    sizes="48x48"
    type="image/png"
  />

  <link
    rel="apple-touch-icon"
    href="/apple-touch-icon.png"
  />

  <link
    rel="manifest"
    href="/site.webmanifest"
  />

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
    rel="stylesheet"
  />

  {
    pageUrl && (
      <link
        rel="canonical"
        href={pageUrl}
      />
    )
  }

  {
    alternateUrls.en && (
      <link
        rel="alternate"
        hreflang="en"
        href={alternateUrls.en}
      />
    )
  }

  {
    alternateUrls.sq && (
      <link
        rel="alternate"
        hreflang="sq"
        href={alternateUrls.sq}
      />
    )
  }

  {
    alternateUrls.xDefault && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={alternateUrls.xDefault}
      />
    )
  }

  <meta
    property="og:title"
    content={title}
  />

  <meta
    property="og:description"
    content={description}
  />

  <meta
    property="og:type"
    content="website"
  />

  <meta
    property="og:site_name"
    content="Ergys Shehu"
  />

  <meta
    property="og:locale"
    content={
      isSq
        ? 'sq_AL'
        : 'en_US'
    }
  />

  <meta
    property="og:locale:alternate"
    content={
      isSq
        ? 'en_US'
        : 'sq_AL'
    }
  />

  {
    pageUrl && (
      <meta
        property="og:url"
        content={pageUrl}
      />
    )
  }

  {
    imageUrl && (
      <meta
        property="og:image"
        content={imageUrl}
      />
    )
  }

  {
    imageUrl && (
      <meta
        property="og:image:alt"
        content={title}
      />
    )
  }

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={title}
  />

  <meta
    name="twitter:description"
    content={description}
  />

  {
    imageUrl && (
      <meta
        name="twitter:image"
        content={imageUrl}
      />
    )
  }

  <script
    type="application/ld+json"
    is:inline
    set:html={
      JSON.stringify(
        personLd
      )
    }
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={
      JSON.stringify(
        kult360Ld
      )
    }
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={
      JSON.stringify(
        websiteLd
      )
    }
  />

  {
    pageUrl && (
      <script
        type="application/ld+json"
        is:inline
        set:html={
          JSON.stringify(
            webPageLd
          )
        }
      />
    )
  }
</head>

<body
  class:list={[
    {
      'is-home':
        home
    }
  ]}
>
  <a
    class="skip"
    href="#main"
    data-en="Skip to content"
    data-sq="Kalo te përmbajtja"
  >
    Skip to content
  </a>

  <div
    class="scroll-progress"
    aria-hidden="true"
  ></div>

  <header class="site-header">
    <a
      class="ergys-wordmark"
      href={href('/')}
      aria-label={
        name +
        ' home'
      }
    >
      <span class="ergys-wordmark-strong">
        ERGYS
      </span>

      <span class="ergys-wordmark-light">
        SHEHU
      </span>
    </a>

    <nav
      class="desktop-nav"
      aria-label="Primary"
    >
      <a
        href={href('/fashion/')}
        data-en="Fashion"
        data-sq="Modë"
      >
        Fashion
      </a>

      <a
        href={href('/portraits/')}
        data-en="Portraits"
        data-sq="Portrete"
      >
        Portraits
      </a>

      <a
        href={href('/weddings/')}
        data-en="Weddings"
        data-sq="Dasma"
      >
        Weddings
      </a>

      <a
        href={href('/films/')}
        data-en="Motion"
        data-sq="Video"
      >
        Motion
      </a>

      <a
        href={href('/projects/')}
        data-en="Index"
        data-sq="Indeksi"
      >
        Index
      </a>

      <a
        href={href('/about/')}
        data-en="About"
        data-sq="Rreth"
      >
        About
      </a>

      <a
        href={href('/journal/')}
        data-en="Journal"
        data-sq="Ditari"
      >
        Journal
      </a>

      <a
        class="nav-book"
        href={href('/book/#contact')}
        data-en="Book now ↗"
        data-sq="Rezervo ↗"
      >
        Book now ↗
      </a>

      <div
        class="language-switch"
        data-active={lang}
        role="group"
        aria-label="Language / Gjuha"
      >
        <button
          type="button"
          data-lang="en"
          data-lang-href={enSwitchHref}
          class:is-active={
            lang === 'en'
          }
          aria-pressed={
            lang === 'en'
              ? 'true'
              : 'false'
          }
        >
          EN
        </button>

        <button
          type="button"
          data-lang="sq"
          data-lang-href={sqSwitchHref}
          class:is-active={
            lang === 'sq'
          }
          aria-pressed={
            lang === 'sq'
              ? 'true'
              : 'false'
          }
        >
          SQ
        </button>
      </div>
    </nav>

   <button
  type="button"
  class="mobile-menu-trigger"
  data-menu-open
  aria-label="Open navigation"
  aria-expanded="false"
  aria-controls="mobile-menu-overlay"
>
  <span
    class="hamburger"
    aria-hidden="true"
  >
    <i></i>
    <i></i>
  </span>
</button>

</header>

<div
  id="mobile-menu-overlay"
  class="mobile-menu-screen"
  data-mobile-menu
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
  aria-hidden="true"
>
  <div class="mobile-menu-head">
    <a
      class="mobile-menu-brand"
      href={href('/')}
      aria-label={name + ' home'}
    >
      <span class="mobile-menu-brand-strong">
        ERGYS
      </span>

      <span class="mobile-menu-brand-light">
        SHEHU
      </span>
    </a>

    <button
      type="button"
      class="mobile-menu-close"
      data-menu-close
      aria-label="Close navigation"
    >
      <span class="sr-only">
        Close
      </span>
    </button>
  </div>

  <nav aria-label="Mobile navigation">
    <a
      href={href('/#selected')}
      data-en="Photography"
      data-sq="Fotografi"
    >
      Photography
    </a>

    <a
      href={href('/fashion/')}
      data-en="Fashion"
      data-sq="Modë"
    >
      Fashion
    </a>

    <a
      href={href('/portraits/')}
      data-en="Portraits"
      data-sq="Portrete"
    >
      Portraits
    </a>

    <a
      href={href('/weddings/')}
      data-en="Weddings"
      data-sq="Dasma"
    >
      Weddings
    </a>

    <a
      href={href('/films/')}
      data-en="Motion"
      data-sq="Video"
    >
      Motion
    </a>

    <a
      href={href('/projects/')}
      data-en="Index"
      data-sq="Indeksi"
    >
      Index
    </a>

    <a
      href={href('/about/')}
      data-en="About"
      data-sq="Rreth"
    >
      About
    </a>

    <a
      href={href('/journal/')}
      data-en="Journal"
      data-sq="Ditari"
    >
      Journal
    </a>

    <a
      href={href('/book/#contact')}
      data-en="Contact"
      data-sq="Kontakt"
    >
      Contact
    </a>
  </nav>

  <div class="mobile-menu-footer">
    <div
      class="language-switch"
      data-active={lang}
      role="group"
      aria-label="Language / Gjuha"
    >
      <button
        type="button"
        data-lang="en"
        data-lang-href={enSwitchHref}
        class:is-active={lang === 'en'}
        aria-pressed={
          lang === 'en'
            ? 'true'
            : 'false'
        }
      >
        EN
      </button>

      <button
        type="button"
        data-lang="sq"
        data-lang-href={sqSwitchHref}
        class:is-active={lang === 'sq'}
        aria-pressed={
          lang === 'sq'
            ? 'true'
            : 'false'
        }
      >
        SQ
      </button>
    </div>

    <div class="mobile-footer-row">
      <SocialIcons
        class="mobile-social"
      />
    </div>

    <a
      class="mobile-book"
      href={href('/book/#contact')}
      data-en="Book now ↗"
      data-sq="Rezervo ↗"
    >
      Book now ↗
    </a>
  </div>
</div>

  <main id="main">
    <slot/>
  </main>

  <footer>
    <div class="footer-row">
      <a
        href={href('/')}
        class="footer-name"
        data-reveal
      >
        {name}
      </a>

      <SocialIcons
        class="footer-social"
      />

      <a
        class="footer-contact"
        href={href('/book/#contact')}
        data-reveal
        data-en="CONTACT ↗"
        data-sq="KONTAKT ↗"
      >
        CONTACT ↗
      </a>
    </div>

    <span
  class="footer-copyright"
  data-en={`© ${new Date().getFullYear()} Ergys Shehu. All rights reserved.`}
  data-sq={`© ${new Date().getFullYear()} Ergys Shehu. Të gjitha të drejtat të rezervuara.`}
>
  © {new Date().getFullYear()} Ergys Shehu. All rights reserved.
</span>

    <a
      href="#main"
      data-reveal
      data-en="BACK TO TOP ↑"
      data-sq="KTHEHU LART ↑"
    >
      BACK TO TOP ↑
    </a>
  </footer>

  <script>
    document
      .documentElement
      .classList
      .add(
        'motion-ready'
      );

    const reducedMotion =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      );

    const LANG_KEY =
      'site-lang';

    function currentLang(){
      return document
        .documentElement
        .lang === 'sq'
        ? 'sq'
        : 'en';
    }

    function applyLang(
      lang:string
    ){
      document
        .querySelectorAll<HTMLElement>(
          '[data-en]'
        )
        .forEach(
          el=>{
            const text =
              lang === 'sq'
                ? el.dataset.sq
                : el.dataset.en;

            if(
              text != null
            ){
              el.textContent =
                text;
            }
          }
        );

      document
        .querySelectorAll(
          '[data-en-placeholder]'
        )
        .forEach(
          el=>{
            if(
              !(
                el instanceof HTMLInputElement ||
                el instanceof HTMLTextAreaElement
              )
            ){
              return;
            }

            const text =
              lang === 'sq'
                ? el.dataset.sqPlaceholder
                : el.dataset.enPlaceholder;

            if(
              text != null
            ){
              el.placeholder =
                text;
            }
          }
        );

      document
        .querySelectorAll<HTMLElement>(
          '[data-lang-content]'
        )
        .forEach(
          el=>{
            el.hidden =
              el.dataset.langContent !==
              lang;
          }
        );

      document
        .querySelectorAll<HTMLElement>(
          '[data-lang]'
        )
        .forEach(
          button=>{
            const active =
              button.dataset.lang ===
              lang;

            button
              .classList
              .toggle(
                'is-active',
                active
              );

            button
              .setAttribute(
                'aria-pressed',
                String(active)
              );
          }
        );

      document
        .querySelectorAll<HTMLElement>(
          '.language-switch'
        )
        .forEach(
          el=>{
            el.dataset.active =
              lang;
          }
        );

      document
        .documentElement
        .lang =
          lang;

      try{
        localStorage
          .setItem(
            LANG_KEY,
            lang
          );
      }catch{}
    }

    applyLang(
      currentLang()
    );

    document
      .querySelectorAll<HTMLElement>(
        '[data-lang]'
      )
      .forEach(
        button=>{
          button
            .addEventListener(
              'click',
              ()=>{
                const targetLang =
                  button.dataset.lang ||
                  'en';

                const targetHref =
                  button.dataset.langHref;

                try{
                  localStorage
                    .setItem(
                      LANG_KEY,
                      targetLang
                    );
                }catch{}

                if(
                  targetHref
                ){
                  window.location.href =
                    targetHref;
                }
              }
            );
        }
      );

 const mobileMenu =
  document.querySelector<HTMLElement>(
    '[data-mobile-menu]'
  );

const mobileMenuOpenButton =
  document.querySelector<HTMLButtonElement>(
    '[data-menu-open]'
  );

const mobileMenuCloseButton =
  document.querySelector<HTMLButtonElement>(
    '[data-menu-close]'
  );

function setMobileMenu(
  open:
    boolean,
  returnFocus =
    false
){
  if(
    !mobileMenu
  ){
    return;
  }

  mobileMenu
    .classList
    .toggle(
      'is-open',
      open
    );

  mobileMenu
    .setAttribute(
      'aria-hidden',
      String(
        !open
      )
    );

  mobileMenuOpenButton
    ?.setAttribute(
      'aria-expanded',
      String(
        open
      )
    );

  document
    .documentElement
    .classList
    .toggle(
      'mobile-menu-open',
      open
    );

  if(
    open
  ){
    requestAnimationFrame(
      ()=>{
        mobileMenuCloseButton
          ?.focus();
      }
    );
  }else if(
    returnFocus
  ){
    mobileMenuOpenButton
      ?.focus();
  }
}

mobileMenuOpenButton
  ?.addEventListener(
    'click',
    ()=>{
      setMobileMenu(
        true
      );
    }
  );

mobileMenuCloseButton
  ?.addEventListener(
    'click',
    ()=>{
      setMobileMenu(
        false,
        true
      );
    }
  );

mobileMenu
  ?.querySelectorAll(
    'a'
  )
  .forEach(
    link=>{
      link
        .addEventListener(
          'click',
          ()=>{
            setMobileMenu(
              false
            );
          }
        );
    }
  );

document
  .addEventListener(
    'keydown',
    event=>{
      if(
        event.key ===
          'Escape' &&
        mobileMenu
          ?.classList
          .contains(
            'is-open'
          )
      ){
        setMobileMenu(
          false,
          true
        );
      }
    }
  );

    const siteHeader =
      document.querySelector<HTMLElement>(
        '.site-header'
      );

    if(
      siteHeader
    ){
      const headerH =
        siteHeader.offsetHeight ||
        90;

      let lastY =
        window.scrollY;

      let headerTicking =
        false;

      const updateHeader =
        ()=>{
          const y =
            window.scrollY;

          siteHeader
            .classList
            .toggle(
              'is-scrolled',
              y > headerH
            );

          if(
            !reducedMotion.matches
          ){
            if(
              y <= headerH
            ){
              siteHeader
                .classList
                .remove(
                  'is-hidden'
                );
            }else if(
              y > lastY
            ){
              siteHeader
                .classList
                .add(
                  'is-hidden'
                );
            }else if(
              y < lastY
            ){
              siteHeader
                .classList
                .remove(
                  'is-hidden'
                );
            }
          }

          lastY =
            y;

          headerTicking =
            false;
        };

      updateHeader();

      document
        .addEventListener(
          'scroll',
          ()=>{
            if(
              !headerTicking
            ){
              requestAnimationFrame(
                updateHeader
              );

              headerTicking =
                true;
            }
          },
          {
            passive:
              true
          }
        );
    }

if(
  'IntersectionObserver'
  in window
){
  /*
   * ================================================================
   * REVEAL CONTROLLER
   * ================================================================
   *
   * Old behaviour:
   * after 4 seconds every reveal target became visible,
   * even when it was far below the viewport.
   *
   * New behaviour:
   * - content reveals only when it actually enters the viewport
   * - content already visible on first paint appears immediately
   * - reduced-motion users do not wait for animation
   * - once revealed, the observer stops watching that element
   */

  const revealTargets =
    Array.from(
      document.querySelectorAll<HTMLElement>(
        '[data-reveal],[data-image-reveal]'
      )
    );


  if(
    revealTargets.length
  ){
    if(
      reducedMotion.matches
    ){
      revealTargets
        .forEach(
          element=>{
            element
              .classList
              .add(
                'is-visible'
              );
          }
        );

    }else{
      const revealObserver =
        new IntersectionObserver(
          entries=>{
            entries
              .forEach(
                entry=>{
                  if(
                    !entry.isIntersecting
                  ){
                    return;
                  }


                  entry
                    .target
                    .classList
                    .add(
                      'is-visible'
                    );


                  revealObserver
                    .unobserve(
                      entry.target
                    );
                }
              );
          },
          {
            threshold:
              .12,

            rootMargin:
              '0px 0px -8% 0px'
          }
        );


      revealTargets
        .forEach(
          element=>{
            const rect =
              element
                .getBoundingClientRect();


            /*
             * Anything already visible during first layout
             * must never wait for the observer callback.
             */
            const alreadyVisible =
              rect.bottom >
                0 &&
              rect.top <
                window.innerHeight *
                .94;


            if(
              alreadyVisible
            ){
              element
                .classList
                .add(
                  'is-visible'
                );

              return;
            }


            revealObserver
              .observe(
                element
              );
          }
        );
    }
  }
        

  /* =========================================================
     IMAGE LOAD / DECODE SYSTEM
     ========================================================= */

  const managedImages =
    Array.from(
      document.querySelectorAll<HTMLImageElement>(
        [
          '[data-image-reveal] img',
          '.project-image img',
          '.filmstrip-image img',
          '.latest-card img',
          '.journal-card-image img',
          '.journal-post-cover img',
          '.gallery.collection-body img'
        ].join(',')
      )
    );


  const markImageReady =
    async(
      image: HTMLImageElement
    )=>{

      if(
        image
          .classList
          .contains(
            'image-ready'
          )
      ){
        return;
      }


      try{

        if(
          image.naturalWidth >
            0 &&
          typeof image.decode ===
            'function'
        ){
          await image.decode();
        }

      }catch{
        /* decoding failed but image can still be shown */
      }


      image
        .classList
        .add(
          'image-ready'
        );
    };


  managedImages
    .forEach(
      image=>{

        if(
          image.complete &&
          image.naturalWidth >
            0
        ){
          void markImageReady(
            image
          );

          return;
        }


        image
          .addEventListener(
            'load',

            ()=>{
              void markImageReady(
                image
              );
            },

            {
              once:
                true
            }
          );


        image
          .addEventListener(
            'error',

            ()=>{
              image
                .classList
                .add(
                  'image-error',
                  'image-ready'
                );
            },

            {
              once:
                true
            }
          );
      }
    );


   /*
   * ================================================================
   * MOBILE HOMEPAGE STACK CONTROLLER
   * Stable scroll-linked version.
   *
   * Keeps:
   * - sticky card stacking
   * - natural image heights
   * - dark melt as the next card covers the previous one
   *
   * Removes:
   * - animated blur on sticky layers
   * - temporal smoothing that lags behind fast scroll
   * - ambiguous layer ordering
   * ================================================================
   */

  const stackSection =
    document.body
      .classList
      .contains(
        'is-home'
      )
      ? document.querySelector<HTMLElement>(
          '.work-section'
        )
      : null;


  const stackGrid =
    stackSection
      ?.querySelector<HTMLElement>(
        '.project-grid'
      ) ??
    null;


  const stackMedia =
    window.matchMedia(
      '(max-width: 700px)'
    );


  if(
    stackGrid &&
    stackSection &&
    stackMedia.matches
  ){
    const activeStackGrid =
      stackGrid;


    const activeStackSection =
      stackSection;


    type StackCard = {
      card:
        HTMLElement;

      image:
        HTMLElement |
        null;

      height:
        number;
    };


    /*
     * Small dead zone prevents the previous
     * card darkening too early.
     */
    const DEAD_ZONE =
      .12;


    let stackItems:
      StackCard[] =
      [];


    let stackActive =
      false;


    let stackRaf:
      number |
      undefined;


    let resizeRaf:
      number |
      undefined;


    let lastStackWidth =
      window.innerWidth;


    function getVisibleCards(){
      return Array
        .from(
          activeStackGrid
            .querySelectorAll<HTMLElement>(
              '.project-card'
            )
        )
        .filter(
          card=>
            !card.hidden &&
            getComputedStyle(
              card
            ).display !==
              'none'
        );
    }


function clearCardState(
  card:
    HTMLElement
){
  card
    .style
    .removeProperty(
      'z-index'
    );

  const image =
    card
      .querySelector<HTMLElement>(
        '.project-image'
      );

  if(
    image
  ){
    image
      .style
      .setProperty(
        '--stack-blur',
        '0px'
      );

    image
      .style
      .setProperty(
        '--stack-darkness',
        '0'
      );
  }
}


    function overlapProgress(
      nextCard:
        HTMLElement,

      currentHeight:
        number
    ){
      const nextTop =
        nextCard
          .getBoundingClientRect()
          .top;


      const raw =
        (
          currentHeight -
          nextTop
        ) /
        currentHeight;


      const clamped =
        Math.max(
          0,
          Math.min(
            1,
            raw
          )
        );


      if(
        clamped <=
        DEAD_ZONE
      ){
        return 0;
      }


      const normalized =
        (
          clamped -
          DEAD_ZONE
        ) /
        (
          1 -
          DEAD_ZONE
        );


      /*
       * Spatial easing only.
       *
       * This is NOT animation smoothing.
       * It follows the real scroll position immediately.
       */
      return (
        normalized *
        normalized *
        (
          3 -
          2 *
          normalized
        )
      );
    }


    function rebuildStack(){
      const allCards =
        Array.from(
          activeStackGrid
            .querySelectorAll<HTMLElement>(
              '.project-card'
            )
        );


      allCards
        .forEach(
          clearCardState
        );


      const visibleCards =
        getVisibleCards();


      stackItems =
        visibleCards
          .map(
            (
              card,
              index
            )=>{

              /*
               * Explicit layer order.
               *
               * Every next card is guaranteed to paint
               * above the previous one.
               */
              card
                .style
                .setProperty(
                  'z-index',
                  String(
                    index +
                    1
                  )
                );


              return {
                card,

                image:
                  card
                    .querySelector<HTMLElement>(
                      '.project-image'
                    ),

                height:
                  Math.max(
                    1,
                    card
                      .getBoundingClientRect()
                      .height
                  )
              };
            }
          );


      scheduleStack();
    }


    function updateStack(){
  stackRaf =
    undefined;

  if(
    !stackActive ||
    !stackItems.length
  ){
    return;
  }

  stackItems
    .forEach(
      (
        item,
        index
      )=>{
        const nextItem =
          stackItems[
            index +
            1
          ];

        const progress =
          nextItem
            ? overlapProgress(
                nextItem.card,
                item.height
              )
            : 0;

        if(
          item.image
        ){
          const blur =
            progress < .16
              ? 0
              : progress < .55
                ? 1.2
                : 2.2;

          const nextBlur =
            `${blur}px`;

          if(
            item.image
              .style
              .getPropertyValue(
                '--stack-blur'
              ) !==
            nextBlur
          ){
            item.image
              .style
              .setProperty(
                '--stack-blur',
                nextBlur
              );
          }

          item.image
            .style
            .setProperty(
              '--stack-darkness',
              (
                progress *
                .72
              ).toFixed(
                3
              )
            );
        }
      }
    );
}


    function scheduleStack(){
      if(
        stackRaf !==
        undefined
      ){
        return;
      }


      stackRaf =
        requestAnimationFrame(
          updateStack
        );
    }


    function scheduleRebuild(){
      if(
        resizeRaf !==
        undefined
      ){
        cancelAnimationFrame(
          resizeRaf
        );
      }


      resizeRaf =
        requestAnimationFrame(
          ()=>{
            resizeRaf =
              undefined;


            rebuildStack();
          }
        );
    }


    const stackObserver =
      new IntersectionObserver(
        entries=>{
          entries
            .forEach(
              entry=>{
                stackActive =
                  entry
                    .isIntersecting;


                document
                  .body
                  .classList
                  .toggle(
                    'in-stack-grid',
                    stackActive
                  );


                if(
                  stackActive
                ){
                  scheduleStack();
                }
              }
            );
        },

        {
          rootMargin:
            '120px 0px'
        }
      );


    stackObserver
      .observe(
        activeStackSection
      );


    document
      .addEventListener(
        'scroll',
        ()=>{
          if(
            stackActive
          ){
            scheduleStack();
          }
        },

        {
          passive:
            true
        }
      );


    /*
     * Project filters change which cards participate
     * in the stack.
     */
    document
      .addEventListener(
        'portfolio:filter-change',
        scheduleRebuild
      );


    /*
     * Mobile browser chrome often changes viewport HEIGHT
     * while scrolling.
     *
     * That must NOT rebuild the sticky geometry.
     *
     * Rebuild only when WIDTH actually changes.
     */
    window
      .addEventListener(
        'resize',
        ()=>{
          const nextWidth =
            window.innerWidth;


          if(
            Math.abs(
              nextWidth -
              lastStackWidth
            ) <
            2
          ){
            return;
          }


          lastStackWidth =
            nextWidth;


          scheduleRebuild();
        },

        {
          passive:
            true
        }
      );


    window
      .addEventListener(
        'orientationchange',
        ()=>{
          window
            .setTimeout(
              ()=>{
                lastStackWidth =
                  window.innerWidth;


                scheduleRebuild();
              },

              160
            );
        }
      );


    /*
     * Image decoding may change the natural
     * height of a card.
     */
    activeStackGrid
      .querySelectorAll<HTMLImageElement>(
        '.project-card img'
      )
      .forEach(
        image=>{
          if(
            image.complete
          ){
            return;
          }


          image
            .addEventListener(
              'load',
              scheduleRebuild,

              {
                once:
                  true
              }
            );
        }
      );


    rebuildStack();
  }


  /*
   * ================================================================
   * SECTION VEIL
   * ================================================================
   */

  const sectionVeil =
    document.body
      .classList
      .contains(
        'is-home'
      )
      ? document.querySelector<HTMLElement>(
          '[data-section-veil]'
        )
      : null;


  const veilWorkSection =
    document.querySelector<HTMLElement>(
      '.work-section'
    );


  if(
    sectionVeil &&
    veilWorkSection &&
    window
      .matchMedia(
        '(max-width: 700px)'
      )
      .matches
  ){
    /*
     * Bind the already-validated elements to non-null constants.
     *
     * TypeScript does not always preserve DOM null narrowing
     * inside nested callbacks/functions, so these constants
     * make the guarantee explicit without unsafe repeated checks.
     */
    const activeSectionVeil =
      sectionVeil;


    const activeWorkSection =
      veilWorkSection;


    let veilActive =
      false;


    let veilRafId:
      number |
      undefined;


    function updateVeil(){
      const wsTop =
        activeWorkSection
          .getBoundingClientRect()
          .top;


      const progress =
        Math.max(
          0,
          Math.min(
            1,
            1 -
            wsTop /
            window.innerHeight
          )
        );


      activeSectionVeil
        .style
        .setProperty(
          '--veil-p',
          progress
            .toFixed(
              3
            )
        );


      veilRafId =
        undefined;
    }


    function scheduleVeil(){
      if(
        veilRafId !==
        undefined
      ){
        return;
      }


      veilRafId =
        requestAnimationFrame(
          updateVeil
        );
    }


    const veilObserver =
      new IntersectionObserver(
        entries=>{
          entries
            .forEach(
              entry=>{
                veilActive =
                  entry
                    .isIntersecting;


                if(
                  veilActive
                ){
                  scheduleVeil();
                }
              }
            );
        },
        {
          rootMargin:
            '300px 0px'
        }
      );


    veilObserver
      .observe(
        activeWorkSection
      );


    document
      .addEventListener(
        'scroll',
        ()=>{
          if(
            veilActive
          ){
            scheduleVeil();
          }
        },
        {
          passive:
            true
        }
      );


    /*
     * Keep veil geometry correct after viewport changes.
     */
    window
      .addEventListener(
        'resize',
        ()=>{
          if(
            veilActive
          ){
            scheduleVeil();
          }
        },
        {
          passive:
            true
        }
      );


    window
      .addEventListener(
        'orientationchange',
        ()=>{
          window
            .setTimeout(
              ()=>{
                if(
                  veilActive
                ){
                  scheduleVeil();
                }
              },
              120
            );
        }
      );
  }
}

    if(
      !reducedMotion.matches &&
      window
        .matchMedia(
          '(hover: hover) and (pointer: fine)'
        )
        .matches
    ){
      document
        .querySelectorAll<HTMLElement>(
          '.project-card'
        )
        .forEach(
          card=>{
            let rect:
              DOMRect |
              null =
              null;

            let frame:
              number |
              undefined;

            let pointerX =
              0;

            let pointerY =
              0;

            const updateTilt =
              ()=>{
                frame =
                  undefined;

                if(
                  !rect
                ){
                  return;
                }

                const x =
                  (
                    (
                      pointerX -
                      rect.left
                    ) /
                    rect.width -
                    .5
                  ) *
                  8;

                const y =
                  (
                    (
                      pointerY -
                      rect.top
                    ) /
                    rect.height -
                    .5
                  ) *
                  8;

                card
                  .style
                  .setProperty(
                    '--tilt-x',
                    x.toFixed(
                      2
                    ) +
                    'px'
                  );

                card
                  .style
                  .setProperty(
                    '--tilt-y',
                    y.toFixed(
                      2
                    ) +
                    'px'
                  );
              };

            card
              .addEventListener(
                'pointerenter',
                ()=>{
                  rect =
                    card
                      .getBoundingClientRect();
                }
              );

            card
              .addEventListener(
                'pointermove',
                e=>{
                  pointerX =
                    e.clientX;

                  pointerY =
                    e.clientY;

                  if(
                    frame ===
                    undefined
                  ){
                    frame =
                      requestAnimationFrame(
                        updateTilt
                      );
                  }
                }
              );

            card
              .addEventListener(
                'pointerleave',
                ()=>{
                  rect =
                    null;

                  if(
                    frame !==
                    undefined
                  ){
                    cancelAnimationFrame(
                      frame
                    );

                    frame =
                      undefined;
                  }

                  card
                    .style
                    .setProperty(
                      '--tilt-x',
                      '0px'
                    );

                  card
                    .style
                    .setProperty(
                      '--tilt-y',
                      '0px'
                    );
                }
              );
          }
        );

      document
        .querySelectorAll<HTMLElement>(
          '.project-grid'
        )
        .forEach(
          grid=>{
            let clearTimer:
              number |
              undefined;

            grid
              .addEventListener(
                'pointerover',
                e=>{
                  const card =
                    (
                      e.target as HTMLElement
                    )
                      .closest(
                        '.project-card'
                      );

                  if(
                    !card
                  ){
                    return;
                  }

                  clearTimeout(
                    clearTimer
                  );

                  grid
                    .classList
                    .add(
                      'is-spotlighting'
                    );

                  grid
                    .querySelectorAll(
                      '.project-card'
                    )
                    .forEach(
                      c=>{
                        c
                          .classList
                          .toggle(
                            'is-focused',
                            c ===
                            card
                          );
                      }
                    );
                }
              );

            grid
              .addEventListener(
                'pointerleave',
                ()=>{
                  clearTimer =
                    window.setTimeout(
                      ()=>{
                        grid
                          .classList
                          .remove(
                            'is-spotlighting'
                          );

                        grid
                          .querySelectorAll(
                            '.project-card'
                          )
                          .forEach(
                            c=>
                              c
                                .classList
                                .remove(
                                  'is-focused'
                                )
                          );
                      },
                      220
                    );
                }
              );
          }
        );
    }

    const scrollProgress =
      document.querySelector<HTMLElement>(
        '.scroll-progress'
      );

    if(
      scrollProgress &&
      !reducedMotion.matches
    ){
      let ticking =
        false;

      const update =
        ()=>{
          const doc =
            document
              .documentElement;

          const max =
            doc.scrollHeight -
            doc.clientHeight;

          scrollProgress
            .style
            .transform =
              `scaleX(${
                max > 0
                  ? Math.min(
                      doc.scrollTop /
                      max,
                      1
                    )
                  : 0
              })`;

          ticking =
            false;
        };

      update();

      document
        .addEventListener(
          'scroll',
          ()=>{
            if(
              !ticking
            ){
              requestAnimationFrame(
                update
              );

              ticking =
                true;
            }
          },
          {
            passive:
              true
          }
        );
    }
   </script>

  <script
  src="/v6-runtime.js"
  is:inline
  defer
></script>

<script>
  import '../scripts/mobile-rollup';
</script>

</body>
</html>
