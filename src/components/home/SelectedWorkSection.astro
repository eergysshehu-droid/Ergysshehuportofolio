---
import ProjectGrid from '../ProjectGrid.astro';

import {
  albumKind
} from '../../lib/content';

import {
  localizedPath,
  type SiteLang
} from '../../lib/i18n';

interface Props {
  albums: any[];
  selected: any[];
  isSq: boolean;
  lang: SiteLang;
}

const {
  albums,
  selected,
  isSq,
  lang
} = Astro.props;

const filterItems = [
  {
    key: 'all',
    en: 'All work',
    sq: 'TÃƒÂ« gjitha',
    count: albums.length
  },
  {
    key: 'fashion',
    en: 'Fashion',
    sq: 'ModÃƒÂ«',
    count: albums.filter(album => albumKind(album) === 'fashion').length
  },
  {
    key: 'portraits',
    en: 'Portraits',
    sq: 'Portrete',
    count: albums.filter(album => albumKind(album) === 'portraits').length
  },
  {
    key: 'weddings',
    en: 'Weddings',
    sq: 'Dasma',
    count: albums.filter(album => albumKind(album) === 'weddings').length
  },
  {
    key: 'projects',
    en: 'Personal',
    sq: 'Personale',
    count: albums.filter(album => albumKind(album) === 'projects').length
  }
];

const marqueeItems = [
  {
    no: '01',
    en: 'PHOTOGRAPHY',
    sq: 'FOTOGRAFI'
  },
  {
    no: '02',
    en: 'FILM',
    sq: 'FILM'
  },
  {
    no: '03',
    en: 'ART DIRECTION',
    sq: 'DREJTIM ARTISTIK'
  },
  {
    no: '04',
    en: 'ALBANIA',
    sq: 'SHQIPÃƒâ€¹RI'
  },
  {
    no: '05',
    en: 'WORLDWIDE',
    sq: 'NDÃƒâ€¹RKOMBÃƒâ€¹TARISHT'
  }
];
---

<section
  class="work-section"
  id="selected"
>
  <div
    class="home-marquee"
    aria-label={
      isSq
        ? 'Fotografi, film, drejtim artistik, ShqipÃƒÂ«ri, ndÃƒÂ«rkombÃƒÂ«tarisht'
        : 'Photography, film, art direction, Albania, worldwide'
    }
  >
    <div class="home-marquee-track">
      {
        [0, 1].map(
          () => (
            <div
              class="home-marquee-set"
              aria-hidden="true"
            >
              {
                marqueeItems.map(
                  item => (
                    <span class="home-marquee-item">
                      <span class="home-marquee-no">
                        {item.no}
                      </span>

                      <span
                        data-en={item.en}
                        data-sq={item.sq}
                      >
                        {
                          isSq
                            ? item.sq
                            : item.en
                        }
                      </span>

                      <i aria-hidden="true">
                        Ã¢â‚¬â€
                      </i>
                    </span>
                  )
                )
              }
            </div>
          )
        )
      }
    </div>
  </div>

  <div
    class="work-heading"
    data-reveal
  >
    <div>
      <p
        class="kicker"
        data-en="A SELECTED PERSPECTIVE"
        data-sq="PÃƒâ€¹RZGJEDHJE AUTORIALE"
      >
        {isSq ? 'PÃƒâ€¹RZGJEDHJE AUTORIALE' : 'A SELECTED PERSPECTIVE'}
      </p>

      <h2>
        <span
          data-en="Still"
          data-sq="Statike"
        >
          {isSq ? 'Statike' : 'Still'}
        </span>

        {' '}

        <em
          data-en="Never silent"
          data-sq="KurrÃƒÂ« e heshtur"
        >
          {isSq ? 'KurrÃƒÂ« e heshtur' : 'Never silent'}
        </em>
      </h2>
    </div>

    <span class="work-count">
      {String(albums.length).padStart(2, '0')}{' '}
      <span
        data-en="COLLECTIONS"
        data-sq="KOLEKSIONE"
      >
        {isSq ? 'KOLEKSIONE' : 'COLLECTIONS'}
      </span>
    </span>
  </div>

  <div
    class="work-toolbar"
    data-reveal
  >
    <div class="filters-shell">
      <button
        type="button"
        class="filter-rail-arrow filter-rail-arrow-prev"
        data-filter-prev
        aria-label={
          isSq
            ? 'LÃƒÂ«viz kategoritÃƒÂ« majtas'
            : 'Scroll categories left'
        }
      >
        Ã¢â‚¬Â¹
      </button>

      <div
        class="filters"
        data-filter-rail
        role="group"
        aria-label={
          isSq
            ? 'Filtro projektet'
            : 'Filter projects'
        }
      >
        {
          filterItems.map(
            (
              item,
              index
            ) => (
              <button
                type="button"
                data-filter={item.key}
                aria-pressed={
                  index === 0
                    ? 'true'
                    : 'false'
                }
                data-en={item.en}
                data-sq={item.sq}
              >
                <span
                  class="filter-label"
                  data-en={item.en}
                  data-sq={item.sq}
                >
                  {
                    isSq
                      ? item.sq
                      : item.en
                  }
                </span>

                <span
                  class="filter-count"
                  aria-hidden="true"
                >
                  /
                  {' '}
                  {String(item.count).padStart(2, '0')}
                </span>
              </button>
            )
          )
        }
      </div>

      <button
        type="button"
        class="filter-rail-arrow filter-rail-arrow-next"
