      data-en="PROJECT INDEX Ã¢â€ â€”"
      data-sq="TÃƒâ€¹ GJITHA PROJEKTET Ã¢â€ â€”"
    >
      {isSq ? 'TÃƒâ€¹ GJITHA PROJEKTET Ã¢â€ â€”' : 'PROJECT INDEX Ã¢â€ â€”'}
