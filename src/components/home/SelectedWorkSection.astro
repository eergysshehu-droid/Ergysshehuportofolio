  </div>

  <ProjectGrid albums={selected}/>

  <p
    class="work-empty"
    hidden
    data-en="No projects in this selection yet."
    data-sq="Nuk ka ende projekte nÃƒÂ« kÃƒÂ«tÃƒÂ« pÃƒÂ«rzgjedhje."
  >
    {
      isSq
        ? 'Nuk ka ende projekte nÃƒÂ« kÃƒÂ«tÃƒÂ« pÃƒÂ«rzgjedhje.'
        : 'No projects in this selection yet.'
    }
  </p>
</section>
