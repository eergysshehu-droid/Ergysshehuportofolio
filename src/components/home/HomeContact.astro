---
import {
  safeUrl
} from '../../lib/content';

interface Props {
  settings: any;
  isSq: boolean;
}

const {
  settings,
  isSq
} = Astro.props;

const instagram =
  safeUrl(
    settings.instagram
  );
---

<section
  class="contact-section"
  id="contact"
>
  <div data-reveal>
    <p
      class="kicker"
      data-en="FOR COMMISSIONS & COLLABORATIONS"
      data-sq="PËR PROJEKTE & BASHKËPUNIME"
    >
      {
        isSq
          ? 'PËR PROJEKTE & BASHKËPUNIME'
          : 'FOR COMMISSIONS & COLLABORATIONS'
      }
    </p>

    <h2>
      <span
        data-en="Let’s make"
        data-sq="Le të krijojmë"
      >
        {isSq ? 'Le të krijojmë' : 'Let’s make'}
      </span>

      <br/>

      <em
        data-en="something matter."
        data-sq="diçka që ka kuptim."
      >
        {isSq ? 'diçka që ka kuptim.' : 'something matter.'}
      </em>
    </h2>
  </div>

  <div
    class="contact-details"
    data-reveal
  >
    {
      settings.email && (
        <a
          class="email"
          href={`mailto:${settings.email}`}
        >
          {settings.email} ↗
        </a>
      )
    }

    <p>
      <span
        data-en="Based in Albania."
        data-sq="Punoj nga Shqipëria."
      >
        {isSq ? 'Punoj nga Shqipëria.' : 'Based in Albania.'}
      </span>

      <br/>

      <span
        data-en="Available worldwide."
        data-sq="I hapur për projekte kudo në botë."
      >
        {isSq ? 'I hapur për projekte kudo në botë.' : 'Available worldwide.'}
      </span>
    </p>

    {
      instagram && (
        <a
          href={instagram}
          target="_blank"
          rel="noopener noreferrer"
        >
          INSTAGRAM ↗
        </a>
      )
    }
  </div>
</section>
