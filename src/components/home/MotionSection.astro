---
interface Props {
  reel: string;
  isSq: boolean;
}

const {
  reel,
  isSq
} = Astro.props;
---

<section class="motion-section">
  <p
    class="kicker"
    data-reveal
    data-en="MOVING IMAGE"
    data-sq="IMAZHI NË LËVIZJE"
  >
    {isSq ? 'IMAZHI NË LËVIZJE' : 'MOVING IMAGE'}
  </p>

  <h2
    data-reveal
    data-en="Beyond the still"
    data-sq="Përtej imazhit statik"
  >
    {isSq ? 'Përtej imazhit statik' : 'Beyond the still'}
  </h2>

  <a
    data-reveal
    href={reel}
    target="_blank"
    rel="noopener noreferrer"
    data-en="WATCH THE REEL ↗"
    data-sq="SHIKO VIDEON PËRMBLEDHËSE ↗"
  >
    {isSq ? 'SHIKO VIDEON PËRMBLEDHËSE ↗' : 'WATCH THE REEL ↗'}
  </a>
</section>
