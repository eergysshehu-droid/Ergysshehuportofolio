---
import {
  photoUrl,
  photoSet,
  photoPosition,
  albumKind,
  type Album
} from '../lib/content';

import {
  languageFromPath,
  localizedPath
} from '../lib/i18n';

interface Props {
  albums: Album[];
}

const {
  albums
} = Astro.props;

const lang =
  languageFromPath(
    Astro.url.pathname
  );

const isSq =
  lang === 'sq';

const projectHref = (
  slug: string
) =>
  localizedPath(
    `/portfolio/${slug}/`,
    lang
  );

const projectKindLabel = (
  album: Album
) => {
  const kind =
    albumKind(
      album
    );

  if (
    !isSq
  ) {
    if (
      kind ===
      'projects'
    ) {
      return 'Personal work';
    }

    if (
      kind ===
      'portraits'
    ) {
      return 'Portraits & beauty';
    }

    return (
      album.category ||
      album.kind ||
      ''
    );
  }

  if (
    kind ===
    'projects'
  ) {
    return 'Punë personale';
  }

  if (
    kind ===
    'portraits'
  ) {
    return 'Portrete & bukuri';
  }

  if (
    kind ===
    'weddings'
  ) {
    return 'Dasma';
  }

  if (
    kind ===
    'fashion'
  ) {
    return 'Modë';
  }

  if (
    kind ===
    'films'
  ) {
    return 'Film';
  }

  return (
    album.categorySq ||
    album.category ||
    album.kind ||
    ''
  );
};
---

<div class="project-grid">
  {
    albums.map(
      (
        album,
        i
      ) => {
        const feature =
          i === 0 &&
          albums.length >
            3;

        const eager =
          i < 2;

        const highPriority =
          i === 0;

        const imageUrl =
          photoUrl(
            album.cover
          );

        const title =
          isSq
            ? (
                album.titleSq ||
                album.title
              )
            : album.title;

        const alt =
          isSq
            ? (
                album.cover?.altSq ||
                album.cover?.alt ||
                title
              )
            : (
                album.cover?.alt ||
                title
              );

        const kindLabel =
          projectKindLabel(
            album
          );

        const projectLabel =
          isSq
            ? `Hap projektin ${title}${
                kindLabel
                  ? ` — ${kindLabel}`
                  : ''
              }`
            : `Open project ${title}${
                kindLabel
                  ? ` — ${kindLabel}`
                  : ''
              }`;

        return (
          <article
            class:list={[
              'project-card',

              {
                'project-feature':
                  feature
              }
            ]}
            data-kind={
              albumKind(
                album
              )
            }
            data-reveal
            style={`--frame-color:${album.cover?.color || '#141412'}`}
          >
            <a
              href={
                projectHref(
                  album.slug
                )
              }
              aria-label={
                projectLabel
              }
            >
              <div
                class="project-image"
                data-image-reveal
                style={`--focal-point:${photoPosition(album.cover)};--frame-color:${album.cover?.color || '#141412'}`}
              >
                {
                  imageUrl
                    ? (
                        <img
                          src={
                            photoUrl(
                              album.cover,
                              feature
                                ? 1800
                                : 1200,
                              80
                            )
                          }
                          srcset={
                            photoSet(
                              album.cover,
                              80
                            )
                          }
                          sizes={
                            feature
                              ? '100vw'
                              : '(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw'
                          }
                          alt={
                            alt
                          }
                          loading={
                            eager
                              ? 'eager'
                              : 'lazy'
                          }
                          fetchpriority={
                            highPriority
                              ? 'high'
                              : 'auto'
                          }
                          decoding="async"
                          width={
                            album.cover?.width ||
                            1200
                          }
                          height={
                            album.cover?.height ||
                            1500
                          }
                        />
                      )
                    : (
                        <span class="project-fallback">
                          {
                            title
                          }
                        </span>
                      )
                }

                <span
                  class="project-stack-shade"
                  aria-hidden="true"
                ></span>

                {
                  albumKind(
                    album
                  ) ===
                    'films' && (
                    <span
                      class="icon-badge project-play"
                      aria-hidden="true"
                    >
                      ▶
                    </span>
                  )
                }

                <div class="project-overlay">
                  <span class="project-no">
                    {
                      String(
                        i +
                        1
                      ).padStart(
                        2,
                        '0'
                      )
                    }
                  </span>

                  <div class="project-overlay-text">
                    <h2>
                      {title}
                    </h2>

                    <p>
                      <span class="project-kind">
                        {
                          kindLabel
                        }
                      </span>

                      <span
                        class="project-sep"
                        aria-hidden="true"
                      >
                        /
                      </span>

                      <span class="project-total">
                        {
                          album.photos
                            ?.length ||
                          0
                        }

                        <span class="sr-only">
                          {
                            isSq
                              ? ' foto'
                              : ' frames'
                          }
                        </span>
                      </span>
                    </p>
                  </div>
                </div>
              </div>
            </a>
          </article>
        );
      }
    )
  }
</div>
