---
import {photoUrl,photoSet,albumKind,type Album} from '../lib/content';
interface Props {albums:Album[]}
const {albums}=Astro.props;
---
<div class="project-grid">{albums.map((album,i)=><article class="project-card" data-kind={albumKind(album)}><a href={`/portfolio/${album.slug}/`}><div class="project-image">{photoUrl(album.cover)?<img src={photoUrl(album.cover,1000)} srcset={photoSet(album.cover)} sizes="(max-width: 700px) 90vw, 46vw" alt={album.cover?.alt || album.title} loading="lazy" width={album.cover?.width || 1000} height={album.cover?.height || 1300}/>:<span>{album.title}</span>}<span class="project-open" aria-hidden="true">↗</span></div><div class="project-caption"><span class="project-no">{String(i+1).padStart(2,'0')}</span><div><h2>{album.title}</h2><p>{album.kind==='projects'?'Personal work':album.kind==='portraits'?'Portraits & beauty':album.kind}</p></div><span class="project-total">{album.photos?.length || 0} FRAMES</span></div></a></article>)}</div>
