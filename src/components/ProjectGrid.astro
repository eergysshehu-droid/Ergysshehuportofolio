---
import {
  photoUrl,
  photoSet,
  photoPosition,
  albumKind,
  type Album
} from '../lib/content';

import {
  languageFromPath,
  localizedPath
} from '../lib/i18n';

interface Props {
  albums: Album[];
}

const {
  albums
} = Astro.props;

const lang =
  languageFromPath(
    Astro.url.pathname
  );

const isSq =
  lang === 'sq';

const projectHref = (
  slug: string
) =>
  localizedPath(
    `/portfolio/${slug}/`,
    lang
  );

const projectKindLabel = (
  album: Album
) => {
  const kind =
    albumKind(album);

  if (!isSq) {
    if (
      kind === 'projects'
    ) {
      return 'Personal work';
    }

    if (
      kind === 'portraits'
    ) {
      return 'Portraits & beauty';
    }

    return (
      album.category ||
      album.kind ||
      ''
    );
  }

  if (
    kind === 'projects'
  ) {
    return 'Punë personale';
  }

  if (
    kind === 'portraits'
  ) {
    return 'Portrete & bukuri';
  }

  if (
    kind === 'weddings'
  ) {
    return 'Dasma';
  }

  if (
    kind === 'fashion'
  ) {
    return 'Modë';
  }

  if (
    kind === 'films'
  ) {
    return 'Video';
  }

  return (
    album.categorySq ||
    album.category ||
    album.kind ||
    ''
  );
};
---

<div class="project-grid">
  {
    albums.map(
      (
        album,
        i
      ) => {
        const feature =
          i === 0 &&
          albums.length > 3;

        const imageUrl =
          photoUrl(
            album.cover
          );

        const title =
          isSq
            ? (
                album.titleSq ||
                album.title
              )
            : album.title;

        const alt =
          isSq
            ? (
                album.cover?.altSq ||
                album.cover?.alt ||
                title
              )
            : (
                album.cover?.alt ||
                title
              );

        const kindLabel =
          projectKindLabel(
            album
          );

        return (
          <article
            class:list={[
              'project-card',
              {
                'project-feature':
                  feature
              }
            ]}
            data-kind={
              albumKind(album)
            }
            data-reveal
            style={`--frame-color:${album.cover?.color || '#141412'}`}
          >
            <a
              href={
                projectHref(
                  album.slug
                )
              }
            >
              <div
                class="project-image"
                data-image-reveal
                style={`--focal-point:${photoPosition(album.cover)}`}
              >
                {
                  imageUrl ? (
                    <img
                      src={photoUrl(
                        album.cover,
                        feature
                          ? 1800
                          : 1000
                      )}
                      srcset={
                        photoSet(
                          album.cover
                        )
                      }
                      sizes={
                        feature
                          ? '100vw'
                          : '(max-width: 600px) 90vw, (max-width: 1000px) 45vw, 30vw'
                      }
                      alt={alt}
                      loading="lazy"
                      decoding="async"
                      width={
                        album.cover?.width ||
                        1000
                      }
                      height={
                        album.cover?.height ||
                        1300
                      }
                    />
                  ) : (
                    <span class="project-fallback">
                      {title}
                    </span>
                  )
                }

                {
                  albumKind(album) ===
                    'films' && (
                    <span
                      class="icon-badge project-play"
                      aria-hidden="true"
                    >
                      ▶
                    </span>
                  )
                }

                <div class="project-overlay">
                  <span class="project-no">
                    {
                      String(
                        i + 1
                      ).padStart(
                        2,
                        '0'
                      )
                    }
                  </span>

                  <div class="project-overlay-text">
                    <h2>
                      {title}
                    </h2>

                    <p>
                      <span class="project-kind">
                        {kindLabel}
                      </span>

                      <span
                        class="project-sep"
                        aria-hidden="true"
                      >
                        /
                      </span>

                      <span class="project-total">
                        {
                          album.photos?.length ||
                          0
                        }

                        <span class="sr-only">
                          {
                            isSq
                              ? ' foto'
                              : ' frames'
                          }
                        </span>
                      </span>
                    </p>
                  </div>
                </div>
              </div>
            </a>
          </article>
        );
      }
    )
  }
</div>
