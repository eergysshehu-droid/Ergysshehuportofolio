---
import {photoUrl, photoSet, type Album} from '../lib/content';
interface Props {albums: Album[]}
const {albums} = Astro.props;
---
<div class="project-grid">{albums.map(album => <article><a href={`/portfolio/${album.slug}/`}><div class="project-image">{photoUrl(album.cover) ? <img src={photoUrl(album.cover)} srcset={photoSet(album.cover)} sizes="(max-width: 700px) 90vw, 46vw" alt={album.cover?.alt || album.title} loading="lazy" width="1400" height="1000"/> : <span>{album.title}</span>}</div><div class="project-caption"><h2>{album.title}</h2><span>{album.category || album.kind} ↗</span></div></a></article>)}</div>
