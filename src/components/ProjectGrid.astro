---
import {photoUrl,photoSet,albumKind,type Album} from '../lib/content';
interface Props {albums:Album[]}
const {albums}=Astro.props;
---
<div class="project-grid">{albums.map((album,i)=>{const feature=i===0 && albums.length>3; return <article class:list={['project-card',{'project-feature':feature}]} data-kind={albumKind(album)} data-reveal><a href={`/portfolio/${album.slug}/`}><div class="project-image" data-image-reveal>{photoUrl(album.cover)?<img src={photoUrl(album.cover,feature?1800:1000)} srcset={photoSet(album.cover)} sizes={feature?'100vw':'(max-width: 600px) 90vw, (max-width: 1000px) 45vw, 30vw'} alt={album.cover?.alt || album.title} loading="lazy" width={album.cover?.width || 1000} height={album.cover?.height || 1300}/>:<span>{album.title}</span>}{albumKind(album)==='films' && <span class="icon-badge project-play" aria-hidden="true">▶</span>}<span class="project-open" aria-hidden="true">↗</span></div><div class="project-caption"><span class="project-no">{String(i+1).padStart(2,'0')}</span><div><h2>{album.title}</h2><p>{album.kind==='projects'?'Personal work':album.kind==='portraits'?'Portraits & beauty':album.kind}</p></div><span class="project-total">{album.photos?.length || 0} FRAMES</span></div></a></article>;})}</div>
