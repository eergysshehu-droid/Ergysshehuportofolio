---
import {
  languageFromPath,
  localizedHref
} from '../lib/i18n';

const lang =
  languageFromPath(
    Astro.url.pathname
  );

const isSq =
  lang === 'sq';

const bookingHref =
  localizedHref(
    '/book/#contact',
    lang
  );
---

<dialog
  class="lightbox"
  aria-label={
    isSq
      ? 'Shikuesi i fotografive'
      : 'Photograph viewer'
  }
>
  <div class="lightbox-toolbar">
    <span
      class="lightbox-counter"
      aria-live="polite"
    ></span>

    <button
      type="button"
      data-close
      aria-label={
        isSq
          ? 'Mbyll shikuesin e fotografive'
          : 'Close photograph viewer'
      }
    >
      {
        isSq
          ? 'MBYLL ×'
          : 'CLOSE ×'
      }
    </button>
  </div>

  <button
    type="button"
    class="lightbox-nav lightbox-prev"
    data-prev
    aria-label={
      isSq
        ? 'Fotografia e mëparshme'
        : 'Previous photograph'
    }
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 4L7 12l8 8"/>
    </svg>
  </button>

  <button
    type="button"
    class="lightbox-nav lightbox-next"
    data-next
    aria-label={
      isSq
        ? 'Fotografia tjetër'
        : 'Next photograph'
    }
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M9 4l8 8-8 8"/>
    </svg>
  </button>

  <img
    class="lightbox-photo"
    alt=""
    decoding="async"
    draggable="false"
  />

  <p class="lightbox-caption"></p>

  <a
    class="lightbox-book"
    href={bookingHref}
    data-en="Book now ↗"
    data-sq="Rezervo ↗"
  >
    {
      isSq
        ? 'Rezervo ↗'
        : 'Book now ↗'
    }
  </a>
</dialog>

<script>
const dialog =
  document.querySelector<HTMLDialogElement>(
    '.lightbox'
  );

const links =
  Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      '.gallery figure > a'
    )
  );

if (
  dialog &&
  links.length
) {
  /*
    IMPORTANT:
    Keep a non-null local reference.
    TypeScript then knows this value can never become null
    inside nested callbacks/functions.
  */
  const lightbox =
    dialog;

  const photo =
    lightbox.querySelector<HTMLImageElement>(
      '.lightbox-photo'
    )!;

  const counter =
    lightbox.querySelector<HTMLElement>(
      '.lightbox-counter'
    )!;

  const caption =
    lightbox.querySelector<HTMLElement>(
      '.lightbox-caption'
    )!;

  let active =
    0;

  let startX =
    0;

  let startY =
    0;

  let currentX =
    0;

  let currentY =
    0;

  let dragging =
    false;

  let pointerId:
    number |
    null =
    null;


  function preload(
    index: number
  ) {
    const normalized =
      (
        index +
        links.length
      ) %
      links.length;

    const href =
      links[
        normalized
      ]?.href;

    if (
      !href
    ) {
      return;
    }

    const image =
      new Image();

    image.decoding =
      'async';

    image.src =
      href;
  }


  function resetPhotoTransform() {
    lightbox
      .classList
      .remove(
        'is-dragging',
        'is-dismiss-up',
        'is-dismiss-down'
      );

    photo.style.transform =
      '';

    photo.style.opacity =
      '';
  }


  function show(
    index: number,
    direction:
      'next' |
      'prev' |
      'direct' =
      'direct'
  ) {
    active =
      (
        index +
        links.length
      ) %
      links.length;

    const link =
      links[
        active
      ];

    if (
      !link
    ) {
      return;
    }

    const sourceImage =
      link.querySelector<HTMLImageElement>(
        'img'
      );

    if (
      direction !==
      'direct'
    ) {
      photo.style.opacity =
        '0';

      photo.style.transform =
        direction ===
        'next'
          ? 'translateX(28px) scale(.985)'
          : 'translateX(-28px) scale(.985)';
    }

    photo.src =
      link.href;

    photo.alt =
      sourceImage?.alt ||
      '';

    counter.textContent =
      `${active + 1} / ${links.length}`;

    caption.textContent =
      link
        .closest(
          'figure'
        )
        ?.querySelector(
          'figcaption'
        )
        ?.textContent ||
      '';

    requestAnimationFrame(
      () => {
        photo.style.opacity =
          '1';

        photo.style.transform =
          'translate3d(0,0,0) scale(1)';
      }
    );

    preload(
      active +
      1
    );

    preload(
      active -
      1
    );
  }


  function closeLightbox(
    direction:
      'up' |
      'down' |
      'fade' =
      'fade'
  ) {
    if (
      !lightbox.open
    ) {
      return;
    }

    if (
      direction ===
      'up'
    ) {
      lightbox
        .classList
        .add(
          'is-dismiss-up'
        );
    }

    if (
      direction ===
      'down'
    ) {
      lightbox
        .classList
        .add(
          'is-dismiss-down'
        );
    }

    lightbox
      .classList
      .add(
        'is-closing'
      );

    window.setTimeout(
      () => {
        lightbox.close();

        lightbox
          .classList
          .remove(
            'is-closing',
            'is-dismiss-up',
            'is-dismiss-down',
            'is-dragging'
          );

        photo.style.transform =
          '';

        photo.style.opacity =
          '';
      },
      260
    );
  }


  links.forEach(
    (
      link,
      i
    ) =>
      link.addEventListener(
        'click',

        event => {
          if (
            event.ctrlKey ||
            event.metaKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }

          event.preventDefault();

          resetPhotoTransform();

          show(
            i
          );

          lightbox.showModal();

          document
            .documentElement
            .classList
            .add(
              'lightbox-open'
            );

          requestAnimationFrame(
            () => {
              lightbox
                .classList
                .add(
                  'is-opened'
                );
            }
          );
        }
      )
  );


  lightbox
    .querySelector(
      '[data-prev]'
    )
    ?.addEventListener(
      'click',

      event => {
        event.stopPropagation();

        show(
          active - 1,
          'prev'
        );
      }
    );


  lightbox
    .querySelector(
      '[data-next]'
    )
    ?.addEventListener(
      'click',

      event => {
        event.stopPropagation();

        show(
          active + 1,
          'next'
        );
      }
    );


  lightbox
    .querySelector(
      '[data-close]'
    )
    ?.addEventListener(
      'click',

      event => {
        event.stopPropagation();

        closeLightbox(
          'fade'
        );
      }
    );


  lightbox.addEventListener(
    'click',

    event => {
      if (
        event.target ===
        lightbox
      ) {
        closeLightbox(
          'fade'
        );
      }
    }
  );


  lightbox.addEventListener(
    'close',

    () => {
      document
        .documentElement
        .classList
        .remove(
          'lightbox-open'
        );

      lightbox
        .classList
        .remove(
          'is-opened',
          'is-closing',
          'is-dismiss-up',
          'is-dismiss-down',
          'is-dragging'
        );

      photo.removeAttribute(
        'src'
      );

      photo.style.transform =
        '';

      photo.style.opacity =
        '';
    }
  );


  lightbox.addEventListener(
    'keydown',

    event => {
      if (
        event.key ===
        'ArrowLeft'
      ) {
        event.preventDefault();

        show(
          active - 1,
          'prev'
        );
      }

      if (
        event.key ===
        'ArrowRight'
      ) {
        event.preventDefault();

        show(
          active + 1,
          'next'
        );
      }

      if (
        event.key ===
        'Escape'
      ) {
        event.preventDefault();

        closeLightbox(
          'fade'
        );
      }
    }
  );


  photo.addEventListener(
    'pointerdown',

    event => {
      if (
        event.pointerType ===
          'mouse' &&
        event.button !==
          0
      ) {
        return;
      }

      pointerId =
        event.pointerId;

      startX =
        event.clientX;

      startY =
        event.clientY;

      currentX =
        0;

      currentY =
        0;

      dragging =
        true;

      lightbox
        .classList
        .add(
          'is-dragging'
        );

      photo
        .setPointerCapture?.(
          event.pointerId
        );
    }
  );


  photo.addEventListener(
    'pointermove',

    event => {
      if (
        !dragging ||
        pointerId !==
          event.pointerId
      ) {
        return;
      }

      currentX =
        event.clientX -
        startX;

      currentY =
        event.clientY -
        startY;

      const distance =
        Math.sqrt(
          currentX *
            currentX +
          currentY *
            currentY
        );

      const scale =
        Math.max(
          .94,
          1 -
            distance /
              2400
        );

      const opacity =
        Math.max(
          .38,
          1 -
            distance /
              620
        );

      photo.style.transform =
        `translate3d(${currentX}px, ${currentY}px, 0) scale(${scale})`;

      photo.style.opacity =
        String(
          opacity
        );
    }
  );


  function finishGesture(
    event:
      PointerEvent
  ) {
    if (
      !dragging ||
      pointerId !==
        event.pointerId
    ) {
      return;
    }

    dragging =
      false;

    pointerId =
      null;

    lightbox
      .classList
      .remove(
        'is-dragging'
      );

    const absX =
      Math.abs(
        currentX
      );

    const absY =
      Math.abs(
        currentY
      );

    if (
      absY >
        90 &&
      absY >
        absX *
          1.15
    ) {
      closeLightbox(
        currentY <
          0
          ? 'up'
          : 'down'
      );

      return;
    }

    if (
      absX >
        70 &&
      absX >
        absY *
          1.15
    ) {
      const nextDirection =
        currentX <
          0
          ? 'next'
          : 'prev';

      show(
        active +
          (
            currentX <
              0
              ? 1
              : -1
          ),
        nextDirection
      );

      return;
    }

    photo.style.transform =
      'translate3d(0,0,0) scale(1)';

    photo.style.opacity =
      '1';
  }


  photo.addEventListener(
    'pointerup',
    finishGesture
  );


  photo.addEventListener(
    'pointercancel',

    event => {
      if (
        dragging &&
        pointerId ===
          event.pointerId
      ) {
        dragging =
          false;

        pointerId =
          null;

        lightbox
          .classList
          .remove(
            'is-dragging'
          );

        photo.style.transform =
          'translate3d(0,0,0) scale(1)';

        photo.style.opacity =
          '1';
      }
    }
  );
}
</script>
