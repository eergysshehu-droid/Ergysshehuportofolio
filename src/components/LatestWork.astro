---
import { instagramMedia } from '../lib/instagram';
import { instagramSelection } from '../data/editorial-selection';
import { languageFromPath } from '../lib/i18n';
import Lightbox from './Lightbox.astro';

const lang = languageFromPath(Astro.url.pathname);
const isSq = lang === 'sq';

const availableItems = await instagramMedia(30);
const normalized = (url: string) => url.replace(/\/$/, '');

const pinnedItems = instagramSelection.permalinks.flatMap(url => {
  const item = availableItems.find(candidate =>
    normalized(candidate.permalink) === normalized(url)
  );
  return item ? [item] : [];
});

const looksPromotional = (caption = '') =>
  /(coming\s+soon|terminal|teaser|trailer|poster|premiere\s+soon)/i.test(caption);

const photographicPool = availableItems.filter(item =>
  item.media_type !== 'VIDEO' && !looksPromotional(item.caption || '')
);

const backupPhotoPool = availableItems.filter(item => item.media_type !== 'VIDEO');

const autoPool = photographicPool.length >= 6
  ? photographicPool
  : backupPhotoPool;

/*
 * Manual pinned URLs win when present in editorial-selection.ts.
 * Otherwise use the strongest automatic photography-only pool.
 */
const usableItems = (pinnedItems.length ? pinnedItems : autoPool)
  .slice(0, 10);
---

{
  usableItems.length > 0 && (
    <section
      class="latest-section instagram-gallery-section"
      id="latest"
      data-instagram-live="true"
    >
      <div class="instagram-gallery-head" data-reveal>
        <div>
          <p
            class="kicker"
            data-en="INSTAGRAM / SELECTED WORK"
            data-sq="INSTAGRAM / PUNË TË PËRZGJEDHURA"
          >
            {isSq ? 'INSTAGRAM / PUNË TË PËRZGJEDHURA' : 'INSTAGRAM / SELECTED WORK'}
          </p>

          <h2 data-en="Recent photographs" data-sq="Fotografi të fundit">
            {isSq ? 'Fotografi të fundit' : 'Recent photographs'}
          </h2>
        </div>

        <a
          class="instagram-gallery-handle"
          href="https://www.instagram.com/ergys.shehu/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={isSq ? 'Hap Instagramin e Ergys Shehut' : 'Open Ergys Shehu on Instagram'}
        >
          @ergys.shehu <span aria-hidden="true">↗</span>
        </a>
      </div>

      <p
        class="latest-intro"
        data-en="A curated live edit from Instagram — photography first."
        data-sq="Një përzgjedhje live nga Instagrami — me fokus fotografinë."
        data-reveal
      >
        {isSq
          ? 'Një përzgjedhje live nga Instagrami — me fokus fotografinë.'
          : 'A curated live edit from Instagram — photography first.'}
      </p>

      <div class="latest-grid instagram-editorial-grid">
        {
          usableItems.map((item, index) => {
            const alt = item.caption?.trim()
              ? item.caption.trim().slice(0, 160)
              : (isSq ? 'Punë e përzgjedhur nga Ergys Shehu' : 'Selected work by Ergys Shehu');

            return (
              <a
                class="latest-card instagram-editorial-card"
                data-image-reveal
                data-grid-index={index + 1}
                href={item.permalink}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={alt}
                data-caption={alt}
                data-media-type={item.media_type}
              >
                <img
                  src={item.cover}
                  alt={alt}
                  loading="lazy"
                  decoding="async"
                  width="1000"
                  height="1250"
                />

                <span class="instagram-stack-shade" aria-hidden="true"></span>

                <span class="instagram-card-index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>

                {item.media_type === 'CAROUSEL_ALBUM' && (
                  <span class="icon-badge latest-icon-carousel" aria-hidden="true">⧉</span>
                )}
              </a>
            );
          })
        }
      </div>

      <Lightbox source="instagram" />
    </section>
  )
}
