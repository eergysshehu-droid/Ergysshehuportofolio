---
import {
  instagramMedia
} from '../lib/instagram';

import {
  instagramSelection
} from '../data/editorial-selection';

import {
  languageFromPath
} from '../lib/i18n';

const lang =
  languageFromPath(
    Astro.url.pathname
  );

const isSq =
  lang === 'sq';

const availableItems =
  await instagramMedia(
    24
  );

const normalized = (
  url: string
) =>
  url.replace(
    /\/$/,
    ''
  );

const pinnedItems =
  instagramSelection.permalinks.flatMap(
    url => {
      const item =
        availableItems.find(
          item =>
            normalized(
              item.permalink
            ) ===
            normalized(
              url
            )
        );

      return item
        ? [
            item
          ]
        : [];
    }
  );

const fallbackItems =
  availableItems.filter(
    item =>
      item.media_type !==
      'VIDEO'
  );

const usableItems =
  (
    pinnedItems.length
      ? pinnedItems
      : fallbackItems
  ).slice(
    0,
    instagramSelection.limit
  );
---

{
  usableItems.length >
    0 && (
    <section
      class="latest-section"
      id="latest"
    >
      <div
        class="work-heading"
        data-reveal
      >
        <div>
          <p
            class="kicker"
            data-en="FROM THE STUDIO"
            data-sq="NGA STUDIOJA"
          >
            {
              isSq
                ? 'NGA STUDIOJA'
                : 'FROM THE STUDIO'
            }
          </p>

          <h2
            data-en="Selected moments."
            data-sq="Momente të zgjedhura."
          >
            {
              isSq
                ? 'Momente të zgjedhura.'
                : 'Selected moments.'
            }
          </h2>
        </div>
      </div>

      <p
        class="latest-intro"
        data-en="Photographs, details and moments from recent commissions, personal work and life behind the camera."
        data-sq="Fotografi, detaje dhe momente nga punët e fundit, projektet personale dhe jeta pas kamerës."
      >
        {
          isSq
            ? 'Fotografi, detaje dhe momente nga punët e fundit, projektet personale dhe jeta pas kamerës.'
            : 'Photographs, details and moments from recent commissions, personal work and life behind the camera.'
        }
      </p>

      <div class="latest-grid">
        {
          usableItems.map(
            item => {
              const alt =
                item.caption?.trim()
                  ? item.caption
                      .trim()
                      .slice(
                        0,
                        160
                      )
                  : (
                      isSq
                        ? 'Punë e fundit nga Ergys Shehu'
                        : 'Recent work by Ergys Shehu'
                    );

              return (
                <a
                  class="latest-card"
                  data-image-reveal
                  href={
                    item.permalink
                  }
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={alt}
                  data-media-type={
                    item.media_type
                  }
                  data-media-url={
                    item.media_type ===
                      'VIDEO'
                      ? item.media_url
                      : undefined
                  }
                  data-poster={
                    item.media_type ===
                      'VIDEO'
                      ? (
                          item.thumbnail_url ||
                          item.cover
                        )
                      : undefined
                  }
                >
                  <img
                    src={
                      item.cover
                    }
                    alt={alt}
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="800"
                  />

                  {
                    item.media_type ===
                      'VIDEO' && (
                      <span
                        class="icon-badge latest-icon"
                        aria-hidden="true"
                      >
                        ▶
                      </span>
                    )
                  }

                  {
                    item.media_type ===
                      'CAROUSEL_ALBUM' && (
                      <span
                        class="icon-badge latest-icon-carousel"
                        aria-hidden="true"
                      >
                        ⧉
                      </span>
                    )
                  }
                </a>
              );
            }
          )
        }
      </div>

      <a
        class="editorial-social-link"
        href="https://www.instagram.com/ergys.shehu/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={
          isSq
            ? 'Hap Instagramin e Ergys Shehut'
            : 'Open Ergys Shehu on Instagram'
        }
      >
        @ergys.shehu ↗
      </a>

      <dialog
        class="lightbox latest-lightbox"
        aria-label={
          isSq
            ? 'Shikuesi i postimeve në Instagram'
            : 'Instagram post viewer'
        }
      >
        <div class="lightbox-toolbar">
          <span
            class="lightbox-counter"
            aria-live="polite"
          ></span>

          <button
            type="button"
            data-close
            aria-label={
              isSq
                ? 'Mbyll postimin'
                : 'Close post viewer'
            }
          >
            {
              isSq
                ? 'MBYLL ×'
                : 'CLOSE ×'
            }
          </button>
        </div>

        <button
          type="button"
          class="lightbox-nav lightbox-prev"
          data-prev
          aria-label={
            isSq
              ? 'Postimi i mëparshëm'
              : 'Previous post'
          }
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 4L7 12l8 8"/>
          </svg>
        </button>

        <button
          type="button"
          class="lightbox-nav lightbox-next"
          data-next
          aria-label={
            isSq
              ? 'Postimi tjetër'
              : 'Next post'
          }
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 4l8 8-8 8"/>
          </svg>
        </button>

        <img
          class="lightbox-photo"
          alt=""
          decoding="async"
        />

        <video
          class="lightbox-video"
          controls
          playsinline
          preload="metadata"
          hidden
        ></video>

        <a
          class="lightbox-book"
          data-ig-link
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          data-en="View on Instagram ↗"
          data-sq="Shiko në Instagram ↗"
        >
          {
            isSq
              ? 'Shiko në Instagram ↗'
              : 'View on Instagram ↗'
          }
        </a>
      </dialog>
    </section>
  )
}

<script>
const dialog =
  document.querySelector<HTMLDialogElement>(
    '.latest-lightbox'
  );

const cards =
  Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      '.latest-card'
    )
  );

if (
  dialog &&
  cards.length
) {
  const photo =
    dialog.querySelector<HTMLImageElement>(
      '.lightbox-photo'
    )!;

  const video =
    dialog.querySelector<HTMLVideoElement>(
      '.lightbox-video'
    )!;

  const counter =
    dialog.querySelector<HTMLElement>(
      '.lightbox-counter'
    )!;

  const igLink =
    dialog.querySelector<HTMLAnchorElement>(
      '[data-ig-link]'
    )!;

  let active =
    0;

  function stopVideo() {
    video.pause();

    video.removeAttribute(
      'src'
    );

    video.load();

    video.hidden =
      true;
  }

  function show(
    index: number
  ) {
    active =
      (
        index +
        cards.length
      ) %
      cards.length;

    const card =
      cards[
        active
      ];

    const mediaUrl =
      card.dataset.mediaUrl;

    if (
      card.dataset.mediaType ===
        'VIDEO' &&
      mediaUrl
    ) {
      photo.hidden =
        true;

      video.hidden =
        false;

      video.poster =
        card.dataset.poster ||
        '';

      video.src =
        mediaUrl;

      video.currentTime =
        0;

      video
        .play()
        .catch(
          () => {}
        );
    } else {
      stopVideo();

      photo.hidden =
        false;

      photo.src =
        card
          .querySelector(
            'img'
          )
          ?.src ||
        '';

      photo.alt =
        card.getAttribute(
          'aria-label'
        ) ||
        '';
    }

    igLink.href =
      card.href;

    counter.textContent =
      (
        active +
        1
      ) +
      ' / ' +
      cards.length;
  }

  cards.forEach(
    (
      card,
      i
    ) =>
      card.addEventListener(
        'click',

        event => {
          if (
            event.ctrlKey ||
            event.metaKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }

          event.preventDefault();

          show(
            i
          );

          dialog.showModal();

          document
            .documentElement
            .classList
            .add(
              'lightbox-open'
            );
        }
      )
  );

  dialog
    .querySelector(
      '[data-prev]'
    )
    ?.addEventListener(
      'click',

      () =>
        show(
          active -
          1
        )
    );

  dialog
    .querySelector(
      '[data-next]'
    )
    ?.addEventListener(
      'click',

      () =>
        show(
          active +
          1
        )
    );

  dialog
    .querySelector(
      '[data-close]'
    )
    ?.addEventListener(
      'click',

      () =>
        dialog.close()
    );

  dialog.addEventListener(
    'close',

    () => {
      document
        .documentElement
        .classList
        .remove(
          'lightbox-open'
        );

      stopVideo();
    }
  );

  dialog.addEventListener(
    'keydown',

    event => {
      if (
        event.key ===
        'ArrowLeft'
      ) {
        event.preventDefault();

        show(
          active -
          1
        );
      }

      if (
        event.key ===
        'ArrowRight'
      ) {
        event.preventDefault();

        show(
          active +
          1
        );
      }
    }
  );

  let startX =
    0;

  let startY =
    0;

  let dragging =
    false;

  photo.addEventListener(
    'pointerdown',

    event => {
      startX =
        event.clientX;

      startY =
        event.clientY;

      dragging =
        true;
    }
  );

  photo.addEventListener(
    'pointercancel',

    () => {
      dragging =
        false;
    }
  );

  photo.addEventListener(
    'pointerup',

    event => {
      if (
        !dragging
      ) {
        return;
      }

      dragging =
        false;

      const dx =
        event.clientX -
        startX;

      const dy =
        event.clientY -
        startY;

      if (
        Math.abs(
          dx
        ) >
          50 &&
        Math.abs(
          dx
        ) >
          Math.abs(
            dy
          ) *
          1.2
      ) {
        show(
          active +
          (
            dx <
              0
              ? 1
              : -1
          )
        );
      }
    }
  );
}
</script>
