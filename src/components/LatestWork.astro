---
import { instagramMedia } from '../lib/instagram';
import { instagramSelection } from '../data/editorial-selection';
import { languageFromPath } from '../lib/i18n';

const lang = languageFromPath(Astro.url.pathname);
const isSq = lang === 'sq';

const availableItems = await instagramMedia(24);

const normalized = (url: string) =>
  url.replace(/\/$/, '');

const pinnedItems =
  instagramSelection.permalinks.flatMap(url => {
    const item =
      availableItems.find(
        item =>
          normalized(item.permalink) ===
          normalized(url)
      );

    return item ? [item] : [];
  });

const fallbackItems =
  availableItems.filter(
    item => item.media_type !== 'VIDEO'
  );

const usableItems =
  (
    pinnedItems.length
      ? pinnedItems
      : fallbackItems
  ).slice(
    0,
    instagramSelection.limit
  );
---

{
  usableItems.length > 0 && (
    <section
      class="latest-section"
      id="latest"
    >
      <div
        class="work-heading"
        data-reveal
      >
        <div>
          <p
            class="kicker"
            data-en="FROM THE STUDIO"
            data-sq="NGA STUDIOJA"
          >
            {
              isSq
                ? 'NGA STUDIOJA'
                : 'FROM THE STUDIO'
            }
          </p>

          <h2
            data-en="Selected moments."
            data-sq="Momente të zgjedhura."
          >
            {
              isSq
                ? 'Momente të zgjedhura.'
                : 'Selected moments.'
            }
          </h2>
        </div>
      </div>

      <p
        class="latest-intro"
        data-en="Photographs, details and moments from recent commissions, personal work and life behind the camera."
        data-sq="Fotografi, detaje dhe momente nga punët e fundit, projektet personale dhe jeta pas kamerës."
      >
        {
          isSq
            ? 'Fotografi, detaje dhe momente nga punët e fundit, projektet personale dhe jeta pas kamerës.'
            : 'Photographs, details and moments from recent commissions, personal work and life behind the camera.'
        }
      </p>

      <div class="latest-grid">
        {
          usableItems.map(item => {
            const alt =
              item.caption?.trim()
                ? item.caption
                    .trim()
                    .slice(0, 160)
                : (
                    isSq
                      ? 'Punë e fundit nga Ergys Shehu'
                      : 'Recent work by Ergys Shehu'
                  );

            return (
              <a
                class="latest-card"
                data-image-reveal
                href={item.permalink}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={alt}
                data-media-type={item.media_type}
                data-media-url={
                  item.media_type === 'VIDEO'
                    ? item.media_url
                    : undefined
                }
                data-poster={
                  item.media_type === 'VIDEO'
                    ? (
                        item.thumbnail_url ||
                        item.cover
                      )
                    : undefined
                }
              >
                <img
                  src={item.cover}
                  alt={alt}
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="800"
                />

                {
                  item.media_type === 'VIDEO' && (
                    <span
                      class="icon-badge latest-icon"
                      aria-hidden="true"
                    >
                      ▶
                    </span>
                  )
                }

                {
                  item.media_type ===
                    'CAROUSEL_ALBUM' && (
                    <span
                      class="icon-badge latest-icon-carousel"
                      aria-hidden="true"
                    >
                      ⧉
                    </span>
                  )
                }
              </a>
            );
          })
        }
      </div>

      <a
        class="editorial-social-link"
        href="https://www.instagram.com/ergys.shehu/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={
          isSq
            ? 'Hap Instagramin e Ergys Shehut'
            : 'Open Ergys Shehu on Instagram'
        }
      >
        @ergys.shehu ↗
      </a>

      <dialog
        class="lightbox latest-lightbox"
        aria-label={
          isSq
            ? 'Shikuesi i postimeve në Instagram'
            : 'Instagram post viewer'
        }
      >
        <div class="lightbox-toolbar">
          <span
            class="lightbox-counter"
            aria-live="polite"
          ></span>

          <button
            type="button"
            data-close
            aria-label={
              isSq
                ? 'Mbyll postimin'
                : 'Close post viewer'
            }
          >
            {
              isSq
                ? 'MBYLL ×'
                : 'CLOSE ×'
            }
          </button>
        </div>

        <button
          type="button"
          class="lightbox-nav lightbox-prev"
          data-prev
          aria-label={
            isSq
              ? 'Postimi i mëparshëm'
              : 'Previous post'
          }
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 4L7 12l8 8"/>
          </svg>
        </button>

        <button
          type="button"
          class="lightbox-nav lightbox-next"
          data-next
          aria-label={
            isSq
              ? 'Postimi tjetër'
              : 'Next post'
          }
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 4l8 8-8 8"/>
          </svg>
        </button>

        <img
          class="lightbox-photo"
          alt=""
          decoding="async"
          draggable="false"
        />

        <video
          class="lightbox-video"
          controls
          playsinline
          preload="metadata"
          hidden
        ></video>

        <a
          class="lightbox-book"
          data-ig-link
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          data-en="View on Instagram ↗"
          data-sq="Shiko në Instagram ↗"
        >
          {
            isSq
              ? 'Shiko në Instagram ↗'
              : 'View on Instagram ↗'
          }
        </a>
      </dialog>
    </section>
  )
}

<script>
const dialog =
  document.querySelector<HTMLDialogElement>(
    '.latest-lightbox'
  );

const cards =
  Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      '.latest-card'
    )
  );

if (
  dialog &&
  cards.length
) {
  const lightbox =
    dialog;

  const photo =
    lightbox.querySelector<HTMLImageElement>(
      '.lightbox-photo'
    )!;

  const video =
    lightbox.querySelector<HTMLVideoElement>(
      '.lightbox-video'
    )!;

  const counter =
    lightbox.querySelector<HTMLElement>(
      '.lightbox-counter'
    )!;

  const igLink =
    lightbox.querySelector<HTMLAnchorElement>(
      '[data-ig-link]'
    )!;

  let active = 0;

  let startX = 0;
  let startY = 0;

  let currentX = 0;
  let currentY = 0;

  let dragging = false;

  let pointerId:
    number |
    null =
    null;


  function stopVideo() {
    video.pause();

    video.removeAttribute(
      'src'
    );

    video.load();

    video.hidden =
      true;
  }


  function activeMedia():
    HTMLElement {
    return video.hidden
      ? photo
      : video;
  }


  function resetMedia() {
    lightbox.classList.remove(
      'is-dragging',
      'is-dismiss-up',
      'is-dismiss-down'
    );

    photo.style.transform = '';
    photo.style.opacity = '';

    video.style.transform = '';
    video.style.opacity = '';
  }


  function show(
    index: number,
    direction:
      'next' |
      'prev' |
      'direct' =
      'direct'
  ) {
    active =
      (
        index +
        cards.length
      ) %
      cards.length;

    const card =
      cards[active];

    if (!card) {
      return;
    }

    const mediaUrl =
      card.dataset.mediaUrl;

    resetMedia();

    if (
      direction !==
      'direct'
    ) {
      const offset =
        direction === 'next'
          ? 32
          : -32;

      photo.style.opacity = '0';
      photo.style.transform =
        `translateX(${offset}px) scale(.985)`;

      video.style.opacity = '0';
      video.style.transform =
        `translateX(${offset}px) scale(.985)`;
    }

    if (
      card.dataset.mediaType ===
        'VIDEO' &&
      mediaUrl
    ) {
      photo.hidden =
        true;

      video.hidden =
        false;

      video.poster =
        card.dataset.poster ||
        '';

      video.src =
        mediaUrl;

      video.currentTime =
        0;

      video
        .play()
        .catch(() => {});
    } else {
      stopVideo();

      photo.hidden =
        false;

      photo.src =
        card
          .querySelector(
            'img'
          )
          ?.src ||
        '';

      photo.alt =
        card.getAttribute(
          'aria-label'
        ) ||
        '';
    }

    igLink.href =
      card.href;

    counter.textContent =
      `${active + 1} / ${cards.length}`;

    requestAnimationFrame(
      () => {
        const media =
          activeMedia();

        media.style.opacity =
          '1';

        media.style.transform =
          'translate3d(0,0,0) scale(1)';
      }
    );
  }


  function closeLightbox(
    direction:
      'up' |
      'down' |
      'fade' =
      'fade'
  ) {
    if (
      !lightbox.open
    ) {
      return;
    }

    if (
      direction === 'up'
    ) {
      lightbox.classList.add(
        'is-dismiss-up'
      );
    }

    if (
      direction === 'down'
    ) {
      lightbox.classList.add(
        'is-dismiss-down'
      );
    }

    lightbox.classList.add(
      'is-closing'
    );

    window.setTimeout(
      () => {
        lightbox.close();

        lightbox.classList.remove(
          'is-closing',
          'is-dismiss-up',
          'is-dismiss-down',
          'is-dragging'
        );

        stopVideo();
        resetMedia();
      },
      260
    );
  }


  cards.forEach(
    (
      card,
      i
    ) => {
      card.addEventListener(
        'click',
        event => {
          if (
            event.ctrlKey ||
            event.metaKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }

          event.preventDefault();

          resetMedia();

          show(i);

          lightbox.showModal();

          document
            .documentElement
            .classList
            .add(
              'lightbox-open'
            );
        }
      );
    }
  );


  lightbox
    .querySelector(
      '[data-prev]'
    )
    ?.addEventListener(
      'click',
      event => {
        event.stopPropagation();

        show(
          active - 1,
          'prev'
        );
      }
    );


  lightbox
    .querySelector(
      '[data-next]'
    )
    ?.addEventListener(
      'click',
      event => {
        event.stopPropagation();

        show(
          active + 1,
          'next'
        );
      }
    );


  lightbox
    .querySelector(
      '[data-close]'
    )
    ?.addEventListener(
      'click',
      event => {
        event.stopPropagation();

        closeLightbox(
          'fade'
        );
      }
    );


  lightbox.addEventListener(
    'click',
    event => {
      if (
        event.target ===
        lightbox
      ) {
        closeLightbox(
          'fade'
        );
      }
    }
  );


  lightbox.addEventListener(
    'close',
    () => {
      document
        .documentElement
        .classList
        .remove(
          'lightbox-open'
        );

      stopVideo();
      resetMedia();
    }
  );


  lightbox.addEventListener(
    'keydown',
    event => {
      if (
        event.key ===
        'ArrowLeft'
      ) {
        event.preventDefault();

        show(
          active - 1,
          'prev'
        );
      }

      if (
        event.key ===
        'ArrowRight'
      ) {
        event.preventDefault();

        show(
          active + 1,
          'next'
        );
      }

      if (
        event.key ===
        'Escape'
      ) {
        event.preventDefault();

        closeLightbox(
          'fade'
        );
      }
    }
  );


  function beginGesture(
    event:
      PointerEvent
  ) {
    if (
      event.pointerType ===
        'mouse' &&
      event.button !==
        0
    ) {
      return;
    }

    pointerId =
      event.pointerId;

    startX =
      event.clientX;

    startY =
      event.clientY;

    currentX = 0;
    currentY = 0;

    dragging =
      true;

    lightbox.classList.add(
      'is-dragging'
    );

    (
      event.currentTarget as
      HTMLElement
    ).setPointerCapture?.(
      event.pointerId
    );
  }


  function moveGesture(
    event:
      PointerEvent
  ) {
    if (
      !dragging ||
      pointerId !==
        event.pointerId
    ) {
      return;
    }

    currentX =
      event.clientX -
      startX;

    currentY =
      event.clientY -
      startY;

    const media =
      activeMedia();

    const distance =
      Math.sqrt(
        currentX *
          currentX +
        currentY *
          currentY
      );

    const scale =
      Math.max(
        .94,
        1 -
          distance /
            2400
      );

    const opacity =
      Math.max(
        .38,
        1 -
          distance /
            620
      );

    media.style.transform =
      `translate3d(${currentX}px, ${currentY}px, 0) scale(${scale})`;

    media.style.opacity =
      String(opacity);
  }


  function finishGesture(
    event:
      PointerEvent
  ) {
    if (
      !dragging ||
      pointerId !==
        event.pointerId
    ) {
      return;
    }

    dragging =
      false;

    pointerId =
      null;

    lightbox.classList.remove(
      'is-dragging'
    );

    const absX =
      Math.abs(
        currentX
      );

    const absY =
      Math.abs(
        currentY
      );

    if (
      absY > 90 &&
      absY >
        absX *
          1.15
    ) {
      closeLightbox(
        currentY < 0
          ? 'up'
          : 'down'
      );

      return;
    }

    if (
      absX > 70 &&
      absX >
        absY *
          1.15
    ) {
      show(
        active +
          (
            currentX < 0
              ? 1
              : -1
          ),
        currentX < 0
          ? 'next'
          : 'prev'
      );

      return;
    }

    const media =
      activeMedia();

    media.style.transform =
      'translate3d(0,0,0) scale(1)';

    media.style.opacity =
      '1';
  }


  function cancelGesture(
    event:
      PointerEvent
  ) {
    if (
      !dragging ||
      pointerId !==
        event.pointerId
    ) {
      return;
    }

    dragging =
      false;

    pointerId =
      null;

    lightbox.classList.remove(
      'is-dragging'
    );

    const media =
      activeMedia();

    media.style.transform =
      'translate3d(0,0,0) scale(1)';

    media.style.opacity =
      '1';
  }


  photo.addEventListener(
    'pointerdown',
    beginGesture
  );

  photo.addEventListener(
    'pointermove',
    moveGesture
  );

  photo.addEventListener(
    'pointerup',
    finishGesture
  );

  photo.addEventListener(
    'pointercancel',
    cancelGesture
  );


  video.addEventListener(
    'pointerdown',
    beginGesture
  );

  video.addEventListener(
    'pointermove',
    moveGesture
  );

  video.addEventListener(
    'pointerup',
    finishGesture
  );

  video.addEventListener(
    'pointercancel',
    cancelGesture
  );
}
</script>
