---
import {
  instagramMedia
} from '../lib/instagram';

import {
  instagramSelection
} from '../data/editorial-selection';

import {
  languageFromPath
} from '../lib/i18n';

import Lightbox
  from './Lightbox.astro';


const lang =
  languageFromPath(
    Astro.url.pathname
  );


const isSq =
  lang ===
  'sq';


const availableItems =
  await instagramMedia(
    24
  );


const normalized = (
  url:
    string
) =>
  url.replace(
    /\/$/,
    ''
  );


const pinnedItems =
  instagramSelection
    .permalinks
    .flatMap(
      url=>{
        const item =
          availableItems
            .find(
              item=>
                normalized(
                  item.permalink
                ) ===
                normalized(
                  url
                )
            );


        return item
          ? [
              item
            ]
          : [];
      }
    );


const fallbackItems =
  availableItems
    .filter(
      item=>
        item.media_type !==
        'VIDEO'
    );


const usableItems =
  (
    pinnedItems.length
      ? pinnedItems
      : fallbackItems
  ).slice(
    0,
    instagramSelection.limit
  );
---


{
  usableItems.length >
    0 && (
    <section
      class="latest-section"
      id="latest"
    >
      <div
        class="work-heading"
        data-reveal
      >
        <div>
          <p
            class="kicker"
            data-en="FROM THE STUDIO"
            data-sq="NGA STUDIOJA"
          >
            {
              isSq
                ? 'NGA STUDIOJA'
                : 'FROM THE STUDIO'
            }
          </p>


          <h2
            data-en="Selected moments."
            data-sq="Momente të përzgjedhura."
          >
            {
              isSq
                ? 'Momente të përzgjedhura.'
                : 'Selected moments.'
            }
          </h2>
        </div>
      </div>


      <p
        class="latest-intro"
        data-en="Photographs, details and moments from recent commissions, personal work and life behind the camera."
        data-sq="Fotografi, fragmente dhe momente nga projektet e fundit, puna personale dhe jeta pas kamerës."
      >
        {
          isSq
            ? 'Fotografi, fragmente dhe momente nga projektet e fundit, puna personale dhe jeta pas kamerës.'
            : 'Photographs, details and moments from recent commissions, personal work and life behind the camera.'
        }
      </p>


      <div class="latest-grid">
        {
          usableItems.map(
            item=>{
              const alt =
                item.caption
                  ?.trim()
                  ? item
                      .caption
                      .trim()
                      .slice(
                        0,
                        160
                      )
                  : (
                      isSq
                        ? 'Punë e fundit nga Ergys Shehu'
                        : 'Recent work by Ergys Shehu'
                    );


              return (
                <a
                  class="latest-card"
                  data-image-reveal
                  href={item.permalink}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={alt}
                  data-caption={alt}
                  data-media-type={
                    item.media_type
                  }
                  data-media-url={
                    item.media_type ===
                      'VIDEO'
                      ? item.media_url
                      : undefined
                  }
                  data-poster={
                    item.media_type ===
                      'VIDEO'
                      ? (
                          item.thumbnail_url ||
                          item.cover
                        )
                      : undefined
                  }
                >
                  <img
                    src={item.cover}
                    alt={alt}
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="800"
                  />


                  {
                    item.media_type ===
                      'VIDEO' && (
                      <span
                        class="icon-badge latest-icon"
                        aria-hidden="true"
                      >
                        ▶
                      </span>
                    )
                  }


                  {
                    item.media_type ===
                      'CAROUSEL_ALBUM' && (
                      <span
                        class="icon-badge latest-icon-carousel"
                        aria-hidden="true"
                      >
                        ⧉
                      </span>
                    )
                  }
                </a>
              );
            }
          )
        }
      </div>


      <a
        class="editorial-social-link"
        href="https://www.instagram.com/ergys.shehu/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={
          isSq
            ? 'Hap Instagramin e Ergys Shehut'
            : 'Open Ergys Shehu on Instagram'
        }
      >
        @ergys.shehu ↗
      </a>


      <Lightbox
        source="instagram"
      />
    </section>
  )
}
