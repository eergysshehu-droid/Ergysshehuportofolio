---
import {instagramMedia} from '../lib/instagram';

// instagramMedia() already validates every item (see src/lib/instagram.ts) —
// cover and permalink are guaranteed to be well-formed http(s) URLs here.
const usableItems = (await instagramMedia(24)).slice(0, 18);
---
{usableItems.length > 0 && <section class="latest-section" id="latest"><div class="work-heading" data-reveal><div><p class="kicker">LATEST · CURRENT WORK</p><h2>Right now.</h2></div></div><div class="latest-grid">{usableItems.map(item =>
  <a class="latest-card" data-image-reveal href={item.permalink} target="_blank" rel="noopener noreferrer" aria-label={item.caption?.slice(0,140) || 'View recent work on Instagram'}><img src={item.cover} alt="" loading="lazy" width="800" height="800"/>{item.media_type === 'VIDEO' && <span class="icon-badge latest-icon" aria-hidden="true">▶</span>}{item.media_type === 'CAROUSEL_ALBUM' && <span class="icon-badge latest-icon-carousel" aria-hidden="true">⧉</span>}</a>
)}</div>
<dialog class="lightbox latest-lightbox" aria-label="Instagram post viewer"><div class="lightbox-toolbar"><span class="lightbox-counter" aria-live="polite"></span><div class="lightbox-controls"><button type="button" data-prev aria-label="Previous post">←</button><button type="button" data-next aria-label="Next post">→</button><button type="button" data-close aria-label="Close post viewer">CLOSE ×</button></div></div><img class="lightbox-photo" alt=""/><a class="lightbox-book" data-ig-link href="#" target="_blank" rel="noopener noreferrer">View on Instagram ↗</a></dialog>
</section>}

<script>
// Clicking a card opens the full image in place first — a click straight
// out to Instagram was too abrupt for just browsing. "View on Instagram"
// inside the viewer is the deliberate second step to actually leave the
// site, same two-step feel as the portfolio Lightbox.
const dialog = document.querySelector<HTMLDialogElement>('.latest-lightbox');
const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.latest-card'));
if (dialog && cards.length) {
  const photo = dialog.querySelector<HTMLImageElement>('.lightbox-photo')!;
  const counter = dialog.querySelector<HTMLElement>('.lightbox-counter')!;
  const igLink = dialog.querySelector<HTMLAnchorElement>('[data-ig-link]')!;
  let active = 0;
  function show(index: number) {
    active = (index + cards.length) % cards.length;
    const card = cards[active];
    photo.src = card.querySelector('img')?.src || '';
    photo.alt = card.getAttribute('aria-label') || '';
    igLink.href = card.href;
    counter.textContent = (active + 1) + ' / ' + cards.length;
  }
  cards.forEach((card, i) => card.addEventListener('click', event => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    show(i);
    dialog.showModal();
    document.documentElement.classList.add('lightbox-open');
  }));
  dialog.querySelector('[data-prev]')?.addEventListener('click', () => show(active - 1));
  dialog.querySelector('[data-next]')?.addEventListener('click', () => show(active + 1));
  dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => document.documentElement.classList.remove('lightbox-open'));
  dialog.addEventListener('keydown', event => {
    if (event.key === 'ArrowLeft') { event.preventDefault(); show(active - 1); }
    if (event.key === 'ArrowRight') { event.preventDefault(); show(active + 1); }
  });
}
</script>
