---
import {instagramMedia} from '../lib/instagram';
const items = await instagramMedia(9);
---
{items.length > 0 && <section class="latest-section" id="latest"><div class="work-heading" data-reveal><div><p class="kicker">LATEST · CURRENT WORK</p><h2>Right now.</h2></div></div><div class="latest-grid">{items.map(item => {
  const cover = item.media_type === 'VIDEO' ? (item.thumbnail_url || item.media_url) : item.media_url;
  return <a class="latest-card" data-image-reveal href={item.permalink} target="_blank" rel="noopener noreferrer" aria-label={item.caption?.slice(0,140) || 'View recent work on Instagram'}>{cover && <img src={cover} alt="" loading="lazy" width="800" height="800"/>}{item.media_type === 'VIDEO' && <span class="icon-badge latest-icon" aria-hidden="true">▶</span>}{item.media_type === 'CAROUSEL_ALBUM' && <span class="icon-badge latest-icon-carousel" aria-hidden="true">⧉</span>}</a>;
})}</div></section>}
