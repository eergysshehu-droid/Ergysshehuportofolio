---
interface Props {
  isSq?: boolean;
}

const { isSq = false } = Astro.props;
---

<div
  class="cinematic-intro brand-reveal-intro"
  data-intro
  data-brand-reveal
  aria-hidden="true"
>
  <div class="brand-reveal-stage">
    <svg
      class="brand-reveal-mark"
      viewBox="0 0 1037 866"
      aria-hidden="true"
    >
      <path class="brand-reveal-shape" pathLength="1" d="M 505 401 L 293 401 L 0 863 L 200 863 Z"/>
      <path class="brand-reveal-shape" pathLength="1" d="M 380 647 L 241 865 L 499 864 Z"/>
      <path class="brand-reveal-shape" pathLength="1" d="M 541 0 L 312 372 L 540 373 L 667 591 L 785 415 Z"/>
      <path class="brand-reveal-shape" pathLength="1" d="M 451 714 L 532 863 L 1036 863 L 953 714 Z"/>
      <path class="brand-reveal-shape" pathLength="1" d="M 940 687 L 804 445 L 641 688 Z"/>
    </svg>

    <div class="brand-reveal-wordmark">
      <span class="brand-reveal-ergys">ERGYS</span>

      <span class="brand-reveal-shehu-wrap">
        <svg
          class="brand-reveal-shehu-signature"
          viewBox="0 0 420 112"
          aria-label="SHEHU"
          role="img"
        >
          <path class="signature-stroke" style="--sig-i:0" pathLength="1" d="M55 22 C35 7 10 16 18 38 C26 58 62 38 64 58 C66 78 39 91 16 75"/>
          <path class="signature-stroke" style="--sig-i:1" pathLength="1" d="M92 86 C94 63 99 37 105 15 M100 56 C119 45 138 42 154 47 M153 16 C149 39 145 63 145 84"/>
          <path class="signature-stroke" style="--sig-i:2" pathLength="1" d="M174 58 C188 42 213 38 221 49 C229 62 201 69 176 62 C175 77 193 86 217 78"/>
          <path class="signature-stroke" style="--sig-i:3" pathLength="1" d="M244 86 C246 62 251 37 257 15 M252 55 C271 44 290 42 306 47 M304 16 C301 39 297 63 297 84"/>
          <path class="signature-stroke" style="--sig-i:4" pathLength="1" d="M327 44 C323 63 323 79 337 83 C354 88 372 68 376 43 M377 43 C374 61 374 75 377 84"/>
          <path class="signature-flourish" pathLength="1" d="M16 96 C97 100 203 100 293 96 C337 94 377 89 404 80"/>
        </svg>

        <span class="brand-reveal-shehu-final">SHEHU</span>
      </span>
    </div>

    <span
      class="brand-reveal-role"
      data-en="PHOTOGRAPHER · DIRECTOR · VISUAL ARTIST"
      data-sq="FOTOGRAF · REGJISOR · ARTIST VIZUAL"
    >
      {isSq ? 'FOTOGRAF · REGJISOR · ARTIST VIZUAL' : 'PHOTOGRAPHER · DIRECTOR · VISUAL ARTIST'}
    </span>
  </div>

  <div class="intro-meta brand-reveal-meta">
    <span
      data-en="A VISUAL STORY AWAITS"
      data-sq="NJË HISTORI VIZUALE TË PRET"
    >
      {isSq ? 'NJË HISTORI VIZUALE TË PRET' : 'A VISUAL STORY AWAITS'}
    </span>
    <span>01 / 04</span>
  </div>

  <div class="intro-curtain intro-curtain-left"></div>
  <div class="intro-curtain intro-curtain-right"></div>
</div>
