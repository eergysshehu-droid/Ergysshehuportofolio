            'site-lang — localStorage; remembers the selected website language.',
            'ergys-intro-seen — sessionStorage; prevents the homepage intro from replaying repeatedly within the same tab session.'
          ]
        },
        {
          id: 'cloudflare',
          title: 'Cloudflare security cookies',
          paragraphs: [
            'Cloudflare protects and delivers the website. Depending on enabled security features and whether a visitor is challenged, Cloudflare may set strictly necessary cookies such as __cf_bm or cf_clearance. These can be used for bot detection, challenge validation, traffic management or security rather than advertising.',
            'Not every visitor will necessarily receive the same Cloudflare cookie; their use depends on the security configuration and the request.'
          ]
        },
        {
          id: 'youtube',
          title: 'YouTube',
          paragraphs: [
            'Embedded video uses youtube-nocookie.com, YouTube’s Privacy Enhanced Mode. Loading or interacting with an embedded player can still allow YouTube or Google to process technical information and may involve storage controlled by those services.',
            'If the website later adds analytics, advertising pixels or other non-essential tracking, this policy and any required consent controls should be updated before those technologies are intentionally activated.'
          ]
        },
        {
          id: 'controls',
          title: 'Your controls',
          paragraphs: [
            'You can clear or block cookies, localStorage and sessionStorage using your browser settings. Blocking strictly necessary storage or third-party media may affect security checks, language preference or embedded video functionality.',
            'For privacy questions, use the contact details below.'
          ]
        }
      ]
    },
    sq: {
      eyebrow: 'LIGJORE / RUAJTJE',
      title: 'Politika e Cookies & Storage',
      deck: 'Një shpjegim i shkurtër dhe transparent për cookies dhe ruajtjen në shfletues që përdor ergysshehu.com.',
      description: 'Politika e cookies dhe browser storage për ergysshehu.com, përfshirë sigurinë Cloudflare, preferencën e gjuhës, intro-n dhe videot YouTube.',
      sections: [
        {
          id: 'summary',
          title: 'Gjendja aktuale',
          paragraphs: [
            'ergysshehu.com aktualisht nuk instalon qëllimisht Google Analytics, Meta Pixel ose cookies reklamimi. Në kodin e faqes nuk është instaluar qëllimisht tracking për profil reklamues ose marketing ndërmjet faqeve.',
            'Faqja përdor një sasi të kufizuar ruajtjeje në shfletues për funksionalitet dhe mund të marrë cookies sigurie rreptësisht të nevojshme nga Cloudflare kur sistemet e mbrojtjes i kërkojnë.'
          ]
        },
        {
          id: 'storage',
          title: 'Ruajtja në shfletues',
          paragraphs: [
            'Faqja ruan një preferencë të vogël të gjuhës në localStorage që ndërfaqja EN/SQ të funksionojë në mënyrë të qëndrueshme. Homepage përdor gjithashtu sessionStorage për të kujtuar, gjatë sesionit të tab-it aktual, nëse intro-ja kinematografike është shfaqur.',
            'localStorage dhe sessionStorage janë teknologji ruajtjeje në shfletues dhe jo cookies HTTP. Ato qëndrojnë në pajisjen tënde sipas rregullave të shfletuesit dhe mund të pastrohen nga cilësimet e tij.'
          ],
          bullets: [
            'site-lang — localStorage; kujton gjuhën e zgjedhur të faqes.',
            'ergys-intro-seen — sessionStorage; parandalon rishfaqjen e përsëritur të intro-s brenda të njëjtit sesion të tab-it.'
          ]
        },
        {
          id: 'cloudflare',
          title: 'Cookies sigurie nga Cloudflare',
          paragraphs: [
            'Cloudflare mbron dhe shpërndan faqen. Në varësi të veçorive të aktivizuara të sigurisë dhe nëse një vizitor kalon një kontroll, Cloudflare mund të vendosë cookies rreptësisht të nevojshme si __cf_bm ose cf_clearance. Ato mund të përdoren për zbulimin e bot-eve, validimin e kontrolleve, menaxhimin e trafikut ose sigurinë dhe jo për reklamim.',
            'Jo çdo vizitor merr domosdoshmërisht të njëjtën cookie Cloudflare; përdorimi varet nga konfigurimi i sigurisë dhe kërkesa konkrete.'
          ]
        },
        {
          id: 'youtube',
          title: 'YouTube',
          paragraphs: [
            'Videot e integruara përdorin youtube-nocookie.com, pra Privacy Enhanced Mode të YouTube. Ngarkimi ose ndërveprimi me player-in mund t’i lejojë YouTube ose Google të përpunojnë të dhëna teknike dhe mund të përfshijë ruajtje të kontrolluar nga këto shërbime.',
            'Nëse në të ardhmen faqja shton analytics, pixels reklamimi ose tracking jo thelbësor, kjo politikë dhe çdo mekanizëm i nevojshëm pëlqimi duhet të përditësohen përpara aktivizimit të qëllimshëm të tyre.'
          ]
        },
        {
          id: 'controls',
          title: 'Kontrollet e tua',
          paragraphs: [
            'Mund të pastrosh ose bllokosh cookies, localStorage dhe sessionStorage nga cilësimet e shfletuesit. Bllokimi i ruajtjes rreptësisht të nevojshme ose medias së palëve të treta mund të ndikojë te kontrollet e sigurisë, preferenca e gjuhës ose videot e integruara.',
            'Për pyetje mbi privatësinë, përdor kontaktin e mëposhtëm.'
          ]
        }
      ]
    }
  }
};

const page = legal[type][isSq ? 'sq' : 'en'];

const updatedLabel = isSq ? 'PËRDITËSUAR' : 'UPDATED';
const indexLabel = isSq ? 'NË KËTË FAQE' : 'ON THIS PAGE';
const contactLabel = isSq ? 'KONTAKT PRIVATËSIE' : 'PRIVACY CONTACT';
const backLabel = isSq ? '← Ballina' : '← Home';
---

<Layout
  lang={lang}
  title={`${page.title} | Ergys Shehu`}
  description={page.description}
>
  <article class="legal-page">
    <header class="legal-hero">
      <a
        class="legal-back"
        href={localizedPath('/', lang)}
      >
        {backLabel}
      </a>

      <div class="legal-hero-grid">
        <div>
          <p class="legal-eyebrow">
            {page.eyebrow}
          </p>

          <h1>
            {page.title}
          </h1>
        </div>

        <div class="legal-deck">
          <p>
            {page.deck}
          </p>

          <p class="legal-updated">
            <span>{updatedLabel}</span>
            {isSq ? updatedSq : updatedEn}
          </p>
        </div>
      </div>
    </header>

    <div class="legal-shell">
      <aside class="legal-index">
        <p>{indexLabel}</p>

        <nav aria-label={indexLabel}>
          {
            page.sections.map(
              (section, index) => (
                <a href={`#${section.id}`}>
                  <span>
                    {String(index + 1).padStart(2, '0')}
                  </span>

                  {section.title}
                </a>
              )
            )
          }
        </nav>
      </aside>

      <div class="legal-content">
        {
          page.sections.map(
            (section, index) => (
              <section
                id={section.id}
                class="legal-section"
              >
                <div class="legal-section-number">
                  {String(index + 1).padStart(2, '0')}
                </div>

                <div>
                  <h2>{section.title}</h2>

                  {
                    section.paragraphs.map(
                      paragraph => (
                        <p>{paragraph}</p>
                      )
                    )
                  }

                  {
                    section.bullets && (
                      <ul>
                        {
                          section.bullets.map(
                            item => (
                              <li>{item}</li>
                            )
                          )
                        }
                      </ul>
                    )
                  }
                </div>
              </section>
            )
          )
        }

        <section class="legal-contact-card">
          <p>{contactLabel}</p>

          <a href={`mailto:${email}`}>
            {email}
            <span aria-hidden="true">↗</span>
          </a>

          {
            type === 'privacy' && (
              <a
                class="legal-authority"
                href="https://idp.al/"
                target="_blank"
                rel="noopener noreferrer"
              >
                {
                  isSq
                    ? 'Komisioneri për të Drejtën e Informimit dhe Mbrojtjen e të Dhënave Personale ↗'
                    : 'Albanian Information and Data Protection Commissioner ↗'
                }
              </a>
            )
          }
        </section>
      </div>
    </div>
  </article>
</Layout>
