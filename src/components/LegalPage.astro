---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/legal.css';

import {
  languageFromPath,
  localizedPath
} from '../lib/i18n';

type LegalType = 'privacy' | 'terms' | 'cookies';

type LegalSection = {
  id: string;
  title: string;
  paragraphs: string[];
  bullets?: string[];
};

type LegalPageData = {
  eyebrow: string;
  title: string;
  deck: string;
  description: string;
  sections: LegalSection[];
};

interface Props {
  type: LegalType;
}

const { type } = Astro.props;

const lang = languageFromPath(Astro.url.pathname);
const isSq = lang === 'sq';

const updatedEn = '18 September 2026';
const updatedSq = '18 shtator 2026';
const email = 'e.ergysshehu@gmail.com';

const legal: Record<
  LegalType,
  {
    en: LegalPageData;
    sq: LegalPageData;
