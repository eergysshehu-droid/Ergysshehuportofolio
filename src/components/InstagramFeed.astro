---
import imported from '../data/instagram-portfolio.json';
import {type Album,photoUrl} from '../lib/content';
const albums=(imported.albums as Album[]).slice(-12).reverse();
---
{albums.length>0 && <section class="instagram-work" aria-label="Recent Instagram work"><div class="work-heading"><div><p class="kicker">RECENT PHOTOGRAPHY & REELS</p><h2>From the studio.</h2></div><a href="https://www.instagram.com/ergys.shehu/" target="_blank" rel="noopener noreferrer">INSTAGRAM ↗</a></div><div class="instagram-grid">{albums.map(album=><article>{album.localVideo?<video controls playsinline preload="none" poster={photoUrl(album.cover)} aria-label={album.title}><source src={album.localVideo} type="video/mp4"/><a href={album.instagramUrl}>Watch on Instagram</a></video>:<a href={`/portfolio/${album.slug}/`}><img src={photoUrl(album.cover)} alt={album.cover?.alt || album.title} loading="lazy"/></a>}<div class="instagram-caption"><a href={`/portfolio/${album.slug}/`}>{album.title}</a><span>{album.localVideo?'REEL':album.kind}</span></div></article>)}</div></section>}
<style>.instagram-work{padding:65px 5vw;border-top:1px solid var(--line)}.instagram-work .work-heading>a{font-size:10px}.instagram-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.instagram-grid video,.instagram-grid img{width:100%;aspect-ratio:4/5;object-fit:contain;background:#171714;display:block}.instagram-caption{display:flex;justify-content:space-between;gap:12px;margin-top:12px;font-size:12px}.instagram-caption span{font-size:9px;text-transform:uppercase;color:var(--muted)}@media(max-width:800px){.instagram-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:500px){.instagram-grid{grid-template-columns:1fr}}</style>
