<dialog class="lightbox" aria-label="Photograph viewer"><div class="lightbox-toolbar"><span class="lightbox-counter" aria-live="polite"></span><div class="lightbox-controls"><button type="button" data-prev aria-label="Previous photograph">←</button><button type="button" data-next aria-label="Next photograph">→</button><button type="button" data-close aria-label="Close photograph viewer">CLOSE ×</button></div></div><img class="lightbox-photo" alt=""/><p class="lightbox-caption"></p><a class="lightbox-book" href="/book/#contact" data-en="Book now ↗" data-sq="Rezervo ↗">Book now ↗</a></dialog>
<script>
const dialog=document.querySelector<HTMLDialogElement>('.lightbox');
const links=Array.from(document.querySelectorAll<HTMLAnchorElement>('.gallery figure > a'));
if(dialog && links.length){
 const photo=dialog.querySelector<HTMLImageElement>('.lightbox-photo')!;
 const counter=dialog.querySelector<HTMLElement>('.lightbox-counter')!;
 const caption=dialog.querySelector<HTMLElement>('.lightbox-caption')!;
 let active=0;
 function show(index:number){active=(index+links.length)%links.length;photo.src=links[active].href;photo.alt=links[active].querySelector('img')?.alt || '';counter.textContent=(active+1)+' / '+links.length;caption.textContent=links[active].closest('figure')?.querySelector('figcaption')?.textContent || '';}
 links.forEach((link,i)=>link.addEventListener('click',event=>{if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;event.preventDefault();show(i);dialog.showModal();document.documentElement.classList.add('lightbox-open');}));
 dialog.querySelector('[data-prev]')?.addEventListener('click',()=>show(active-1));
 dialog.querySelector('[data-next]')?.addEventListener('click',()=>show(active+1));
 dialog.querySelector('[data-close]')?.addEventListener('click',()=>dialog.close());
 dialog.addEventListener('close',()=>document.documentElement.classList.remove('lightbox-open'));
 dialog.addEventListener('keydown',event=>{if(event.key==='ArrowLeft'){event.preventDefault();show(active-1)}if(event.key==='ArrowRight'){event.preventDefault();show(active+1)}});
 let startX=0;photo.addEventListener('touchstart',event=>{startX=event.changedTouches[0].clientX},{passive:true});photo.addEventListener('touchend',event=>{const delta=event.changedTouches[0].clientX-startX;if(Math.abs(delta)>70)show(active+(delta<0?1:-1))},{passive:true});
}
</script>
