---
import {
  languageFromPath,
  localizedHref
} from '../lib/i18n';


interface Props {
  source?:
    'gallery' |
    'instagram';
}


const {
  source =
    'gallery'
} = Astro.props;


const lang =
  languageFromPath(
    Astro.url.pathname
  );


const isSq =
  lang === 'sq';


const isInstagram =
  source ===
    'instagram';


const bookingHref =
  localizedHref(
    '/book/#contact',
    lang
  );


const actionEn =
  isInstagram
    ? 'View on Instagram ↗'
    : 'Book now ↗';


const actionSq =
  isInstagram
    ? 'Shiko në Instagram ↗'
    : 'Rezervo ↗';
---


<dialog
  class="lightbox"
  data-unified-lightbox
  data-media-source={source}
  aria-label={
    isInstagram
      ? (
          isSq
            ? 'Shikuesi i punëve të fundit'
            : 'Recent work viewer'
        )
      : (
          isSq
            ? 'Shikuesi i fotografive'
            : 'Photograph viewer'
        )
  }
>
  <div class="lightbox-toolbar">
    <span
      class="lightbox-counter"
      aria-live="polite"
    ></span>

    <button
      type="button"
      data-close
      aria-label={
        isSq
          ? 'Mbyll'
          : 'Close'
      }
    >
      {
        isSq
          ? 'MBYLL ×'
          : 'CLOSE ×'
      }
    </button>
  </div>


  <button
    type="button"
    class="lightbox-nav lightbox-prev"
    data-prev
    aria-label={
      isSq
        ? 'Media e mëparshme'
        : 'Previous media'
    }
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 4L7 12l8 8"/>
    </svg>
  </button>


  <button
    type="button"
    class="lightbox-nav lightbox-next"
    data-next
    aria-label={
      isSq
        ? 'Media tjetër'
        : 'Next media'
    }
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M9 4l8 8-8 8"/>
    </svg>
  </button>


  <img
    class="lightbox-photo"
    alt=""
    decoding="async"
    draggable="false"
  />


  <video
    class="lightbox-video"
    controls
    playsinline
    preload="metadata"
    hidden
  ></video>


  <p
    class="lightbox-caption"
    aria-live="polite"
  ></p>


  <a
    class="lightbox-book"
    data-media-action
    href={
      isInstagram
        ? '#'
        : bookingHref
    }
    target={
      isInstagram
        ? '_blank'
        : undefined
    }
    rel={
      isInstagram
        ? 'noopener noreferrer'
        : undefined
    }
    data-en={actionEn}
    data-sq={actionSq}
  >
    {
      isSq
        ? actionSq
        : actionEn
    }
  </a>
</dialog>


<style>
  .lightbox[data-unified-lightbox]{
    --lb-overlay-alpha:
      .985;

    background:
      rgba(
        3,
        5,
        3,
        var(--lb-overlay-alpha)
      )!important;

    opacity:
      1;

    transition:
      opacity
      200ms
      cubic-bezier(.22,1,.36,1),
      background-color
      180ms
      ease;

    overscroll-behavior:
      contain;
  }


  .lightbox[data-unified-lightbox][open]{
    animation:
      unified-lightbox-open
      220ms
      cubic-bezier(.22,1,.36,1)
      both;
  }


  .lightbox[data-unified-lightbox]::backdrop{
    background:
      rgba(
        3,
        5,
        3,
        var(--lb-overlay-alpha)
      )!important;

    animation:
      unified-backdrop-open
      220ms
      ease
      both;
  }


  .lightbox[data-unified-lightbox].is-closing{
    opacity:
      0;
  }


  .lightbox[data-unified-lightbox].is-closing::backdrop{
    background:
      rgba(
        3,
        5,
        3,
        0
      )!important;
  }


  .lightbox[data-unified-lightbox]
  .lightbox-photo,
  .lightbox[data-unified-lightbox]
  .lightbox-video{
    will-change:
      transform,
      opacity;

    backface-visibility:
      hidden;

    transform:
      translate3d(
        0,
        0,
        0
      )
      scale(1);

    opacity:
      1;

    transition:
      transform
      240ms
      cubic-bezier(.22,1,.36,1),
      opacity
      180ms
      ease;
  }


  .lightbox[data-unified-lightbox]
  .lightbox-photo{
    touch-action:
      none!important;

    user-select:
      none;

    -webkit-user-drag:
      none;
  }


  .lightbox[data-unified-lightbox].is-dragging
  .lightbox-photo{
    transition:
      none!important;

    cursor:
      grabbing;
  }


  .lightbox[data-unified-lightbox].is-switching
  .lightbox-photo,
  .lightbox[data-unified-lightbox].is-switching
  .lightbox-video{
    pointer-events:
      none;
  }


  .lightbox[data-unified-lightbox].is-dismiss-down
  .lightbox-photo,
  .lightbox[data-unified-lightbox].is-dismiss-down
  .lightbox-video{
    transform:
      translate3d(
        0,
        60px,
        0
      )
      scale(.955)!important;

    opacity:
      0!important;
  }


  .lightbox[data-unified-lightbox].is-dismiss-up
  .lightbox-photo,
  .lightbox[data-unified-lightbox].is-dismiss-up
  .lightbox-video{
    transform:
      translate3d(
        0,
        -60px,
        0
      )
      scale(.955)!important;

    opacity:
      0!important;
  }


  .lightbox[data-unified-lightbox]
  .lightbox-toolbar button,
  .lightbox[data-unified-lightbox]
  .lightbox-nav{
    min-width:
      44px;

    min-height:
      44px;

    -webkit-tap-highlight-color:
      transparent;
  }


  .lightbox[data-unified-lightbox]
  .lightbox-toolbar button:active,
  .lightbox[data-unified-lightbox]
  .lightbox-nav:active,
  .lightbox[data-unified-lightbox]
  .lightbox-book:active{
    transform:
      scale(.96);
  }


  @keyframes unified-lightbox-open{
    from{
      opacity:
        0;
    }

    to{
      opacity:
        1;
    }
  }


  @keyframes unified-backdrop-open{
    from{
      background:
        rgba(
          3,
          5,
          3,
          0
        );
    }

    to{
      background:
        rgba(
          3,
          5,
          3,
          .985
        );
    }
  }


  @media(max-width:700px){

    .lightbox[data-unified-lightbox]
    .lightbox-toolbar{
      padding-top:
        max(
          14px,
          env(
            safe-area-inset-top
          )
        );

      padding-left:
        max(
          16px,
          env(
            safe-area-inset-left
          )
        );

      padding-right:
        max(
          16px,
          env(
            safe-area-inset-right
          )
        );
    }


    .lightbox[data-unified-lightbox]
    .lightbox-book{
      bottom:
        max(
          18px,
          calc(
            env(
              safe-area-inset-bottom
            ) +
            10px
          )
        );
    }
  }


  @media(
    prefers-reduced-motion:
      reduce
  ){

    .lightbox[data-unified-lightbox],
    .lightbox[data-unified-lightbox][open],
    .lightbox[data-unified-lightbox]::backdrop,
    .lightbox[data-unified-lightbox]
    .lightbox-photo,
    .lightbox[data-unified-lightbox]
    .lightbox-video{
      animation:
        none!important;

      transition-duration:
        1ms!important;
    }
  }
</style>


<script>
  const lightbox =
    document
      .querySelector<HTMLDialogElement>(
        '.lightbox[data-unified-lightbox]'
      );


  if(
    lightbox
  ){
    const sourceMode =
      lightbox.dataset.mediaSource ===
        'instagram'
        ? 'instagram'
        : 'gallery';


    const links =
      Array.from(
        document.querySelectorAll<HTMLAnchorElement>(
          sourceMode ===
            'instagram'
            ? '.latest-card'
            : '.gallery figure > a'
        )
      );


    if(
      links.length
    ){
      const photo =
        lightbox
          .querySelector<HTMLImageElement>(
            '.lightbox-photo'
          )!;


      const video =
        lightbox
          .querySelector<HTMLVideoElement>(
            '.lightbox-video'
          )!;


      const counter =
        lightbox
          .querySelector<HTMLElement>(
            '.lightbox-counter'
          )!;


      const caption =
        lightbox
          .querySelector<HTMLElement>(
            '.lightbox-caption'
          )!;


      const action =
        lightbox
          .querySelector<HTMLAnchorElement>(
            '[data-media-action]'
          )!;


      const previousButton =
        lightbox
          .querySelector<HTMLButtonElement>(
            '[data-prev]'
          );


      const nextButton =
        lightbox
          .querySelector<HTMLButtonElement>(
            '[data-next]'
          );


      const closeButton =
        lightbox
          .querySelector<HTMLButtonElement>(
            '[data-close]'
          );


      const reduceMotion =
        window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        );


      const decodedImages =
        new Map<
          string,
          Promise<void>
        >();


      let active =
        0;


      let renderToken =
        0;


      let lastOpener:
        HTMLAnchorElement |
        null =
        null;


      let startX =
        0;


      let startY =
        0;


      let currentX =
        0;


      let currentY =
        0;


      let gestureStartedAt =
        0;


      let dragging =
        false;


      let pointerId:
        number |
        null =
        null;


      let gestureAxis:
        'x' |
        'y' |
        null =
        null;


      if(
        links.length <
        2
      ){
        if(
          previousButton
        ){
          previousButton.hidden =
            true;
        }


        if(
          nextButton
        ){
          nextButton.hidden =
            true;
        }
      }


      function normalizeIndex(
        index:
          number
      ){
        return (
          (
            index %
            links.length
          ) +
          links.length
        ) %
        links.length;
      }


      function wait(
        milliseconds:
          number
      ){
        if(
          milliseconds <=
          0
        ){
          return Promise.resolve();
        }


        return new Promise<void>(
          resolve=>{
            window.setTimeout(
              resolve,
              milliseconds
            );
          }
        );
      }


      function nextFrame(){
        return new Promise<void>(
          resolve=>{
            requestAnimationFrame(
              ()=>{
                resolve();
              }
            );
          }
        );
      }


      function prepareImage(
        source:
          string
      ){
        if(
          !source
        ){
          return Promise.resolve();
        }


        const existing =
          decodedImages.get(
            source
          );


        if(
          existing
        ){
          return existing;
        }


        const promise =
          (
            async()=>{
              const image =
                new Image();


              image.decoding =
                'async';


              image.src =
                source;


              if(
                !image.complete
              ){
                await new Promise<void>(
                  resolve=>{
                    const done =
                      ()=>{
                        resolve();
                      };


                    image.addEventListener(
                      'load',
                      done,
                      {
                        once:
                          true
                      }
                    );


                    image.addEventListener(
                      'error',
                      done,
                      {
                        once:
                          true
                      }
                    );
                  }
                );
              }


              try{
                if(
                  image.naturalWidth >
                  0
                ){
                  await image.decode();
                }
              }catch{}
            }
          )();


        decodedImages.set(
          source,
          promise
        );


        return promise;
      }


      function metadataFor(
        index:
          number
      ){
        const link =
          links[
            normalizeIndex(
              index
            )
          ];


        const sourceImage =
          link
            ?.querySelector<HTMLImageElement>(
              'img'
            );


        const isVideo =
          sourceMode ===
            'instagram' &&
          link
            ?.dataset
            .mediaType ===
            'VIDEO';


        const fullSource =
          sourceMode ===
            'gallery'
            ? (
                link
                  ?.href ||
                ''
              )
            : (
                sourceImage
                  ?.currentSrc ||
                sourceImage
                  ?.src ||
                ''
              );


        const immediateSource =
          sourceImage
            ?.currentSrc ||
          sourceImage
            ?.src ||
          fullSource;


        const figure =
          sourceMode ===
            'gallery'
            ? link
                ?.closest(
                  'figure'
                )
            : null;


        const figureCaption =
          figure
            ?.querySelector(
              'figcaption'
            )
            ?.textContent
            ?.trim() ||
          '';


        const cardCaption =
          link
            ?.dataset
            .caption ||
          '';


        return {
          link,

          sourceImage,

          isVideo,

          fullSource,

          immediateSource,

          videoSource:
            link
              ?.dataset
              .mediaUrl ||
            '',

          poster:
            link
              ?.dataset
              .poster ||
            immediateSource,

          alt:
            sourceImage
              ?.alt ||
            link
              ?.getAttribute(
                'aria-label'
              ) ||
            '',

          caption:
            sourceMode ===
              'instagram'
              ? cardCaption
              : figureCaption
        };
      }


      function stopVideo(){
        video.pause();


        video.removeAttribute(
          'src'
        );


        video.removeAttribute(
          'poster'
        );


        video.load();


        video.hidden =
          true;
      }


      function activeMedia():
        HTMLElement {

        return video.hidden
          ? photo
          : video;
      }


      function resetOverlay(){
        lightbox.style
          .removeProperty(
            '--lb-overlay-alpha'
          );
      }


      function resetMedia(){
        lightbox.classList.remove(
          'is-dragging',
          'is-dismiss-up',
          'is-dismiss-down',
          'is-switching',
          'is-closing'
        );


        photo.style.transform =
          'translate3d(0,0,0) scale(1)';


        photo.style.opacity =
          '1';


        video.style.transform =
          'translate3d(0,0,0) scale(1)';


        video.style.opacity =
          '1';


        resetOverlay();
      }


      function updateMetadata(
        index:
          number
      ){
        const metadata =
          metadataFor(
            index
          );


        photo.alt =
          metadata.alt;


        caption.textContent =
          metadata.caption;


        counter.textContent =
          `${normalizeIndex(index) + 1} / ${links.length}`;


        if(
          sourceMode ===
            'instagram' &&
          metadata.link
        ){
          action.href =
            metadata.link.href;
        }
      }


      function preloadNeighbour(
        index:
          number
      ){
        const metadata =
          metadataFor(
            index
          );


        if(
          metadata.isVideo ||
          !metadata.fullSource
        ){
          return;
        }


        void prepareImage(
          metadata.fullSource
        );
      }


      async function show(
        index:
          number,

        direction:
          'next' |
          'prev' |
          'direct' =
          'direct'
      ){
        const target =
          normalizeIndex(
            index
          );


        const metadata =
          metadataFor(
            target
          );


        if(
          !metadata.link
        ){
          return;
        }


        const token =
          ++renderToken;


        lightbox.setAttribute(
          'aria-busy',
          'true'
        );


        /*
         * Decode the next photograph before
         * removing the one currently visible.
         */
        if(
          !metadata.isVideo &&
          metadata.fullSource
        ){
          await prepareImage(
            metadata.fullSource
          );
        }


        if(
          token !==
          renderToken ||
          !lightbox.open
        ){
          return;
        }


        const previousMedia =
          activeMedia();


        if(
          direction !==
          'direct' &&
          !reduceMotion.matches
        ){
          previousMedia.style.opacity =
            '0';


          previousMedia.style.transform =
            direction ===
              'next'
              ? 'translate3d(-22px,0,0) scale(.988)'
              : 'translate3d(22px,0,0) scale(.988)';


          await wait(
            105
          );
        }


        if(
          token !==
          renderToken ||
          !lightbox.open
        ){
          return;
        }


        active =
          target;


        updateMetadata(
          target
        );


        stopVideo();


        if(
          metadata.isVideo &&
          metadata.videoSource
        ){
          photo.hidden =
            true;


          video.hidden =
            false;


          video.poster =
            metadata.poster;


          video.src =
            metadata.videoSource;


          video.currentTime =
            0;


          video.style.transition =
            'none';


          video.style.opacity =
            '0';


          video.style.transform =
            direction ===
              'prev'
              ? 'translate3d(-20px,0,0) scale(.988)'
              : 'translate3d(20px,0,0) scale(.988)';


          video.load();


          await nextFrame();


          video.style.transition =
            '';


          await nextFrame();


          video.style.opacity =
            '1';


          video.style.transform =
            'translate3d(0,0,0) scale(1)';


          void video
            .play()
            .catch(
              ()=>{}
            );

        }else{
          video.hidden =
            true;


          photo.hidden =
            false;


          photo.style.transition =
            'none';


          photo.style.opacity =
            '0';


          photo.style.transform =
            direction ===
              'prev'
              ? 'translate3d(-20px,0,0) scale(.988)'
              : 'translate3d(20px,0,0) scale(.988)';


          photo.src =
            metadata.fullSource ||
            metadata.immediateSource;


          await nextFrame();


          photo.style.transition =
            '';


          await nextFrame();


          photo.style.opacity =
            '1';


          photo.style.transform =
            'translate3d(0,0,0) scale(1)';
        }


        lightbox.classList.remove(
          'is-switching'
        );


        lightbox.removeAttribute(
          'aria-busy'
        );


        preloadNeighbour(
          target +
          1
        );


        preloadNeighbour(
          target -
          1
        );
      }


      function openLightbox(
        index:
          number,

        opener:
          HTMLAnchorElement
      ){
        const target =
          normalizeIndex(
            index
          );


        const metadata =
          metadataFor(
            target
          );


        active =
          target;


        lastOpener =
          opener;


        renderToken +=
          1;


        resetMedia();


        updateMetadata(
          target
        );


        /*
         * Immediate thumbnail first,
         * decoded large image second.
         */
        if(
          !metadata.isVideo &&
          metadata.immediateSource
        ){
          photo.hidden =
            false;


          video.hidden =
            true;


          photo.src =
            metadata.immediateSource;

        }else if(
          metadata.isVideo
        ){
          photo.hidden =
            true;


          video.hidden =
            false;


          if(
            metadata.poster
          ){
            video.poster =
              metadata.poster;
          }
        }


        if(
          !lightbox.open
        ){
          lightbox.showModal();
        }


        document
          .documentElement
          .classList
          .add(
            'lightbox-open'
          );


        void show(
          target,
          'direct'
        );


        window.setTimeout(
          ()=>{
            closeButton
              ?.focus({
                preventScroll:
                  true
              });
          },
          0
        );
      }


      async function closeLightbox(
        direction:
          'up' |
          'down' |
          'fade' =
          'fade'
      ){
        if(
          !lightbox.open ||
          lightbox.classList.contains(
            'is-closing'
          )
        ){
          return;
        }


        renderToken +=
          1;


        lightbox.removeAttribute(
          'aria-busy'
        );


        lightbox.classList.remove(
          'is-dragging',
          'is-switching'
        );


        if(
          direction ===
            'up'
        ){
          lightbox.classList.add(
            'is-dismiss-up'
          );
        }


        if(
          direction ===
            'down'
        ){
          lightbox.classList.add(
            'is-dismiss-down'
          );
        }


        lightbox.classList.add(
          'is-closing'
        );


        await wait(
          reduceMotion.matches
            ? 0
            : 200
        );


        if(
          lightbox.open
        ){
          lightbox.close();
        }
      }


      function snapBack(){
        dragging =
          false;


        pointerId =
          null;


        gestureAxis =
          null;


        currentX =
          0;


        currentY =
          0;


        lightbox.classList.remove(
          'is-dragging'
        );


        photo.style.transform =
          'translate3d(0,0,0) scale(1)';


        photo.style.opacity =
          '1';


        resetOverlay();
      }


      links
        .forEach(
          (
            link,
            index
          )=>{
            link.addEventListener(
              'click',
              event=>{
                if(
                  event.ctrlKey ||
                  event.metaKey ||
                  event.shiftKey ||
                  event.altKey
                ){
                  return;
                }


                event.preventDefault();


                openLightbox(
                  index,
                  link
                );
              }
            );
          }
        );


      previousButton
        ?.addEventListener(
          'click',
          event=>{
            event.stopPropagation();


            void show(
              active -
                1,
              'prev'
            );
          }
        );


      nextButton
        ?.addEventListener(
          'click',
          event=>{
            event.stopPropagation();


            void show(
              active +
                1,
              'next'
            );
          }
        );


      closeButton
        ?.addEventListener(
          'click',
          event=>{
            event.stopPropagation();


            void closeLightbox(
              'fade'
            );
          }
        );


      lightbox.addEventListener(
        'click',
        event=>{
          if(
            event.target ===
            lightbox
          ){
            void closeLightbox(
              'fade'
            );
          }
        }
      );


      lightbox.addEventListener(
        'cancel',
        event=>{
          event.preventDefault();


          void closeLightbox(
            'fade'
          );
        }
      );


      lightbox.addEventListener(
        'keydown',
        event=>{
          if(
            event.key ===
            'ArrowLeft'
          ){
            event.preventDefault();


            void show(
              active -
                1,
              'prev'
            );
          }


          if(
            event.key ===
            'ArrowRight'
          ){
            event.preventDefault();


            void show(
              active +
                1,
              'next'
            );
          }
        }
      );


      lightbox.addEventListener(
        'close',
        ()=>{
          document
            .documentElement
            .classList
            .remove(
              'lightbox-open'
            );


          lightbox.removeAttribute(
            'aria-busy'
          );


          stopVideo();


          lightbox.classList.remove(
            'is-closing',
            'is-dismiss-up',
            'is-dismiss-down',
            'is-dragging',
            'is-switching'
          );


          photo.removeAttribute(
            'src'
          );


          resetMedia();


          const opener =
            lastOpener;


          lastOpener =
            null;


          if(
            opener
          ){
            requestAnimationFrame(
              ()=>{
                opener.focus({
                  preventScroll:
                    true
                });
              }
            );
          }
        }
      );


      photo.addEventListener(
        'pointerdown',
        event=>{
          if(
            lightbox.classList.contains(
              'is-switching'
            )
          ){
            return;
          }


          if(
            event.pointerType ===
              'mouse' &&
            event.button !==
              0
          ){
            return;
          }


          pointerId =
            event.pointerId;


          startX =
            event.clientX;


          startY =
            event.clientY;


          currentX =
            0;


          currentY =
            0;


          gestureAxis =
            null;


          gestureStartedAt =
            performance.now();


          dragging =
            true;


          lightbox.classList.add(
            'is-dragging'
          );


          photo
            .setPointerCapture?.(
              event.pointerId
            );
        }
      );


      photo.addEventListener(
        'pointermove',
        event=>{
          if(
            !dragging ||
            pointerId !==
              event.pointerId
          ){
            return;
          }


          const rawX =
            event.clientX -
            startX;


          const rawY =
            event.clientY -
            startY;


          const absX =
            Math.abs(
              rawX
            );


          const absY =
            Math.abs(
              rawY
            );


          if(
            !gestureAxis &&
            Math.max(
              absX,
              absY
            ) >
              10
          ){
            gestureAxis =
              absX >
              absY
                ? 'x'
                : 'y';
          }


          if(
            gestureAxis ===
              'x'
          ){
            currentX =
              rawX;


            currentY =
              0;


            const distance =
              Math.abs(
                currentX
              );


            const scale =
              Math.max(
                .975,
                1 -
                distance /
                4200
              );


            photo.style.transform =
              `translate3d(${currentX}px,0,0) scale(${scale})`;


            photo.style.opacity =
              String(
                Math.max(
                  .58,
                  1 -
                  distance /
                  900
                )
              );


            return;
          }


          if(
            gestureAxis ===
              'y'
          ){
            currentX =
              0;


            currentY =
              rawY;


            const distance =
              Math.abs(
                currentY
              );


            const scale =
              Math.max(
                .94,
                1 -
                distance /
                2300
              );


            const overlayAlpha =
              Math.max(
                .34,
                .985 -
                distance /
                650
              );


            photo.style.transform =
              `translate3d(0,${currentY}px,0) scale(${scale})`;


            photo.style.opacity =
              String(
                Math.max(
                  .45,
                  1 -
                  distance /
                  760
                )
              );


            lightbox.style
              .setProperty(
                '--lb-overlay-alpha',
                String(
                  overlayAlpha
                )
              );
          }
        }
      );


      function finishGesture(
        event:
          PointerEvent
      ){
        if(
          !dragging ||
          pointerId !==
            event.pointerId
        ){
          return;
        }


        const duration =
          Math.max(
            1,
            performance.now() -
            gestureStartedAt
          );


        const velocityX =
          currentX /
          duration;


        const velocityY =
          currentY /
          duration;


        const absX =
          Math.abs(
            currentX
          );


        const absY =
          Math.abs(
            currentY
          );


        dragging =
          false;


        pointerId =
          null;


        lightbox.classList.remove(
          'is-dragging'
        );


        if(
          gestureAxis ===
            'y' &&
          (
            absY >
              88 ||
            Math.abs(
              velocityY
            ) >
              .72
          )
        ){
          void closeLightbox(
            currentY <
              0
              ? 'up'
              : 'down'
          );


          return;
        }


        if(
          gestureAxis ===
            'x' &&
          links.length >
            1 &&
          (
            absX >
              64 ||
            Math.abs(
              velocityX
            ) >
              .62
          )
        ){
          const goingNext =
            currentX <
            0;


          currentX =
            0;


          currentY =
            0;


          gestureAxis =
            null;


          resetOverlay();


          void show(
            active +
              (
                goingNext
                  ? 1
                  : -1
              ),
            goingNext
              ? 'next'
              : 'prev'
          );


          return;
        }


        snapBack();
      }


      photo.addEventListener(
        'pointerup',
        finishGesture
      );


      photo.addEventListener(
        'pointercancel',
        event=>{
          if(
            !dragging ||
            pointerId !==
              event.pointerId
          ){
            return;
          }


          snapBack();
        }
      );
    }
  }
</script>
