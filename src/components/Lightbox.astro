---
import {
  languageFromPath,
  localizedHref
} from '../lib/i18n';


const lang =
  languageFromPath(
    Astro.url.pathname
  );


const isSq =
  lang === 'sq';


const bookingHref =
  localizedHref(
    '/book/#contact',
    lang
  );
---


<dialog
  class="lightbox"
  data-gallery-lightbox
  aria-label={
    isSq
      ? 'Shikuesi i fotografive'
      : 'Photograph viewer'
  }
>
  <div class="lightbox-toolbar">
    <span
      class="lightbox-counter"
      aria-live="polite"
    ></span>

    <button
      type="button"
      data-close
      aria-label={
        isSq
          ? 'Mbyll shikuesin e fotografive'
          : 'Close photograph viewer'
      }
    >
      {
        isSq
          ? 'MBYLL ×'
          : 'CLOSE ×'
      }
    </button>
  </div>


  <button
    type="button"
    class="lightbox-nav lightbox-prev"
    data-prev
    aria-label={
      isSq
        ? 'Fotografia e mëparshme'
        : 'Previous photograph'
    }
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M15 4L7 12l8 8"/>
    </svg>
  </button>


  <button
    type="button"
    class="lightbox-nav lightbox-next"
    data-next
    aria-label={
      isSq
        ? 'Fotografia tjetër'
        : 'Next photograph'
    }
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M9 4l8 8-8 8"/>
    </svg>
  </button>


  <img
    class="lightbox-photo"
    alt=""
    decoding="async"
    draggable="false"
  />


  <p
    class="lightbox-caption"
    aria-live="polite"
  ></p>


  <a
    class="lightbox-book"
    href={bookingHref}
    data-en="Book now ↗"
    data-sq="Rezervo ↗"
  >
    {
      isSq
        ? 'Rezervo ↗'
        : 'Book now ↗'
    }
  </a>
</dialog>


<style>
  .lightbox[data-gallery-lightbox]{
    --lb-overlay-alpha:
      .985;

    background:
      rgba(
        3,
        5,
        3,
        var(--lb-overlay-alpha)
      )!important;

    opacity:
      1;

    transition:
      opacity
      200ms
      cubic-bezier(
        .22,
        1,
        .36,
        1
      ),
      background-color
      180ms
      ease;

    overscroll-behavior:
      contain;
  }


  .lightbox[data-gallery-lightbox][open]{
    animation:
      gallery-lightbox-open
      220ms
      cubic-bezier(
        .22,
        1,
        .36,
        1
      )
      both;
  }


  .lightbox[data-gallery-lightbox]::backdrop{
    background:
      rgba(
        3,
        5,
        3,
        var(--lb-overlay-alpha)
      )!important;

    transition:
      background-color
      180ms
      ease;

    animation:
      gallery-backdrop-open
      220ms
      ease
      both;
  }


  .lightbox[data-gallery-lightbox].is-closing{
    animation:
      none!important;

    opacity:
      0;
  }


  .lightbox[data-gallery-lightbox].is-closing::backdrop{
    background:
      rgba(
        3,
        5,
        3,
        0
      )!important;
  }


  .lightbox[data-gallery-lightbox] .lightbox-photo{
    will-change:
      transform,
      opacity;

    backface-visibility:
      hidden;

    transform:
      translate3d(
        0,
        0,
        0
      )
      scale(1);

    opacity:
      1;

    touch-action:
      none!important;

    user-select:
      none;

    -webkit-user-drag:
      none;

    transition:
      transform
      240ms
      cubic-bezier(
        .22,
        1,
        .36,
        1
      ),
      opacity
      180ms
      ease;
  }


  .lightbox[data-gallery-lightbox].is-dragging
  .lightbox-photo{
    transition:
      none!important;

    cursor:
      grabbing;
  }


  .lightbox[data-gallery-lightbox].is-switching
  .lightbox-photo{
    pointer-events:
      none;
  }


  .lightbox[data-gallery-lightbox].is-dismiss-down
  .lightbox-photo{
    transform:
      translate3d(
        0,
        56px,
        0
      )
      scale(.965)!important;

    opacity:
      0!important;
  }


  .lightbox[data-gallery-lightbox].is-dismiss-up
  .lightbox-photo{
    transform:
      translate3d(
        0,
        -56px,
        0
      )
      scale(.965)!important;

    opacity:
      0!important;
  }


  .lightbox[data-gallery-lightbox]
  .lightbox-toolbar button,
  .lightbox[data-gallery-lightbox]
  .lightbox-nav{
    min-width:
      44px;

    min-height:
      44px;

    -webkit-tap-highlight-color:
      transparent;
  }


  .lightbox[data-gallery-lightbox]
  .lightbox-toolbar button:active,
  .lightbox[data-gallery-lightbox]
  .lightbox-nav:active,
  .lightbox[data-gallery-lightbox]
  .lightbox-book:active{
    transform:
      scale(.96);
  }


  .lightbox[data-gallery-lightbox].has-load-error
  .lightbox-caption{
    opacity:
      .9;
  }


  @keyframes gallery-lightbox-open{
    from{
      opacity:
        0;
    }

    to{
      opacity:
        1;
    }
  }


  @keyframes gallery-backdrop-open{
    from{
      background:
        rgba(
          3,
          5,
          3,
          0
        );
    }

    to{
      background:
        rgba(
          3,
          5,
          3,
          .985
        );
    }
  }


  @media(max-width:700px){

    .lightbox[data-gallery-lightbox]
    .lightbox-toolbar{
      padding-top:
        max(
          14px,
          env(
            safe-area-inset-top
          )
        );

      padding-left:
        max(
          16px,
          env(
            safe-area-inset-left
          )
        );

      padding-right:
        max(
          16px,
          env(
            safe-area-inset-right
          )
        );
    }


    .lightbox[data-gallery-lightbox]
    .lightbox-book{
      bottom:
        max(
          18px,
          calc(
            env(
              safe-area-inset-bottom
            ) +
            10px
          )
        );
    }
  }


  @media(
    prefers-reduced-motion:
      reduce
  ){

    .lightbox[data-gallery-lightbox],
    .lightbox[data-gallery-lightbox][open],
    .lightbox[data-gallery-lightbox]::backdrop,
    .lightbox[data-gallery-lightbox]
    .lightbox-photo{
      animation:
        none!important;

      transition-duration:
        1ms!important;
    }
  }
</style>


<script>
  const dialog =
    document
      .querySelector<HTMLDialogElement>(
        '.lightbox[data-gallery-lightbox]'
      );


  const links =
    Array.from(
      document
        .querySelectorAll<HTMLAnchorElement>(
          '.gallery figure > a'
        )
    );


  if (
    dialog &&
    links.length
  ) {
    const lightbox =
      dialog;


    const photo =
      lightbox
        .querySelector<HTMLImageElement>(
          '.lightbox-photo'
        )!;


    const counter =
      lightbox
        .querySelector<HTMLElement>(
          '.lightbox-counter'
        )!;


    const caption =
      lightbox
        .querySelector<HTMLElement>(
          '.lightbox-caption'
        )!;


    const previousButton =
      lightbox
        .querySelector<HTMLButtonElement>(
          '[data-prev]'
        );


    const nextButton =
      lightbox
        .querySelector<HTMLButtonElement>(
          '[data-next]'
        );


    const closeButton =
      lightbox
        .querySelector<HTMLButtonElement>(
          '[data-close]'
        );


    const reduceMotion =
      window
        .matchMedia(
          '(prefers-reduced-motion: reduce)'
        );


    const decodedImages =
      new Map<
        string,
        Promise<void>
      >();


    let active =
      0;


    let renderToken =
      0;


    let lastOpener:
      HTMLAnchorElement |
      null =
      null;


    let startX =
      0;


    let startY =
      0;


    let currentX =
      0;


    let currentY =
      0;


    let gestureStartedAt =
      0;


    let dragging =
      false;


    let pointerId:
      number |
      null =
      null;


    let gestureAxis:
      'x' |
      'y' |
      null =
      null;


    if (
      links.length <
      2
    ) {
      if (
        previousButton
      ) {
        previousButton.hidden =
          true;
      }

      if (
        nextButton
      ) {
        nextButton.hidden =
          true;
      }
    }


    function normalizeIndex(
      index:
        number
    ) {
      return (
        (
          index %
          links.length
        ) +
        links.length
      ) %
      links.length;
    }


    function wait(
      milliseconds:
        number
    ) {
      if (
        milliseconds <=
        0
      ) {
        return Promise.resolve();
      }

      return new Promise<void>(
        resolve => {
          window.setTimeout(
            resolve,
            milliseconds
          );
        }
      );
    }


    function frame() {
      return new Promise<void>(
        resolve => {
          requestAnimationFrame(
            () => {
              resolve();
            }
          );
        }
      );
    }


    /*
     * Load and decode the real full-size image before
     * replacing the photograph currently on screen.
     *
     * This prevents the blank flash between photographs.
     */
    function prepareImage(
      source:
        string
    ) {
      const existing =
        decodedImages.get(
          source
        );

      if (
        existing
      ) {
        return existing;
      }


      const promise =
        new Promise<void>(
          async (
            resolve,
            reject
          ) => {
            const image =
              new Image();


            image.decoding =
              'async';


            image.src =
              source;


            try {
              if (
                typeof image.decode ===
                'function'
              ) {
                await image.decode();

              } else {
                await new Promise<void>(
                  (
                    loaded,
                    failed
                  ) => {
                    if (
                      image.complete
                    ) {
                      if (
                        image.naturalWidth >
                        0
                      ) {
                        loaded();

                      } else {
                        failed(
                          new Error(
                            'Image failed to load.'
                          )
                        );
                      }

                      return;
                    }


                    image.addEventListener(
                      'load',
                      () => {
                        loaded();
                      },
                      {
                        once:
                          true
                      }
                    );


                    image.addEventListener(
                      'error',
                      () => {
                        failed(
                          new Error(
                            'Image failed to load.'
                          )
                        );
                      },
                      {
                        once:
                          true
                      }
                    );
                  }
                );
              }


              if (
                image.naturalWidth <=
                0
              ) {
                throw new Error(
                  'Image failed to decode.'
                );
              }


              resolve();

            } catch (
              error
            ) {
              reject(
                error
              );
            }
          }
        );


      decodedImages.set(
        source,
        promise
      );


      promise.catch(
        () => {
          decodedImages.delete(
            source
          );
        }
      );


      return promise;
    }


    function preload(
      index:
        number
    ) {
      const normalized =
        normalizeIndex(
          index
        );


      const source =
        links[
          normalized
        ]?.href;


      if (
        !source
      ) {
        return;
      }


      void prepareImage(
        source
      ).catch(
        () => {
          /*
           * Preloading is opportunistic.
           * A failed neighbour must not affect
           * the photograph currently displayed.
           */
        }
      );
    }


    function metadataFor(
      index:
        number
    ) {
      const link =
        links[
          normalizeIndex(
            index
          )
        ];


      const sourceImage =
        link
          ?.querySelector<HTMLImageElement>(
            'img'
          );


      const figure =
        link
          ?.closest(
            'figure'
          );


      const figureCaption =
        figure
          ?.querySelector(
            'figcaption'
          )
          ?.textContent
          ?.trim() ||
        '';


      return {
        link,

        sourceImage,

        alt:
          sourceImage
            ?.alt ||
          '',

        caption:
          figureCaption
      };
    }


    function updateMetadata(
      index:
        number
    ) {
      const metadata =
        metadataFor(
          index
        );


      photo.alt =
        metadata.alt;


      counter.textContent =
        `${normalizeIndex(index) + 1} / ${links.length}`;


      caption.textContent =
        metadata.caption;


      lightbox.classList.remove(
        'has-load-error'
      );
    }


    function resetOverlay() {
      lightbox.style
        .removeProperty(
          '--lb-overlay-alpha'
        );
    }


    function resetPhoto() {
      lightbox.classList.remove(
        'is-dragging',
        'is-dismiss-up',
        'is-dismiss-down',
        'is-switching',
        'is-closing',
        'has-load-error'
      );


      photo.style.transform =
        'translate3d(0,0,0) scale(1)';


      photo.style.opacity =
        '1';


      resetOverlay();
    }


    function showLoadError() {
      lightbox.classList.add(
        'has-load-error'
      );


      caption.textContent =
        document
          .documentElement
          .lang ===
          'sq'
          ? 'Fotografia nuk u ngarkua. Provo përsëri.'
          : 'The photograph could not be loaded. Try again.';
    }


    /*
     * Replace the current photograph only after
     * the next full-size image has decoded.
     */
    async function show(
      index:
        number,

      direction:
        'next' |
        'prev' |
        'direct' =
        'direct'
    ) {
      const target =
        normalizeIndex(
          index
        );


      active =
        target;


      const metadata =
        metadataFor(
          target
        );


      if (
        !metadata.link
      ) {
        return;
      }


      const source =
        metadata.link.href;


      const token =
        ++renderToken;


      lightbox.setAttribute(
        'aria-busy',
        'true'
      );


      try {
        await prepareImage(
          source
        );

      } catch {
        if (
          token !==
          renderToken
        ) {
          return;
        }


        lightbox.removeAttribute(
          'aria-busy'
        );


        showLoadError();

        return;
      }


      if (
        token !==
        renderToken ||
        !lightbox.open
      ) {
        return;
      }


      const transitionTime =
        reduceMotion.matches
          ? 0
          : 105;


      lightbox.classList.add(
        'is-switching'
      );


      if (
        direction !==
        'direct'
      ) {
        photo.style.transform =
          direction ===
          'next'
            ? 'translate3d(-20px,0,0) scale(.992)'
            : 'translate3d(20px,0,0) scale(.992)';


        photo.style.opacity =
          '0';


        await wait(
          transitionTime
        );


        if (
          token !==
          renderToken ||
          !lightbox.open
        ) {
          return;
        }
      }


      updateMetadata(
        target
      );


      if (
        direction ===
        'next'
      ) {
        photo.style.transition =
          'none';

        photo.style.transform =
          'translate3d(20px,0,0) scale(.992)';

        photo.style.opacity =
          '0';

      } else if (
        direction ===
        'prev'
      ) {
        photo.style.transition =
          'none';

        photo.style.transform =
          'translate3d(-20px,0,0) scale(.992)';

        photo.style.opacity =
          '0';

      } else {
        photo.style.transition =
          'none';

        photo.style.opacity =
          '.86';
      }


      photo.src =
        source;


      await frame();


      if (
        token !==
        renderToken ||
        !lightbox.open
      ) {
        return;
      }


      photo.style.transition =
        '';


      await frame();


      photo.style.transform =
        'translate3d(0,0,0) scale(1)';


      photo.style.opacity =
        '1';


      lightbox.classList.remove(
        'is-switching'
      );


      lightbox.removeAttribute(
        'aria-busy'
      );


      preload(
        target + 1
      );


      preload(
        target - 1
      );
    }


    function openLightbox(
      index:
        number,

      opener:
        HTMLAnchorElement
    ) {
      const target =
        normalizeIndex(
          index
        );


      active =
        target;


      lastOpener =
        opener;


      renderToken +=
        1;


      resetPhoto();


      updateMetadata(
        target
      );


      const metadata =
        metadataFor(
          target
        );


      /*
       * Use the already-visible thumbnail immediately,
       * then replace it with the decoded full-size file.
       */
      const immediateSource =
        metadata.sourceImage
          ?.currentSrc ||
        metadata.sourceImage
          ?.src ||
        metadata.link
          ?.href;


      if (
        immediateSource
      ) {
        photo.src =
          immediateSource;
      }


      if (
        !lightbox.open
      ) {
        lightbox.showModal();
      }


      document
        .documentElement
        .classList
        .add(
          'lightbox-open'
        );


      void show(
        target,
        'direct'
      );


      window.setTimeout(
        () => {
          closeButton
            ?.focus({
              preventScroll:
                true
            });
        },
        0
      );
    }


    async function closeLightbox(
      direction:
        'up' |
        'down' |
        'fade' =
        'fade'
    ) {
      if (
        !lightbox.open ||
        lightbox.classList.contains(
          'is-closing'
        )
      ) {
        return;
      }


      renderToken +=
        1;


      lightbox.removeAttribute(
        'aria-busy'
      );


      lightbox.classList.remove(
        'is-dragging',
        'is-switching'
      );


      if (
        direction ===
        'up'
      ) {
        lightbox.classList.add(
          'is-dismiss-up'
        );
      }


      if (
        direction ===
        'down'
      ) {
        lightbox.classList.add(
          'is-dismiss-down'
        );
      }


      lightbox.classList.add(
        'is-closing'
      );


      await wait(
        reduceMotion.matches
          ? 0
          : 200
      );


      if (
        lightbox.open
      ) {
        lightbox.close();
      }
    }


    function snapBack() {
      dragging =
        false;


      pointerId =
        null;


      gestureAxis =
        null;


      currentX =
        0;


      currentY =
        0;


      lightbox.classList.remove(
        'is-dragging'
      );


      photo.style.transform =
        'translate3d(0,0,0) scale(1)';


      photo.style.opacity =
        '1';


      resetOverlay();
    }


    links.forEach(
      (
        link,
        index
      ) => {
        link.addEventListener(
          'click',
          event => {

            if (
              event.ctrlKey ||
              event.metaKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return;
            }


            event.preventDefault();


            openLightbox(
              index,
              link
            );
          }
        );
      }
    );


    previousButton
      ?.addEventListener(
        'click',
        event => {

          event.stopPropagation();


          void show(
            active - 1,
            'prev'
          );
        }
      );


    nextButton
      ?.addEventListener(
        'click',
        event => {

          event.stopPropagation();


          void show(
            active + 1,
            'next'
          );
        }
      );


    closeButton
      ?.addEventListener(
        'click',
        event => {

          event.stopPropagation();


          void closeLightbox(
            'fade'
          );
        }
      );


    /*
     * Click on empty backdrop / stage closes the viewer.
     */
    lightbox.addEventListener(
      'click',
      event => {

        if (
          event.target ===
          lightbox
        ) {
          void closeLightbox(
            'fade'
          );
        }
      }
    );


    /*
     * Native dialog Escape would close immediately.
     * Prevent that so our closing transition can finish.
     */
    lightbox.addEventListener(
      'cancel',
      event => {

        event.preventDefault();


        void closeLightbox(
          'fade'
        );
      }
    );


    lightbox.addEventListener(
      'keydown',
      event => {

        if (
          event.key ===
          'ArrowLeft'
        ) {
          event.preventDefault();


          void show(
            active - 1,
            'prev'
          );
        }


        if (
          event.key ===
          'ArrowRight'
        ) {
          event.preventDefault();


          void show(
            active + 1,
            'next'
          );
        }
      }
    );


    lightbox.addEventListener(
      'close',
      () => {

        document
          .documentElement
          .classList
          .remove(
            'lightbox-open'
          );


        lightbox.removeAttribute(
          'aria-busy'
        );


        lightbox.classList.remove(
          'is-closing',
          'is-dismiss-up',
          'is-dismiss-down',
          'is-dragging',
          'is-switching',
          'has-load-error'
        );


        photo.removeAttribute(
          'src'
        );


        photo.style.transition =
          '';


        resetPhoto();


        const opener =
          lastOpener;


        lastOpener =
          null;


        if (
          opener
        ) {
          requestAnimationFrame(
            () => {
              opener.focus({
                preventScroll:
                  true
              });
            }
          );
        }
      }
    );


    photo.addEventListener(
      'pointerdown',
      event => {

        if (
          lightbox.classList.contains(
            'is-switching'
          )
        ) {
          return;
        }


        if (
          event.pointerType ===
            'mouse' &&
          event.button !==
            0
        ) {
          return;
        }


        pointerId =
          event.pointerId;


        startX =
          event.clientX;


        startY =
          event.clientY;


        currentX =
          0;


        currentY =
          0;


        gestureAxis =
          null;


        gestureStartedAt =
          performance.now();


        dragging =
          true;


        lightbox.classList.add(
          'is-dragging'
        );


        photo
          .setPointerCapture?.(
            event.pointerId
          );
      }
    );


    photo.addEventListener(
      'pointermove',
      event => {

        if (
          !dragging ||
          pointerId !==
            event.pointerId
        ) {
          return;
        }


        const rawX =
          event.clientX -
          startX;


        const rawY =
          event.clientY -
          startY;


        const absRawX =
          Math.abs(
            rawX
          );


        const absRawY =
          Math.abs(
            rawY
          );


        if (
          !gestureAxis &&
          Math.max(
            absRawX,
            absRawY
          ) >
            10
        ) {
          gestureAxis =
            absRawX >
            absRawY
              ? 'x'
              : 'y';
        }


        if (
          gestureAxis ===
          'x'
        ) {
          currentX =
            rawX;


          currentY =
            0;


          const distance =
            Math.abs(
              currentX
            );


          const scale =
            Math.max(
              .975,
              1 -
                distance /
                  4200
            );


          const opacity =
            Math.max(
              .55,
              1 -
                distance /
                  900
            );


          photo.style.transform =
            `translate3d(${currentX}px,0,0) scale(${scale})`;


          photo.style.opacity =
            String(
              opacity
            );


          return;
        }


        if (
          gestureAxis ===
          'y'
        ) {
          currentX =
            0;


          currentY =
            rawY;


          const distance =
            Math.abs(
              currentY
            );


          const scale =
            Math.max(
              .94,
              1 -
                distance /
                  2300
            );


          const opacity =
            Math.max(
              .45,
              1 -
                distance /
                  760
            );


          const overlayAlpha =
            Math.max(
              .36,
              .985 -
                distance /
                  650
            );


          photo.style.transform =
            `translate3d(0,${currentY}px,0) scale(${scale})`;


          photo.style.opacity =
            String(
              opacity
            );


          lightbox.style
            .setProperty(
              '--lb-overlay-alpha',
              String(
                overlayAlpha
              )
            );
        }
      }
    );


    function finishGesture(
      event:
        PointerEvent
    ) {
      if (
        !dragging ||
        pointerId !==
          event.pointerId
      ) {
        return;
      }


      const duration =
        Math.max(
          1,
          performance.now() -
            gestureStartedAt
        );


      const velocityX =
        currentX /
        duration;


      const velocityY =
        currentY /
        duration;


      const absX =
        Math.abs(
          currentX
        );


      const absY =
        Math.abs(
          currentY
        );


      dragging =
        false;


      pointerId =
        null;


      lightbox.classList.remove(
        'is-dragging'
      );


      /*
       * Vertical dismiss:
       * distance OR velocity can complete the gesture.
       */
      if (
        gestureAxis ===
          'y' &&
        (
          absY >
            88 ||
          Math.abs(
            velocityY
          ) >
            .72
        )
      ) {
        void closeLightbox(
          currentY <
            0
            ? 'up'
            : 'down'
        );

        return;
      }


      /*
       * Horizontal navigation:
       * also velocity-aware for quick flicks.
       */
      if (
        gestureAxis ===
          'x' &&
        links.length >
          1 &&
        (
          absX >
            64 ||
          Math.abs(
            velocityX
          ) >
            .62
        )
      ) {
        const goingNext =
          currentX <
          0;


        currentX =
          0;


        currentY =
          0;


        gestureAxis =
          null;


        resetOverlay();


        void show(
          active +
            (
              goingNext
                ? 1
                : -1
            ),
          goingNext
            ? 'next'
            : 'prev'
        );

        return;
      }


      snapBack();
    }


    photo.addEventListener(
      'pointerup',
      finishGesture
    );


    photo.addEventListener(
      'pointercancel',
      event => {

        if (
          !dragging ||
          pointerId !==
            event.pointerId
        ) {
          return;
        }


        snapBack();
      }
    );
  }
</script>
