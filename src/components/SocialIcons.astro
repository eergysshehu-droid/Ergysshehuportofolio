---
import {defaults} from '../lib/editorial';
import {safeUrl} from '../lib/content';
interface Props {class?: string}
const {class: className = ''} = Astro.props;
---
<div class:list={['social-icons', className]}>
  {safeUrl(defaults.instagram) && <a href={safeUrl(defaults.instagram)} target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="1"/></svg></a>}
  {safeUrl(defaults.youtube) && <a href={safeUrl(defaults.youtube)} target="_blank" rel="noopener noreferrer" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10.5 9.2l5 2.8-5 2.8z" fill="currentColor" stroke="none"/></svg></a>}
  {safeUrl(defaults.linkedin) && <a href={safeUrl(defaults.linkedin)} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5v6M8 7.8v.01M12.2 16.5v-3.6c0-1.3.9-2.2 2-2.2s1.8.9 1.8 2.2v3.6" stroke-linecap="round"/></svg></a>}
  {safeUrl(defaults.facebook) && <a href={safeUrl(defaults.facebook)} target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><text x="12" y="16.2" text-anchor="middle" font-family="Georgia,'Playfair Display',serif" font-weight="700" font-size="12" fill="currentColor" stroke="none">f</text></svg></a>}
</div>
