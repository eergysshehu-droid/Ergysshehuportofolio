---
import {defaults} from '../lib/editorial';
import {safeUrl} from '../lib/content';
interface Props {class?: string}
const {class: className = ''} = Astro.props;
---
<div class:list={['social-icons', className]}>
  {safeUrl(defaults.instagram) && <a href={safeUrl(defaults.instagram)} target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2.8" y="2.8" width="18.4" height="18.4" rx="5.5"/><circle cx="12" cy="12" r="4.6"/><circle cx="17.4" cy="6.6" r="1.15" fill="currentColor" stroke="none"/></svg></a>}
  {safeUrl(defaults.youtube) && <a href={safeUrl(defaults.youtube)} target="_blank" rel="noopener noreferrer" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2.2" y="5.2" width="19.6" height="13.6" rx="4.2"/><path d="M10.3 9v6l5.2-3z" fill="currentColor" stroke="none"/></svg></a>}
  {safeUrl(defaults.linkedin) && <a href={safeUrl(defaults.linkedin)} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="2.8" y="2.8" width="18.4" height="18.4" rx="5"/><text x="12" y="16" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="11.5" fill="currentColor" stroke="none">in</text></svg></a>}
  {safeUrl(defaults.facebook) && <a href={safeUrl(defaults.facebook)} target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="9.2"/><text x="12" y="16.2" text-anchor="middle" font-family="Georgia,'Playfair Display',serif" font-weight="700" font-size="12.5" fill="currentColor" stroke="none">f</text></svg></a>}
</div>
