---
import {defaults} from '../lib/editorial';
import {safeUrl} from '../lib/content';
interface Props {class?: string}
const {class: className = ''} = Astro.props;
---
<div class:list={['social-icons', className]}>
  {safeUrl(defaults.instagram) && <a href={safeUrl(defaults.instagram)} target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="5.5" y="5.5" width="13" height="13" rx="4"/><circle cx="12" cy="12" r="3.3"/><circle cx="16" cy="8" r="1" fill="currentColor" stroke="none"/></svg></a>}
  {safeUrl(defaults.youtube) && <a href={safeUrl(defaults.youtube)} target="_blank" rel="noopener noreferrer" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M9.5 7.5v9l8-4.5z"/></svg></a>}
  {safeUrl(defaults.linkedin) && <a href={safeUrl(defaults.linkedin)} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><text x="12" y="16.3" text-anchor="middle" font-family="Arial,Helvetica,sans-serif" font-weight="700" font-size="12.5">in</text></svg></a>}
  {safeUrl(defaults.facebook) && <a href={safeUrl(defaults.facebook)} target="_blank" rel="noopener noreferrer" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><text x="12" y="16.5" text-anchor="middle" font-family="Georgia,'Playfair Display',serif" font-weight="700" font-size="13.5">f</text></svg></a>}
</div>
