---
import {
  defaults
} from '../lib/editorial';

import {
  safeUrl
} from '../lib/content';

import '../styles/components/social-icons.css';

interface Props {
  class?: string;
}

const {
  class: className = ''
} = Astro.props;
---

<div
  class:list={[
    'social-icons',
    className
  ]}
>
  {
    safeUrl(
      defaults.instagram
    ) && (
      <a
        class="social-link"
        href={
          safeUrl(
            defaults.instagram
          )
        }
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        title="Instagram"
      >
        <svg
          class="social-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.65"
          aria-hidden="true"
        >
          <rect
            x="3.25"
            y="3.25"
            width="17.5"
            height="17.5"
            rx="5.2"
          />

          <circle
            cx="12"
            cy="12"
            r="4.1"
          />

          <circle
            cx="17.35"
            cy="6.65"
            r="1.05"
            fill="currentColor"
            stroke="none"
          />
        </svg>
      </a>
    )
  }

  {
    safeUrl(
      defaults.youtube
    ) && (
      <a
        class="social-link"
        href={
          safeUrl(
            defaults.youtube
          )
        }
        target="_blank"
        rel="noopener noreferrer"
        aria-label="YouTube"
        title="YouTube"
      >
        <svg
          class="social-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.65"
          aria-hidden="true"
        >
          <rect
            x="2.6"
            y="5.6"
            width="18.8"
            height="12.8"
            rx="3.7"
          />

          <path
            d="M10 9.2v5.6l5-2.8-5-2.8Z"
            fill="currentColor"
            stroke="none"
          />
        </svg>
      </a>
    )
  }

  {
    safeUrl(
      defaults.linkedin
    ) && (
      <a
        class="social-link"
        href={
          safeUrl(
            defaults.linkedin
          )
        }
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <svg
          class="social-icon"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <circle
            cx="5.2"
            cy="6.15"
            r="1.65"
          />

          <path
            d="M3.8 9.15h2.8V20H3.8V9.15Zm5.35 0h2.68v1.48h.04c.37-.71 1.29-1.77 3.24-1.77 3.46 0 4.09 2.28 4.09 5.24V20h-2.79v-5.22c0-1.25-.02-2.85-1.74-2.85-1.74 0-2 1.36-2 2.76V20H9.15V9.15Z"
          />
        </svg>
      </a>
    )
  }

  {
    safeUrl(
      defaults.facebook
    ) && (
      <a
        class="social-link"
        href={
          safeUrl(
            defaults.facebook
          )
        }
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook"
        title="Facebook"
      >
        <svg
          class="social-icon social-icon-facebook"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M13.65 20.5v-7.27h2.45l.36-2.84h-2.81V8.58c0-.82.23-1.38 1.41-1.38h1.5V4.66c-.26-.04-1.15-.11-2.19-.11-2.17 0-3.66 1.33-3.66 3.77v2.07H8.25v2.84h2.46v7.27h2.94Z"
          />
        </svg>
      </a>
    )
  }
</div>
