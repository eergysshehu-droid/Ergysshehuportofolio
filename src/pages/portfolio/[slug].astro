---
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';

import {
  content,
  photoUrl,
  photoSet,
  photoPosition,
  safeUrl,
  type Album,
  type Settings
} from '../../lib/content';

import {
  paceGallery,
  PERSON_ID,
  WEBSITE_ID
} from '../../lib/editorial';

import {
  languageFromPath,
  localizedPath,
  localizedHref
} from '../../lib/i18n';

export async function getStaticPaths() {
  const {
    albums,
    settings
  } = await content();

  return albums.map(
    (
      album,
      index
    ) => ({
      params: {
        slug:
          album.slug
      },

      props: {
        album,
        settings,

        nextAlbum:
          albums.length >
            1
            ? albums[
                (
                  index +
                  1
                ) %
                albums.length
              ]
            : undefined
      }
    })
  );
}

interface Props {
  album: Album;
  settings: Settings;
  nextAlbum?: Album;
}

const {
  album,
  settings,
  nextAlbum
} = Astro.props;

const lang =
  languageFromPath(
    Astro.url.pathname
  );

const isSq =
  lang === 'sq';

const title =
  isSq
    ? (
        album.titleSq ||
        album.title
      )
    : album.title;

const description =
  isSq
    ? (
        album.descriptionSq ||
        album.description
      )
    : album.description;

const category =
  isSq
    ? (
        album.categorySq ||
        album.category
      )
    : album.category;

const location =
  isSq
    ? (
        album.locationSq ||
        album.location
      )
    : album.location;

const credits =
  isSq
    ? (
        album.creditsSq ||
        album.credits
      )
    : album.credits;

const nextTitle =
  nextAlbum
    ? (
        isSq
          ? (
              nextAlbum.titleSq ||
              nextAlbum.title
            )
          : nextAlbum.title
      )
    : '';

const nextCategory =
  nextAlbum
    ? (
        isSq
          ? (
              nextAlbum.categorySq ||
              nextAlbum.category
            )
          : nextAlbum.category
      )
    : '';

const seoDescription =
  description ||
  (
    isSq
      ? `${title} — projekt ${
          category ||
          'fotografie dhe video'
        } nga Ergys Shehu${
          location
            ? ` në ${location}`
            : ' në Shqipëri'
        }${
          album.year
            ? `, ${album.year}`
            : ''
        }.`
      : `${title} — ${
          category ||
          'photography and video'
        } project by Ergys Shehu${
          location
            ? ` in ${location}`
            : ' in Albania'
        }${
          album.year
            ? `, ${album.year}`
            : ''
        }.`
  );

const rows =
  paceGallery(
    (
      album.photos ||
      []
    ).filter(
      photo =>
        photoUrl(
          photo
        )
    )
  );

const pagePath =
  localizedPath(
    `/portfolio/${album.slug}/`,
    lang
  );

const pageUrl =
  new URL(
    pagePath,
    'https://ergysshehu.com'
  ).href;

const projectsUrl =
  new URL(
    localizedPath(
      '/projects/',
      lang
    ),
    'https://ergysshehu.com'
  ).href;

const homeUrl =
  new URL(
    localizedPath(
      '/',
      lang
    ),
    'https://ergysshehu.com'
  ).href;

const coverUrl =
  photoUrl(
    album.cover,
    2000
  );

const nextProjectPhoto =
  nextAlbum
    ? (
        nextAlbum.nextProjectCover ||
        nextAlbum.cover
      )
    : undefined;


const nextCoverUrl =
  nextProjectPhoto
    ? photoUrl(
        nextProjectPhoto,
        2200
      )
    : '';

const nextHref =
  nextAlbum
    ? localizedPath(
        `/portfolio/${nextAlbum.slug}/`,
        lang
      )
    : '';

const projectImages = [
  coverUrl,

  ...(
    album.photos ||
    []
  ).map(
    photo =>
      photoUrl(
        photo,
        2200
      )
  )
]
  .filter(
    (
      value
    ): value is string =>
      Boolean(
        value
      )
  )
  .filter(
    (
      value,
      index,
      array
    ) =>
      array.indexOf(
        value
      ) ===
      index
  )
  .slice(
    0,
    20
  );

const creativeWorkLd = {
  '@context':
    'https://schema.org',

  '@type':
    'CreativeWork',

  '@id':
    `${pageUrl}#creativework`,

  url:
    pageUrl,

  name:
    title,

  inLanguage:
    lang,

  ...(description
    ? {
        description
      }
    : {}),

  ...(projectImages.length
    ? {
        image:
          projectImages
      }
    : {}),

  creator: {
    '@id':
      PERSON_ID
  },

  author: {
    '@id':
      PERSON_ID
  },

  isPartOf: {
    '@id':
      WEBSITE_ID
  },

  ...(category ||
  album.kind
    ? {
        genre:
          category ||
          album.kind
      }
    : {}),

  ...(location
    ? {
        contentLocation: {
          '@type':
            'Place',

          name:
            location
        }
      }
    : {}),

  ...(album.year
    ? {
        dateCreated:
          String(
            album.year
          )
      }
    : {}),

  ...(safeUrl(
    album.videoUrl
  )
    ? {
        associatedMedia: {
          '@type':
            'VideoObject',

          url:
            safeUrl(
              album.videoUrl
            ),

          name:
            title
        }
      }
    : {})
};

const breadcrumbLd = {
  '@context':
    'https://schema.org',

  '@type':
    'BreadcrumbList',

  itemListElement: [
    {
      '@type':
        'ListItem',

      position:
        1,

      name:
        isSq
          ? 'Ballina'
          : 'Home',

      item:
        homeUrl
    },

    {
      '@type':
        'ListItem',

      position:
        2,

      name:
        isSq
          ? 'Projektet'
          : 'Projects',

      item:
        projectsUrl
    },

    {
      '@type':
        'ListItem',

      position:
        3,

      name:
        title,

      item:
        pageUrl
    }
  ]
};
---

<Layout
  lang={lang}
  title={`${title} | ${settings.name || 'Ergys Shehu'}`}
  name={settings.name}
  description={seoDescription}
  image={coverUrl}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={
      JSON.stringify(
        creativeWorkLd
      )
    }
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={
      JSON.stringify(
        breadcrumbLd
      )
    }
  />

 <section
  class="collection-intro project-intro"
  data-project-intro
>
    <a
      class="back-link"
      data-reveal
      href={
        localizedPath(
          '/projects/',
          lang
        )
      }
    >
      {
        isSq
          ? '← Të gjitha projektet'
          : '← All projects'
      }
    </a>

    <p
      class="kicker"
      data-reveal
    >
      {
        [
          category,
          location,
          album.year
        ]
          .filter(
            Boolean
          )
          .join(
            ' / '
          )
      }
    </p>

    <h1 data-reveal>
      {title}
    </h1>

    {
      description && (
        <p
          class="bio"
          data-reveal
        >
          {description}
        </p>
      )
    }

    {
      safeUrl(
        album.videoUrl
      ) && (
        <a
          class="cta-row video-link"
          data-reveal
          href={
            safeUrl(
              album.videoUrl
            )
          }
          target="_blank"
          rel="noopener noreferrer"
        >
          <span
            class="circle-btn"
            aria-hidden="true"
          >
            ↗
          </span>

          <span>
            {
              isSq
                ? 'SHIKO VIDEON'
                : 'WATCH FILM'
            }
          </span>
        </a>
      )
    }

    {
      credits && (
        <p
          class="credits"
          data-reveal
        >
          {credits}
        </p>
      )
    }
  </section>

  <section
    class="gallery collection-body"
    aria-label={title}
  >
    {
      rows.map(
        (
          row,
          ri
        ) => (
          <div
            class:list={[
              `row-${row.type}`,

              row.align &&
                `align-${row.align}`
            ]}
          >
            {
              row.items.map(
                (
                  photo,
                  pi
                ) => {
                  const isFirst =
                    ri === 0 &&
                    pi === 0;

                  const alt =
                    isSq
                      ? (
                          photo.altSq ||
                          photo.alt ||
                          title
                        )
                      : (
                          photo.alt ||
                          title
                        );

                  const caption =
                    isSq
                      ? (
                          photo.captionSq ||
                          photo.caption
                        )
                      : photo.caption;

                  const fullWidth =
                    row.type ===
                    'full';

                  const pair =
                    row.type ===
                    'pair';

                  return (
                    <figure data-reveal>
                      <a
                        href={
                          photoUrl(
                            photo,
                            2400
                          )
                        }
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={
                          isSq
                            ? `Hap fotografinë: ${alt}`
                            : `Open photograph: ${alt}`
                        }
                      >
                        <div
                          data-image-reveal
                          style={
                            fullWidth
                              ? `--focal-point:${photoPosition(photo)}`
                              : undefined
                          }
                        >
                          <img
                            src={
                              photoUrl(
                                photo,
                                fullWidth
                                  ? 2200
                                  : 1800
                              )
                            }
                            srcset={
                              photoSet(
                                photo
                              )
                            }
                            sizes={
                              fullWidth
                                ? '100vw'
                                : pair
                                  ? '(max-width: 700px) 100vw, (max-width: 1200px) 48vw, 700px'
                                  : '(max-width: 700px) 100vw, (max-width: 1200px) 78vw, 1100px'
                            }
                            width={
                              photo.width
                            }
                            height={
                              photo.height
                            }
                            alt={alt}
                            loading={
                              isFirst
                                ? 'eager'
                                : 'lazy'
                            }
                            fetchpriority={
                              isFirst
                                ? 'high'
                                : undefined
                            }
                            decoding="async"
                          />
                        </div>
                      </a>

                      {
                        (
                          caption ||
                          photo.credit
                        ) && (
                          <figcaption>
                            {caption}

                            {
                              photo.credit && (
                                <span>
                                  {' '}
                                  © {photo.credit}
                                </span>
                              )
                            }
                          </figcaption>
                        )
                      }
                    </figure>
                  );
                }
              )
            }
          </div>
        )
      )
    }
  </section>

  <a
    class="gallery-cta"
    href={
      localizedHref(
        '/book/#contact',
        lang
      )
    }
  >
    {
      isSq
        ? 'Rezervo një sesion ↗'
        : 'Book a session ↗'
    }
  </a>

  {
    nextAlbum &&
    nextHref &&
    nextCoverUrl && (
      <section
        class="next-project"
        aria-label={
          isSq
            ? 'Projekti tjetër'
            : 'Next project'
        }
      >
        <a
          href={nextHref}
          data-next-project
        >
         <div
  class="next-project-media"
  aria-hidden="true"
  style={
    nextProjectPhoto
      ? `--next-focal-point:${photoPosition(nextProjectPhoto)}`
      : undefined
  }
>
            <img
              src={nextCoverUrl}
              srcset={
                photoSet(
  nextProjectPhoto
)
              }
              sizes="100vw"
              alt=""
              loading="lazy"
              decoding="async"
             width={
  nextProjectPhoto?.width ||
  1800
}
              height={
  nextProjectPhoto?.height ||
  1200
}
            />
          </div>

          <div class="next-project-copy">
            <span class="next-project-eyebrow">
              {
                isSq
                  ? 'PROJEKTI TJETËR'
                  : 'NEXT PROJECT'
              }
              {
                nextCategory
                  ? ` / ${nextCategory}`
                  : ''
              }
            </span>

            <h2 class="next-project-title">
              {nextTitle}
            </h2>

            <span
              class="next-project-arrow"
              aria-hidden="true"
            >
              ↗
            </span>
          </div>
        </a>
      </section>
    )
  }

  <Lightbox/>
</Layout>
