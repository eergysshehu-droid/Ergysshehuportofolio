---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';

import {
  content,
  albumKind,
  photoUrl,
  type Album,
  type Settings
} from '../lib/content';

import {
  sections,
  films,
  defaults
} from '../lib/editorial';

import {
  languageFromPath,
  localizedPath,
  localizedHref
} from '../lib/i18n';

export async function getStaticPaths() {
  const {
    settings,
    albums
  } = await content();

  return [
    ...sections,
    {
      slug: 'projects',
      title: 'Projects',
      subtitle:
        'Selected stories, still and moving.',
      seoDescription:
        'Personal and commercial photography projects by Ergys Shehu, photographer and director based in Albania.'
    }
  ].map(section => ({
    params: {
      section:
        section.slug
    },

    props: {
      section,
      settings,

      albums:
        section.slug === 'projects'
          ? albums
          : albums.filter(
              album =>
                albumKind(album) ===
                section.slug
            )
    }
  }));
}

interface Props {
  section: {
    slug: string;
    title: string;
    subtitle: string;
    seoDescription: string;
  };

  settings: Settings;
  albums: Album[];
}

const {
  section,
  settings,
  albums
} = Astro.props;

const lang =
  languageFromPath(
    Astro.url.pathname
  );

const isSq =
  lang === 'sq';

const sectionSq:
  Record<
    string,
    {
      title: string;
      subtitle: string;
      seoTitle: string;
      seoDescription: string;
    }
  > = {
    fashion: {
      title:
        'Modë',

      subtitle:
        'Editoriale & Fushata',

      seoTitle:
        'Fotografi Mode',

      seoDescription:
        'Fotografi mode, editoriale dhe fushatash nga Ergys Shehu, fotograf dhe regjisor me bazë në Shqipëri dhe i disponueshëm ndërkombëtarisht.'
    },

    weddings: {
      title:
        'Dasma',

      subtitle:
        'Histori dashurie',

      seoTitle:
        'Fotografi Dasmash',

      seoDescription:
        'Fotografi dhe film dasmash nga Ergys Shehu — reportazh editorial, emocional dhe i përjetshëm për çifte në Shqipëri dhe jashtë saj.'
    },

    portraits: {
      title:
        'Portrete',

      subtitle:
        'Bukuria në realitet',

      seoTitle:
        'Fotografi Portretesh',

      seoDescription:
        'Fotografi portretesh nga Ergys Shehu — portrete të sinqerta, editoriale dhe bashkëkohore në Shqipëri dhe ndërkombëtarisht.'
    },

    films: {
      title:
        'Film & Video',

      subtitle:
        'Videoklipe, filma të shkurtër dhe histori vizuale.',

      seoTitle:
        'Film & Regji',

      seoDescription:
        'Videoklipe, filma të shkurtër dhe storytelling vizual me regji nga Ergys Shehu.'
    },

    projects: {
      title:
        'Projekte',

      subtitle:
        'Histori të përzgjedhura, fotografi dhe film.',

      seoTitle:
        'Projekte Personale',

      seoDescription:
        'Projekte personale dhe komerciale në fotografi dhe film nga Ergys Shehu.'
    }
  };

const seoTitlesEn:
  Record<string, string> = {
    fashion:
      'Fashion Photography',

    weddings:
      'Wedding Photography',

    portraits:
      'Portrait Photography',

    films:
      'Film & Direction',

    projects:
      'Personal Projects'
  };

const localizedSection =
  isSq
    ? (
        sectionSq[
          section.slug
        ] || {
          title:
            section.title,

          subtitle:
            section.subtitle,

          seoTitle:
            section.title,

          seoDescription:
            section.seoDescription
        }
      )
    : {
        title:
          section.title,

        subtitle:
          section.subtitle,

        seoTitle:
          seoTitlesEn[
            section.slug
          ] ||
          section.title,

        seoDescription:
          section.seoDescription
      };

const pageTitle =
  `${localizedSection.seoTitle} — Ergys Shehu`;

const projectsLabel =
  isSq
    ? 'PROJEKTE'
    : 'PROJECTS';

const portfolioLabel =
  isSq
    ? 'PORTOFOLI'
    : 'THE PORTFOLIO';
---

<Layout
  lang={lang}
  title={pageTitle}
  name={settings.name}
  description={
    localizedSection.seoDescription
  }
  image={
    albums[0] &&
    photoUrl(
      albums[0].cover,
      1800
    )
  }
>
  <section class="collection-intro">
    <a
      class="back-link"
      data-reveal
      href={
        localizedPath(
          '/',
          lang
        )
      }
    >
      {
        isSq
          ? '← Ballina'
          : '← Home'
      }
    </a>

    <p
      class="kicker"
      data-reveal
    >
      {portfolioLabel}
      {' / '}
      {
        String(
          albums.length
        ).padStart(
          2,
          '0'
        )
      }
      {' '}
      {projectsLabel}
    </p>

    <h1 data-reveal>
      {
        localizedSection.title
      }
    </h1>

    <p data-reveal>
      {
        localizedSection.subtitle
      }
    </p>
  </section>

  {
    section.slug ===
      'films' &&
    films.length > 0 && (
      <section class="films-hero-video">
        <div
          class="yt-hero-wrap"
          data-reveal
        >
          <div
            class="yt-embed yt-hero"
            data-yt-id={
              films[0].id
            }
          >
            <button
              type="button"
              class="yt-thumb"
              aria-label={
                `${
                  isSq
                    ? 'Luaj'
                    : 'Play'
                } ${
                  (
                    'label' in
                    films[0] &&
                    films[0].label
                  ) ||
                  'video'
                }`
              }
            >
              <img
                src={`https://i.ytimg.com/vi/${films[0].id}/hqdefault.jpg`}
                alt=""
                loading="eager"
                decoding="async"
                width="1280"
                height="720"
              />

              <span
                class="yt-play"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>

              {
                'label' in
                  films[0] &&
                films[0].label && (
                  <span class="yt-label">
                    {
                      films[0].label
                    }
                  </span>
                )
              }
            </button>
          </div>

          <button
            type="button"
            class="yt-sound-cta"
            data-video-id={
              films[0].id
            }
            aria-label={
              isSq
                ? 'Luaj me zë në ekran të plotë'
                : 'Play with sound, fullscreen'
            }
          >
            <span aria-hidden="true">
              🔊
            </span>

            <span>
              {
                isSq
                  ? 'Luaj me zë'
                  : 'Play with sound'
              }
            </span>
          </button>
        </div>

        <a
          class="films-more-link"
          data-reveal
          href={
            defaults.youtube
          }
          target="_blank"
          rel="noopener noreferrer"
        >
          {
            isSq
              ? 'MË SHUMË NË YOUTUBE'
              : 'MORE ON YOUTUBE'
          }

          {' '}

          <span>
            ↗
          </span>
        </a>
      </section>
    )
  }

  <dialog
    class="video-theater"
    aria-label={
      isSq
        ? 'Luajtësi i videos'
        : 'Video player'
    }
    data-video-theater
  >
    <button
      type="button"
      class="video-theater-close"
      data-video-close
      aria-label={
        isSq
          ? 'Mbyll videon'
          : 'Close video'
      }
    >
      {
        isSq
          ? 'MBYLL ×'
          : 'CLOSE ×'
      }
    </button>

    <div
      class="video-theater-frame"
      data-video-frame
    ></div>
  </dialog>

  <section class="collection-body">
    {
      albums.length
        ? (
            <ProjectGrid
              albums={albums}
            />
          )
        : (
            <div
              class="collection-empty"
              data-reveal
            >
              <p class="kicker">
                {
                  isSq
                    ? 'SË SHPEJTI'
                    : 'COMING SOON'
                }
              </p>

              <h2>
                {
                  isSq
                    ? 'Një histori e re po merr formë.'
                    : 'A new story is taking shape.'
                }
              </h2>

              <p>
                {
                  isSq
                    ? 'Punë të përzgjedhura do të publikohen këtu së shpejti.'
                    : 'Selected work will appear here soon.'
                }
              </p>

              <a
                class="cta-row"
                href={
                  localizedHref(
                    '/book/#contact',
                    lang
                  )
                }
              >
                <span
                  class="circle-btn"
                  aria-hidden="true"
                >
                  ↗
                </span>

                <span>
                  {
                    isSq
                      ? 'NA KONTAKTO'
                      : 'GET IN TOUCH'
                  }
                </span>
              </a>
            </div>
          )
    }
  </section>

  {
    section.slug ===
      'films' &&
    films.length > 1 && (
      <section class="films-more-videos">
        <p
          class="kicker"
          data-reveal
        >
          {
            isSq
              ? 'MË SHUMË NË YOUTUBE'
              : 'MORE ON YOUTUBE'
          }
        </p>

        <div class="yt-grid">
          {
            films
              .slice(1)
              .map(
                video => (
                  <div
                    class="yt-embed"
                    data-yt-id={
                      video.id
                    }
                    data-reveal
                  >
                    <button
                      type="button"
                      class="yt-thumb"
                      aria-label={
                        `${
                          isSq
                            ? 'Luaj'
                            : 'Play'
                        } ${
                          (
                            'label' in
                            video &&
                            video.label
                          ) ||
                          'video'
                        }`
                      }
                    >
                      <img
                        src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        width="480"
                        height="360"
                      />

                      <span
                        class="yt-play"
                        aria-hidden="true"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </span>

                      {
                        'label' in
                          video &&
                        video.label && (
                          <span class="yt-label">
                            {
                              video.label
                            }
                          </span>
                        )
                      }
                    </button>
                  </div>
                )
              )
          }
        </div>
      </section>
    )
  }

  <script>
    function createVideoFrame(
      id: string,
      autoplay = false,
      muted = false
    ) {
      const iframe =
        document.createElement(
          'iframe'
        );

      const params =
        new URLSearchParams();

      if (
        autoplay
      ) {
        params.set(
          'autoplay',
          '1'
        );
      }

      if (
        muted
      ) {
        params.set(
          'mute',
          '1'
        );
      }

      iframe.src =
        `https://www.youtube-nocookie.com/embed/${id}` +
        (
          params.size
            ? `?${params.toString()}`
            : ''
        );

      iframe.title =
        'YouTube video player';

      iframe.allow =
        'autoplay; encrypted-media; picture-in-picture; fullscreen';

      iframe.allowFullscreen =
        true;

      iframe.loading =
        'lazy';

      return iframe;
    }

    function hydrateHeroVideo(
      wrap: HTMLElement
    ) {
      if (
        wrap.dataset.videoHydrated ===
        'true'
      ) {
        return;
      }

      const id =
        wrap.dataset.ytId;

      if (
        !id
      ) {
        return;
      }

      const connection =
        (navigator as any).connection ||
        (navigator as any).mozConnection ||
        (navigator as any).webkitConnection;

      if (
        connection?.saveData
      ) {
        return;
      }

      wrap.dataset.videoHydrated =
        'true';

      const iframe =
        createVideoFrame(
          id,
          true,
          true
        );

      wrap
        .querySelector(
          '.yt-thumb'
        )
        ?.remove();

      wrap.prepend(
        iframe
      );
    }

    const theater =
      document.querySelector<HTMLDialogElement>(
        'dialog.video-theater'
      );

    const theaterFrame =
      theater?.querySelector<HTMLElement>(
        '[data-video-frame]'
      );

    function openTheater(
      id?: string
    ) {
      if (
        !theater ||
        !theaterFrame ||
        !id
      ) {
        return;
      }

      const iframe =
        createVideoFrame(
          id,
          true,
          false
        );

      theaterFrame
        .replaceChildren(
          iframe
        );

      theater.showModal();

      document
        .documentElement
        .classList
        .add(
          'lightbox-open'
        );
    }

    document
      .querySelectorAll<HTMLElement>(
        '[data-yt-id]'
      )
      .forEach(
        wrap => {
          wrap
            .querySelector(
              '.yt-thumb'
            )
            ?.addEventListener(
              'click',
              () =>
                openTheater(
                  wrap.dataset.ytId
                ),
              {
                once:
                  true
              }
            );
        }
      );

    theater
      ?.addEventListener(
        'close',
        () => {
          theaterFrame
            ?.replaceChildren();

          document
            .documentElement
            .classList
            .remove(
              'lightbox-open'
            );
        }
      );

    theater
      ?.querySelector(
        '[data-video-close]'
      )
      ?.addEventListener(
        'click',
        () =>
          theater.close()
      );

    document
      .querySelector<HTMLElement>(
        '.yt-sound-cta'
      )
      ?.addEventListener(
        'click',
        event => {
          const target =
            event.currentTarget as HTMLElement;

          openTheater(
            target.dataset.videoId
          );
        }
      );

    const reducedMotion =
      window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      );

    const hero =
      document.querySelector<HTMLElement>(
        '.yt-hero[data-yt-id]'
      );

    if (
      hero &&
      !reducedMotion.matches &&
      'IntersectionObserver' in window
    ) {
      const observer =
        new IntersectionObserver(
          (
            entries,
            obs
          ) => {
            for (
              const entry of
              entries
            ) {
              if (
                !entry.isIntersecting
              ) {
                continue;
              }

              hydrateHeroVideo(
                hero
              );

              obs.unobserve(
                hero
              );
            }
          },
          {
            rootMargin:
              '300px 0px'
          }
        );

      observer.observe(
        hero
      );
    }
  </script>
</Layout>
