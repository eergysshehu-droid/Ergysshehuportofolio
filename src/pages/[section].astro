---
import '../styles/portfolio.css';
import {defaults, PERSON_ID, WEBSITE_ID, KULT360_ID} from '../lib/editorial';
import SocialIcons from '../components/SocialIcons.astro';

interface Props {
  title?: string;
  description?: string;
  name?: string;
  home?: boolean;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Ergys Shehu — Photographer & Director | Albania',
  description = defaults.seoDescription,
  name = defaults.name,
  home = false,
  image = '/images/ergys-shehu-logo.png',
  noindex = false,
} = Astro.props;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : 'https://ergysshehu.com/';
const pageLang = Astro.url.pathname.startsWith('/sq') ? 'sq' : 'en';
const sqUrl = (() => {
  const url = new URL(canonicalUrl);
  const path = url.pathname.replace(/\/+$/, '') || '/';
  if (path === '/') return 'https://ergysshehu.com/sq/';
  if (path.startsWith('/sq')) return url.href;
  return new URL('/sq' + path, url.origin).href + '/';
})();
const imageUrl = Astro.site && image ? new URL(image, Astro.site) : new URL(image, 'https://ergysshehu.com');
const seoImage = imageUrl.href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': PERSON_ID,
  name: defaults.name,
  url: 'https://ergysshehu.com/',
  jobTitle: 'Photographer & Director',
  description: defaults.seoDescription,
  address: {'@type': 'PostalAddress', addressCountry: 'AL'},
  sameAs: [defaults.instagram, defaults.linkedin, defaults.facebook, defaults.youtube].filter(Boolean),
  worksFor: {'@id': KULT360_ID},
  ...(imageUrl ? {image: seoImage} : {}),
};

const kult360Ld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': KULT360_ID,
  name: 'Kult 360 Foundation',
  url: defaults.kult360,
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: 'Ergys Shehu',
  url: 'https://ergysshehu.com/',
  description: defaults.seoDescription,
  inLanguage: 'en',
  publisher: {'@id': PERSON_ID},
};

const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonicalUrl + '#webpage',
  url: canonicalUrl,
  name: title,
  isPartOf: {'@id': WEBSITE_ID},
  about: {'@id': PERSON_ID},
};
---
<!doctype html>
<html lang={pageLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="sq" href={sqUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ergys Shehu" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={pageLang === 'sq' ? 'sq_AL' : 'en_US'} />
    <meta property="og:locale:alternate" content={pageLang === 'sq' ? 'en_US' : 'sq_AL'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={seoImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(kult360Ld)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webPageLd)}></script>
  </head>
  <body class:list={[{'is-home': home}]}>
    <a class="skip" href="#main" data-en="Skip to content" data-sq="Kalo te përmbajtja">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/" class="brand-mark" data-reveal>{name}</a>
        <div class="nav-group">
          <a href="/" data-en="Home" data-sq="Ballina">Home</a>
          <a href="/projects/" data-en="Projects" data-sq="Projektet">Projects</a>
          <a href="/journal/" data-en="Journal" data-sq="Ditari">Journal</a>
          <a href="/book/" data-en="Book" data-sq="Rezervo">Book</a>
        </div>
        <div class="language-switch" aria-label="Language switcher">
          <button type="button" data-lang="en" aria-label="English" class="lang-btn">EN</button>
          <button type="button" data-lang="sq" aria-label="Shqip" class="lang-btn">SQ</button>
        </div>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="footer-row"><a href="/" class="footer-name" data-reveal>{name}</a><SocialIcons class="footer-social" /><a class="footer-contact" href="/book/#contact" data-en="Book a shoot" data-sq="Rezervo një sesion">Book a shoot</a></div>
    </footer>
    <script>
      document.documentElement.classList.add('motion-ready');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const LANG_KEY = 'site-lang';
      function currentLang() { try { return localStorage.getItem(LANG_KEY) || 'en'; } catch { return 'en'; } }
      function applyLang(lang) {
        document.querySelectorAll('[data-en]').forEach((el) => {
          const text = lang === 'sq' ? el.dataset.sq : el.dataset.en;
          if (text != null) el.textContent = text;
        });
        document.querySelectorAll('[data-en-placeholder]').forEach((el) => {
          if (!(el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement)) return;
          const text = lang === 'sq' ? el.dataset.sqPlaceholder : el.dataset.enPlaceholder;
          if (text != null) el.placeholder = text;
        });
        document.querySelectorAll('[data-lang-content]').forEach((el) => {
          el.hidden = el.dataset.langContent !== lang;
        });
        document.querySelectorAll('[data-lang]').forEach((btn) => {
          btn.classList.toggle('is-active', btn.dataset.lang === lang);
          btn.setAttribute('aria-pressed', String(btn.dataset.lang === lang));
        });
        document.querySelectorAll('.language-switch').forEach((el) => {
          el.dataset.active = lang;
        });
        document.documentElement.lang = lang;
        try { localStorage.setItem(LANG_KEY, lang); } catch {}
      }
      applyLang(currentLang());
      document.querySelectorAll('[data-lang]').forEach((btn) => btn.addEventListener('click', () => applyLang(btn.dataset.lang || 'en')));

      const mobileMenu = document.querySelector('.mobile-menu');
      document.querySelectorAll('.mobile-menu a').forEach((a) => a.addEventListener('click', () => { if (mobileMenu) mobileMenu.open = false; }));
      document.querySelector('[data-menu-close]')?.addEventListener('click', () => { if (mobileMenu) mobileMenu.open = false; });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && mobileMenu?.open) { mobileMenu.open = false; mobileMenu.querySelector('summary')?.focus(); } });
      mobileMenu?.addEventListener('toggle', () => document.documentElement.classList.toggle('mobile-menu-open', mobileMenu.open));

      const siteHeader = document.querySelector('.site-header');
      if (siteHeader) {
        const headerH = siteHeader.offsetHeight || 90;
        let lastY = window.scrollY;
        let headerTicking = false;
        const updateHeader = () => {
          const y = window.scrollY;
          siteHeader.classList.toggle('is-scrolled', y > headerH);
          if (!reducedMotion.matches) {
            if (y <= headerH) siteHeader.classList.remove('is-hidden');
            else if (y > lastY) siteHeader.classList.add('is-hidden');
            else if (y < lastY) siteHeader.classList.remove('is-hidden');
          }
          lastY = y;
          headerTicking = false;
        };
        updateHeader();
        document.addEventListener('scroll', () => { if (!headerTicking) { requestAnimationFrame(updateHeader); headerTicking = true; } }, {passive: true});
      }

      if ('IntersectionObserver' in window) {
        const revealTargets = document.querySelectorAll('[data-reveal], [data-image-reveal]');
        if (revealTargets.length) {
          const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          }, {threshold: 0, rootMargin: '0px 0px -10% 0px'});
          revealTargets.forEach((el) => io.observe(el));
          setTimeout(() => revealTargets.forEach((el) => el.classList.add('is-visible')), 4000);
        }
      }

      const progress = document.querySelector('.scroll-progress');
      if (progress && !reducedMotion.matches) {
        let ticking = false;
        const update = () => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - doc.clientHeight;
          progress.style.transform = `scaleX(${max > 0 ? Math.min(doc.scrollTop / max, 1) : 0})`;
          ticking = false;
        };
        update();
        document.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, {passive: true});
      }
    </script>
  </body>
</html>
---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import {content, albumKind, photoUrl, type Album, type Settings} from '../lib/content';
import {sections, films, defaults} from '../lib/editorial';

export async function getStaticPaths() {
  const {settings, albums} = await content();
  return [...sections, {slug: 'projects', title: 'Projects', subtitle: 'Selected stories, still and moving.', seoDescription: 'Personal and commercial photography projects by Ergys Shehu, photographer and director based in Albania.'}].map((section) => ({params: {section: section.slug}, props: {section, settings, albums}}));
}

interface Props {section: {slug: string; title: string; subtitle: string; seoDescription: string}; settings: Settings; albums: Album[]}
const {section, settings, albums} = Astro.props;
const seoTitles: Record<string, string> = {fashion: 'Fashion Photography', weddings: 'Wedding Photography', portraits: 'Portrait Photography', films: 'Film & Direction', projects: 'Personal Projects'};
const pageTitle = `${seoTitles[section.slug] || section.title} — Ergys Shehu`;
---
<Layout title={pageTitle} name={settings.name} description={section.seoDescription} image={albums[0] && photoUrl(albums[0].cover, 1800)}>
  <section class="collection-intro"><a class="back-link" data-reveal href="/" data-en="← Home" data-sq="← Ballina">← Home</a><p class="kicker" data-reveal>{section.title}</p><h1 data-reveal>{section.title}</h1><p data-reveal>{section.subtitle}</p></section>
  <ProjectGrid albums={albums.filter((album) => albumKind(album) === section.slug || (section.slug === 'projects' && albumKind(album) !== 'weddings' && albumKind(album) !== 'portraits' && albumKind(album) !== 'fashion' && albumKind(album) !== 'films'))} />
  <dialog class="video-theater" aria-label="Video player" data-video-theater><button type="button" class="video-theater-close" data-video-close aria-label="Close video">CLOSE ×</button><div class="video-frame" data-video-frame></div></dialog>
  <script>
    function createVideoFrame(id, autoplay = false) {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}${autoplay ? '?autoplay=1' : ''}`;
      iframe.title = 'YouTube video player';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.loading = 'lazy';
      return iframe;
    }

    function hydrateVideo(wrap) {
      const id = wrap.dataset.ytId;
      if (!id) return;

      const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      if (connection && connection.saveData) return;

      const iframe = createVideoFrame(id, true);
      wrap.querySelector('.yt-thumb')?.remove();
      wrap.prepend(iframe);
    }

    function openTheater(id) {
      const theater = document.querySelector('dialog.video-theater');
      const theaterFrame = theater?.querySelector('[data-video-frame]');
      if (!theater || !theaterFrame || !id) return;
      const iframe = createVideoFrame(id, true);
      theaterFrame.replaceChildren(iframe);
      theater.showModal();
      document.documentElement.classList.add('lightbox-open');
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const hero = document.querySelector('.yt-hero[data-yt-id]');

    if ('IntersectionObserver' in window && hero && !reducedMotion.matches) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            hydrateVideo(hero);
            obs.unobserve(hero);
          }
        });
      }, {rootMargin: '250px 0px'});
      observer.observe(hero);
    }

    document.querySelectorAll('[data-yt-id]').forEach((wrap) => {
      const thumb = wrap.querySelector('.yt-thumb');
      thumb?.addEventListener('click', () => openTheater(wrap.dataset.ytId), {once: true});
    });

    const theater = document.querySelector('dialog.video-theater');
    theater?.addEventListener('close', () => {
      theater.querySelector('[data-video-frame]')?.replaceChildren();
      document.documentElement.classList.remove('lightbox-open');
    });
    theater?.querySelector('[data-video-close]')?.addEventListener('click', () => theater.close());
    document.querySelector('.yt-sound-cta')?.addEventListener('click', (e) => openTheater(e.currentTarget.dataset.videoId));
  </script>
</Layout>
