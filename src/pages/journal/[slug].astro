---
import Layout from '../../layouts/Layout.astro';
import '../../styles/pages/journal.css';
import {
  content,
  photoUrl,
  photoSet,
  photoPosition,
  safeUrl
} from '../../lib/content';

import {
  journal,
  type PortableSpan,
  type PortableMarkDef,
  type PortableItem
} from '../../lib/journal';

import {
  defaults,
  PERSON_ID,
  WEBSITE_ID
} from '../../lib/editorial';

import {
  languageFromPath,
  localizedPath
} from '../../lib/i18n';

export async function getStaticPaths() {
  const posts =
    await journal();

  return posts.map(
    post => ({
      params: {
        slug:
          post.slug
      },

      props: {
        post
      }
    })
  );
}

const {
  post
} = Astro.props;

const lang =
  languageFromPath(
    Astro.url.pathname
  );

const isSq =
  lang === 'sq';

const {
  settings: saved
} = await content();

const settings = {
  ...defaults,

  ...Object.fromEntries(
    Object.entries(
      saved
    ).filter(
      (
        [, value]
      ) =>
        value != null
    )
  )
};

const title =
  isSq
    ? (
        post.titleSq ||
        post.title
      )
    : post.title;

const excerpt =
  isSq
    ? (
        post.excerptSq ||
        post.excerpt
      )
    : post.excerpt;

const category =
  isSq
    ? (
        post.categorySq ||
        post.category
      )
    : post.category;

const body:
  PortableItem[] =
    isSq
      ? (
          post.bodySq &&
          post.bodySq.length
            ? post.bodySq
            : post.body
        )
      : post.body;

const formatDateEn = (
  iso: string
) =>
  new Date(
    iso
  ).toLocaleDateString(
    'en-GB',
    {
      day:
        'numeric',

      month:
        'long',

      year:
        'numeric'
    }
  );

const monthsSq = [
  'janar',
  'shkurt',
  'mars',
  'prill',
  'maj',
  'qershor',
  'korrik',
  'gusht',
  'shtator',
  'tetor',
  'nëntor',
  'dhjetor'
];

const formatDateSq = (
  iso: string
) => {
  const date =
    new Date(
      iso
    );

  return `${date.getDate()} ${monthsSq[date.getMonth()]} ${date.getFullYear()}`;
};

const date =
  isSq
    ? formatDateSq(
        post.publishedAt
      )
    : formatDateEn(
        post.publishedAt
      );

const dateLine =
  `${
    category
      ? category + ' / '
      : ''
  }${date}`;

const escapeHtml = (
  text: string
) =>
  text
    .replace(
      /&/g,
      '&amp;'
    )
    .replace(
      /</g,
      '&lt;'
    )
    .replace(
      />/g,
      '&gt;'
    )
    .replace(
      /"/g,
      '&quot;'
    )
    .replace(
      /'/g,
      '&#039;'
    );

function renderInline(
  spans:
    PortableSpan[] = [],

  markDefs:
    PortableMarkDef[] = []
) {
  return spans
    .map(
      span => {
        let html =
          escapeHtml(
            span.text
          );

        for (
          const mark of
          span.marks ||
          []
        ) {
          if (
            mark ===
            'strong'
          ) {
            html =
              `<strong>${html}</strong>`;
          } else if (
            mark ===
            'em'
          ) {
            html =
              `<em>${html}</em>`;
          } else {
            const def =
              markDefs.find(
                item =>
                  item._key ===
                  mark
              );

            const href =
              safeUrl(
                def?.href
              );

            if (
              href
            ) {
              html =
                `<a href="${escapeHtml(href)}" target="_blank" rel="noopener noreferrer">${html}</a>`;
            }
          }
        }

        return html;
      }
    )
    .join(
      ''
    );
}

const blockTag:
  Record<
    string,
    string
  > = {
    normal:
      'p',

    h2:
      'h2',

    h3:
      'h3',

    blockquote:
      'blockquote'
  };

const pagePath =
  localizedPath(
    `/journal/${post.slug}/`,
    lang
  );

const pageUrl =
  new URL(
    pagePath,
    'https://ergysshehu.com'
  ).href;

const journalUrl =
  new URL(
    localizedPath(
      '/journal/',
      lang
    ),
    'https://ergysshehu.com'
  ).href;

const homeUrl =
  new URL(
    localizedPath(
      '/',
      lang
    ),
    'https://ergysshehu.com'
  ).href;

const coverUrl =
  post.cover
    ? photoUrl(
        post.cover,
        1800
      )
    : undefined;

const articleLd = {
  '@context':
    'https://schema.org',

  '@type':
    'Article',

  '@id':
    `${pageUrl}#article`,

  url:
    pageUrl,

  headline:
    title,

  description:
    excerpt,

  ...(category
    ? {
        articleSection:
          category
      }
    : {}),

  ...(coverUrl
    ? {
        image: [
          coverUrl
        ]
      }
    : {}),

  author: {
    '@id':
      PERSON_ID
  },

  creator: {
    '@id':
      PERSON_ID
  },

  publisher: {
    '@id':
      PERSON_ID
  },

  isPartOf: {
    '@id':
      WEBSITE_ID
  },

  mainEntityOfPage: {
    '@type':
      'WebPage',

    '@id':
      pageUrl
  },

  datePublished:
    post.publishedAt,

  inLanguage:
    lang
};

const breadcrumbLd = {
  '@context':
    'https://schema.org',

  '@type':
    'BreadcrumbList',

  itemListElement: [
    {
      '@type':
        'ListItem',

      position:
        1,

      name:
        isSq
          ? 'Ballina'
          : 'Home',

      item:
        homeUrl
    },

    {
      '@type':
        'ListItem',

      position:
        2,

      name:
        isSq
          ? 'Shkrime'
          : 'Journal',

      item:
        journalUrl
    },

    {
      '@type':
        'ListItem',

      position:
        3,

      name:
        title,

      item:
        pageUrl
    }
  ]
};
---

<Layout
  lang={lang}
  title={`${title} | ${settings.name}`}
  name={settings.name}
  description={excerpt}
  image={coverUrl}
  ogType="article"
  publishedTime={post.publishedAt}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={
      JSON.stringify(
        articleLd
      )
    }
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={
      JSON.stringify(
        breadcrumbLd
      )
    }
  />

  <article class="journal-post">
    <section class="collection-intro journal-article-intro">
      <a
        class="back-link"
        data-reveal
        href={
          localizedPath(
            '/journal/',
            lang
          )
        }
      >
        {
          isSq
            ? '← Shkrime'
            : '← Journal'
        }
      </a>

      <p
        class="kicker"
        data-reveal
      >
        {dateLine}
      </p>

      <h1 data-reveal>
        {title}
      </h1>

      <p data-reveal>
        {excerpt}
      </p>
    </section>

    {
      post.cover &&
      photoUrl(
        post.cover
      ) && (
        <div
          class="journal-post-cover"
          data-image-reveal
          style={`--focal-point:${photoPosition(post.cover)}`}
        >
          <img
            src={
              photoUrl(
                post.cover,
                1800
              )
            }
            srcset={
              photoSet(
                post.cover
              )
            }
            sizes="90vw"
            width={
              post.cover.width
            }
            height={
              post.cover.height
            }
            alt={
              isSq
                ? (
                    post.cover.altSq ||
                    post.cover.alt ||
                    title
                  )
                : (
                    post.cover.alt ||
                    title
                  )
            }
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
        </div>
      )
    }

    <div
      class="journal-post-body"
      data-reveal
    >
      {
        body.map(
          item => {
            if (
              item._type ===
              'block'
            ) {
              const Tag = (
                blockTag[
                  item.style ||
                  'normal'
                ] ||
                'p'
              ) as any;

              return (
                <Tag
                  set:html={
                    renderInline(
                      item.children,
                      item.markDefs
                    )
                  }
                />
              );
            }

            const imageUrl =
              photoUrl(
                item
              );

            if (
              !imageUrl
            ) {
              return null;
            }

            const alt =
              isSq
                ? (
                    item.altSq ||
                    item.alt ||
                    ''
                  )
                : (
                    item.alt ||
                    ''
                  );

            const caption =
              isSq
                ? (
                    item.captionSq ||
                    item.caption
                  )
                : item.caption;

            return (
              <figure>
                <img
                  src={
                    photoUrl(
                      item,
                      1400
                    )
                  }
                  srcset={
                    photoSet(
                      item
                    )
                  }
                  sizes="(max-width:700px) 90vw, 700px"
                  width={
                    item.width
                  }
                  height={
                    item.height
                  }
                  alt={alt}
                  loading="lazy"
                  decoding="async"
                />

                {
                  (
                    caption ||
                    item.credit
                  ) && (
                    <figcaption>
                      {caption}

                      {
                        item.credit && (
                          <span>
                            {' '}
                            © {item.credit}
                          </span>
                        )
                      }
                    </figcaption>
                  )
                }
              </figure>
            );
          }
        )
      }
    </div>
  </article>
</Layout>
