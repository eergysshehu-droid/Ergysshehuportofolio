---
import Layout from '../../layouts/Layout.astro';
import {content, photoUrl, photoSet, photoPosition} from '../../lib/content';
import {journal} from '../../lib/journal';
import {defaults} from '../../lib/editorial';

const {settings: saved} = await content();
const settings = {...defaults, ...Object.fromEntries(Object.entries(saved).filter(([, v]) => v != null))};
const posts = await journal();
const formatDate = (iso: string) => new Date(iso).toLocaleDateString('en-GB', {day: 'numeric', month: 'long', year: 'numeric'});
---
<Layout title={`Journal — ${settings.name}`} name={settings.name} description="An editorial archive of photography, directing, selected cultural work and published pieces by Ergys Shehu.">
<section class="collection-intro">
  <a class="back-link" data-reveal href="/">← Home</a>
  <p class="kicker" data-reveal>THE JOURNAL / {String(posts.length).padStart(2,'0')} ENTRIES</p>
  <h1 data-reveal>Journal.</h1>
  <p data-reveal>Photography, directing, recognition and published work — the archive behind the portfolio.</p>
</section>
<section class="journal-list">
  {posts.length ? posts.map(post =>
    <a class="journal-card" data-reveal href={`/journal/${post.slug}/`}>
      {post.cover && photoUrl(post.cover) && <div class="journal-card-image" data-image-reveal style={`--focal-point:${photoPosition(post.cover)}`}><img src={photoUrl(post.cover, 900)} srcset={photoSet(post.cover)} sizes="(max-width:700px) 90vw, 42vw" alt={post.cover.alt || post.title} loading="lazy"/></div>}
      <div class="journal-card-copy">
        <span class="journal-date">{post.category ? `${post.category} / ` : ''}{formatDate(post.publishedAt)}</span>
        <h2>{post.title}</h2>
        <p>{post.excerpt}</p>
        <span class="journal-read">Read <span aria-hidden="true">↗</span></span>
      </div>
    </a>
  ) : <div class="collection-empty" data-reveal><p class="kicker">COMING SOON</p><h2>The first entry is on its way.</h2></div>}
</section>
</Layout>
