---
import Layout from '../layouts/Layout.astro';
import '../styles/book.css';
import {content, photoUrl, photoSet, albumKind, safeUrl} from '../lib/content';
import {defaults} from '../lib/editorial';

const {settings: saved, albums} = await content();
const settings = {...defaults, ...Object.fromEntries(Object.entries(saved).filter(([, v]) => v != null))};

const heroAlbum = albums.find(a => a.featured && photoUrl(a.cover)) || albums.find(a => photoUrl(a.cover));
const heroPhoto = heroAlbum?.cover || saved.heroImage;

const serviceKinds = [
  {kind: 'fashion', value: 'fashion', en: 'Fashion Editorial', sq: 'Editorial Mode'},
  {kind: 'portraits', value: 'portrait', en: 'Portrait Sessions', sq: 'Seanca Portreti'},
  {kind: 'weddings', value: 'wedding', en: 'Wedding Coverage', sq: 'Dasma'},
  {kind: 'films', value: 'film', en: 'Film & Music Video', sq: 'Film & Videoklip'},
  {kind: 'projects', value: 'brand', en: 'Brand & Campaigns', sq: 'Brande & Kampanja'}
] as const;
const services = serviceKinds.map(s => ({...s, photo: albums.find(a => albumKind(a) === s.kind && photoUrl(a.cover))?.cover}));

const projectTypes = [
  {value: 'fashion', en: 'Fashion Editorial', sq: 'Editorial Mode'},
  {value: 'portrait', en: 'Portrait Session', sq: 'Seancë Portreti'},
  {value: 'wedding', en: 'Wedding', sq: 'Dasmë'},
  {value: 'film', en: 'Film & Music Video', sq: 'Film & Videoklip'},
  {value: 'brand', en: 'Brand Campaign', sq: 'Kampanjë Brandi'},
  {value: 'collaboration', en: 'Collaboration', sq: 'Bashkëpunim'},
  {value: 'other', en: 'Other', sq: 'Tjetër'}
] as const;

const phoneDisplay = '+355 69 331 0202';
const whatsapp = "https://wa.me/355693310202?text=Hi%20Ergys%2C%20I%27d%20like%20to%20discuss%20a%20project.";
---
<Layout home title={`Book a shoot — ${settings.name}`} description="Book Ergys Shehu for fashion, portrait, wedding, film or brand work. Based in Albania, available worldwide." name={settings.name} image={heroPhoto && photoUrl(heroPhoto, 1800)}>
<div class="book-page">

<section class="book-hero" aria-label="Book a shoot">
  <div class="book-hero-image" data-image-reveal>{heroPhoto && photoUrl(heroPhoto) && <img src={photoUrl(heroPhoto, 1800)} srcset={photoSet(heroPhoto)} sizes="100vw" alt="" loading="eager" fetchpriority="high" width={heroPhoto.width} height={heroPhoto.height}/>}</div>
  <div class="book-hero-content">
    <p class="book-lang-toggle" role="group" aria-label="Language / Gjuha"><button type="button" data-lang="en" aria-pressed="true">EN</button><span aria-hidden="true">/</span><button type="button" data-lang="sq" aria-pressed="false">SQ</button></p>
    <p class="kicker" data-en="BOOK A SHOOT" data-sq="REZERVO NJË SESION">BOOK A SHOOT</p>
    <h1 data-en="Let’s create something worth remembering." data-sq="Të krijojmë diçka që vlen të mbahet mend.">Let’s create something worth remembering.</h1>
    <p class="book-hero-sub" data-en="Fashion, portraits, weddings, film and brand work — shot on location in Albania or wherever the story takes us." data-sq="Modë, portrete, dasma, film dhe punë brandi — realizuar në Shqipëri ose kudo që historia na çon.">Fashion, portraits, weddings, film and brand work — shot on location in Albania or wherever the story takes us.</p>
    <a class="book-cta" href="#contact"><span data-en="Start an inquiry" data-sq="Fillo një kërkesë">Start an inquiry</span><span aria-hidden="true">↓</span></a>
  </div>
</section>

<section class="book-services" aria-label="Services">
  <div class="book-heading" data-reveal><p class="kicker" data-en="WHAT I SHOOT" data-sq="ÇFARË FOTOGRAFOJ">WHAT I SHOOT</p><h2 data-en="Five ways to work together." data-sq="Pesë mënyra për të bashkëpunuar.">Five ways to work together.</h2></div>
  <div class="service-grid">{services.map(s =>
    <button type="button" class="service-card" data-service={s.value} data-reveal><span class="service-image">{s.photo && photoUrl(s.photo) && <img src={photoUrl(s.photo, 900)} srcset={photoSet(s.photo)} sizes="(max-width:700px) 90vw, 22vw" alt="" loading="lazy"/>}</span><span class="service-label"><span data-en={s.en} data-sq={s.sq}>{s.en}</span><span aria-hidden="true">↗</span></span></button>
  )}</div>
</section>

<section class="book-contact" id="contact" aria-label="Direct contact">
  <div class="book-heading" data-reveal><p class="kicker" data-en="GET IN TOUCH" data-sq="NA KONTAKTO">GET IN TOUCH</p><h2 data-en="Reach out directly." data-sq="Na kontakto direkt.">Reach out directly.</h2></div>
  <div class="contact-links" data-reveal>
    <a class="contact-link" href={`mailto:${settings.email}`}><span data-en="Email" data-sq="Email">Email</span><span class="contact-value">{settings.email}</span></a>
    <a class="contact-link" href="tel:+355693310202"><span data-en="Phone" data-sq="Telefon">Phone</span><span class="contact-value">{phoneDisplay}</span></a>
    <a class="contact-link" href={whatsapp} target="_blank" rel="noopener noreferrer"><span data-en="WhatsApp" data-sq="WhatsApp">WhatsApp</span><span class="contact-value" data-en="Message on WhatsApp" data-sq="Shkruaj në WhatsApp">Message on WhatsApp</span></a>
    {safeUrl(settings.instagram) && <a class="contact-link" href={safeUrl(settings.instagram)} target="_blank" rel="noopener noreferrer"><span data-en="Instagram" data-sq="Instagram">Instagram</span><span class="contact-value">@ergys.shehu</span></a>}
  </div>
  <p class="book-location" data-reveal><span data-en="Based in Albania." data-sq="Me bazë në Shqipëri.">Based in Albania.</span> <span data-en="Available worldwide." data-sq="Në dispozicion në mbarë botën.">Available worldwide.</span></p>
</section>

<section class="book-form-section" aria-label="Inquiry form">
  <div class="book-heading" data-reveal><p class="kicker" data-en="TELL ME ABOUT YOUR PROJECT" data-sq="TREGOMË PËR PROJEKTIN TËND">TELL ME ABOUT YOUR PROJECT</p><h2 data-en="Send a quick inquiry." data-sq="Dërgo një kërkesë të shpejtë.">Send a quick inquiry.</h2></div>
  <form id="inquiry-form" class="inquiry-form" data-reveal>
    <div class="form-row"><label for="name"><span data-en="Name" data-sq="Emri">Name</span><span aria-hidden="true">*</span></label><input id="name" name="name" type="text" required autocomplete="name" data-en-placeholder="Your full name" data-sq-placeholder="Emri e mbiemri" placeholder="Your full name"/></div>
    <div class="form-row"><label for="email"><span data-en="Email" data-sq="Email">Email</span><span aria-hidden="true">*</span></label><input id="email" name="email" type="email" required autocomplete="email" data-en-placeholder="you@email.com" data-sq-placeholder="ti@email.com" placeholder="you@email.com"/></div>
    <div class="form-row"><label for="phone"><span data-en="Phone" data-sq="Telefon">Phone</span> <span class="optional" data-en="(optional)" data-sq="(opsionale)">(optional)</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" data-en-placeholder="+355 6X XXX XXXX" data-sq-placeholder="+355 6X XXX XXXX" placeholder="+355 6X XXX XXXX"/></div>
    <div class="form-row"><label for="project-type"><span data-en="Project type" data-sq="Lloji i projektit">Project type</span><span aria-hidden="true">*</span></label><select id="project-type" name="projectType" required>{projectTypes.map(p => <option value={p.value} data-en={p.en} data-sq={p.sq}>{p.en}</option>)}</select></div>
    <div class="form-row"><label for="message"><span data-en="Message" data-sq="Mesazhi">Message</span><span aria-hidden="true">*</span></label><textarea id="message" name="message" rows="5" required data-en-placeholder="Dates, location, and a little about what you have in mind." data-sq-placeholder="Datat, vendndodhja dhe pak fjalë për atë që ke në mendje." placeholder="Dates, location, and a little about what you have in mind."></textarea></div>
    <button type="submit" class="submit-btn"><span data-en="Send inquiry" data-sq="Dërgo kërkesën">Send inquiry</span><span aria-hidden="true">↗</span></button>
    <p class="form-note" data-en="This opens your email app with the details filled in." data-sq="Kjo hap aplikacionin tënd të email-it me të dhënat e plotësuara.">This opens your email app with the details filled in.</p>
  </form>
</section>

<section class="book-collab" aria-label="Collaborations">
  <div class="book-heading" data-reveal><p class="kicker" data-en="COLLABORATIONS" data-sq="BASHKËPUNIME">COLLABORATIONS</p><h2 data-en="Open to working together." data-sq="I hapur për bashkëpunime.">Open to working together.</h2></div>
  <div class="collab-grid" data-reveal>
    <div class="collab-item"><h3 data-en="Models" data-sq="Modele">Models</h3><p data-en="Testing, portfolio building and collaborative shoots." data-sq="Testime, ndërtim portofoli dhe seanca bashkëpunuese.">Testing, portfolio building and collaborative shoots.</p></div>
    <div class="collab-item"><h3 data-en="Artists & Musicians" data-sq="Artistë & Muzikantë">Artists & Musicians</h3><p data-en="Cover art, music videos and visual identity." data-sq="Kopertina albumesh, videoklipe dhe identitet vizual.">Cover art, music videos and visual identity.</p></div>
    <div class="collab-item"><h3 data-en="Brands" data-sq="Brande">Brands</h3><p data-en="Campaigns, lookbooks and content production." data-sq="Kampanja, lookbook dhe produksion përmbajtjeje.">Campaigns, lookbooks and content production.</p></div>
    <div class="collab-item"><h3 data-en="Creative Projects" data-sq="Projekte Krijuese">Creative Projects</h3><p data-en="Personal, editorial and experimental work." data-sq="Punë personale, editoriale dhe eksperimentale.">Personal, editorial and experimental work.</p></div>
  </div>
  <button type="button" class="collab-cta" data-service="collaboration" data-reveal><span data-en="Propose a collaboration" data-sq="Propozo një bashkëpunim">Propose a collaboration</span><span aria-hidden="true">↗</span></button>
</section>

<section class="book-closing" aria-label="Closing">
  <p class="kicker" data-reveal data-en="ERGYS SHEHU · PHOTOGRAPHER & DIRECTOR" data-sq="ERGYS SHEHU · FOTOGRAF & REGJISOR">ERGYS SHEHU · PHOTOGRAPHER & DIRECTOR</p>
  <h2 data-reveal data-en="Available for projects, worldwide." data-sq="I disponueshëm për projekte, kudo në botë.">Available for projects, worldwide.</h2>
  <a class="book-closing-link" data-reveal href={`mailto:${settings.email}`}>{settings.email} <span aria-hidden="true">↗</span></a>
</section>

</div>

<script define:vars={{contactEmail: settings.email}} is:inline>
const STORAGE_KEY = 'book-lang';
const root = document.querySelector('.book-page');
const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

function currentLang() {
  try { return localStorage.getItem(STORAGE_KEY) || 'en'; } catch { return 'en'; }
}

function applyLang(lang) {
  if (!root) return;
  root.querySelectorAll('[data-en]').forEach(el => {
    const text = lang === 'sq' ? el.dataset.sq : el.dataset.en;
    if (text != null) el.textContent = text;
  });
  root.querySelectorAll('[data-en-placeholder]').forEach(el => {
    const text = lang === 'sq' ? el.dataset.sqPlaceholder : el.dataset.enPlaceholder;
    if (text != null) el.placeholder = text;
  });
  root.querySelectorAll('[data-lang]').forEach(btn => btn.setAttribute('aria-pressed', String(btn.dataset.lang === lang)));
  document.documentElement.lang = lang;
  try { localStorage.setItem(STORAGE_KEY, lang); } catch {}
}

applyLang(currentLang());
root?.querySelectorAll('[data-lang]').forEach(btn => btn.addEventListener('click', () => applyLang(btn.dataset.lang || 'en')));

// Service / collaboration cards preselect the project type and scroll to the form.
root?.querySelectorAll('[data-service]').forEach(el => {
  el.addEventListener('click', () => {
    const value = el.dataset.service;
    const select = document.querySelector('#project-type');
    if (select && value) select.value = value;
    document.querySelector('#inquiry-form')?.scrollIntoView({behavior: reducedMotion.matches ? 'auto' : 'smooth', block: 'start'});
    window.setTimeout(() => document.querySelector('#name')?.focus({preventScroll: true}), reducedMotion.matches ? 0 : 500);
  });
});

// No backend: fall back to a pre-filled mailto. Never shows a fake success state.
const form = document.querySelector('#inquiry-form');
form?.addEventListener('submit', e => {
  e.preventDefault();
  const data = new FormData(form);
  const name = String(data.get('name') || '').trim();
  const email = String(data.get('email') || '').trim();
  const phone = String(data.get('phone') || '').trim();
  const message = String(data.get('message') || '').trim();
  const select = document.querySelector('#project-type');
  const selectedOption = select?.selectedOptions[0];
  const lang = currentLang();
  const projectTypeLabel = (lang === 'sq' ? selectedOption?.dataset.sq : selectedOption?.dataset.en) || String(data.get('projectType') || '');
  const subject = `${projectTypeLabel} — ${name}`;
  const bodyLines = [`Name: ${name}`, `Email: ${email}`, phone && `Phone: ${phone}`, `Project Type: ${projectTypeLabel}`, '', message].filter(Boolean).join('\n');
  window.location.href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines)}`;
});
</script>
</Layout>
