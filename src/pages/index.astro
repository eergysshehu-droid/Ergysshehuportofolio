---
import Layout from '../layouts/Layout.astro';
import LatestWork from '../components/LatestWork.astro';
import HomeHero from '../components/home/HomeHero.astro';
import FilmstripSection from '../components/home/FilmstripSection.astro';
import SelectedWorkSection from '../components/home/SelectedWorkSection.astro';
import RecognitionSection from '../components/home/RecognitionSection.astro';
import MotionSection from '../components/home/MotionSection.astro';
import JournalFeature from '../components/home/JournalFeature.astro';
import ArtistSection from '../components/home/ArtistSection.astro';
import HomeContact from '../components/home/HomeContact.astro';

import {
  content,
  photoUrl,
  safeUrl
} from '../lib/content';

import {
  journal
} from '../lib/journal';

import {
  defaults,
  recognitions
} from '../lib/editorial';

import {
  languageFromPath,
  localizedPath
} from '../lib/i18n';

const lang =
  languageFromPath(
    Astro.url.pathname
  );

const isSq =
  lang === 'sq';

const {
  settings: saved,
  albums
} = await content();

const journalFeature =
  (await journal())
    .slice(
      0,
      3
    );

const settings = {
  ...defaults,

  ...Object.fromEntries(
    Object.entries(
      saved
    ).filter(
      (
        [, value]
      ) =>
        value != null
    )
  )
};

const featuredAlbums =
  albums.filter(
    album =>
      album.featured
  );

const hero =
  saved.heroImage ||
  featuredAlbums[0]?.cover;

const selected = [
  ...featuredAlbums,

  ...albums.filter(
    album =>
      !album.featured
  )
];

const reel =
  safeUrl(
    saved.reelUrl
  );

const heroSeen =
  new Set<string>();

const photoKey = (
  photo?: {
    localBase?: string;
    src?: string;

    asset?: {
      _ref: string;
    };
  }
) =>
  photo?.localBase ||
  photo?.src ||
  photo?.asset?._ref ||
  '';


// The hero is a full-bleed, wide cinematic strip — a tall portrait crop
// (object-fit:cover) into that shape almost always crops badly. Only
// landscape/near-square covers are eligible for the rotation.

const isHeroShaped = (
  photo?: {
    width?: number;
    height?: number;
  }
) =>
  Boolean(
    photo?.width &&
    photo?.height &&
    photo.width /
      photo.height >=
      0.95
  );


const heroEligible =
  featuredAlbums.filter(
    album =>
      photoUrl(
        album.cover
      ) &&
      isHeroShaped(
        album.cover
      )
  );


const heroCandidates =
  heroEligible.length
    ? heroEligible
    : featuredAlbums.filter(
        album =>
          photoUrl(
            album.cover
          )
      );


const heroSlides =
  heroCandidates
    .filter(
      album => {
        const key =
          photoKey(
            album.cover
          );

        if (
          !key ||
          heroSeen.has(
            key
          )
        ) {
          return false;
        }

        heroSeen.add(
          key
        );

        return true;
      }
    )
    .slice(
      0,
      5
    )
    .map(
      album => ({
        photo:
          album.cover!,

        title:
          isSq
            ? (
                album.titleSq ||
                album.title
              )
            : album.title,

        href:
          localizedPath(
            `/portfolio/${album.slug}/`,
            lang
          )
      })
    );


if (
  hero &&
  photoUrl(
    hero
  ) &&
  isHeroShaped(
    hero
  )
) {
  const key =
    photoKey(
      hero
    );

  if (
    key &&
    !heroSeen.has(
      key
    )
  ) {
    heroSeen.add(
      key
    );

    heroSlides.unshift({
      photo:
        hero,

      title:
        featuredAlbums[0]
          ? (
              isSq
                ? (
                    featuredAlbums[0].titleSq ||
                    featuredAlbums[0].title
                  )
                : featuredAlbums[0].title
            )
          : settings.name,

      href:
        featuredAlbums[0]
          ? localizedPath(
              `/portfolio/${featuredAlbums[0].slug}/`,
              lang
            )
          : '#selected'
    });

    heroSlides.length =
      Math.min(
        heroSlides.length,
        5
      );
  }
}


const filmstripAlbums =
  (
    featuredAlbums.length >=
      4
      ? featuredAlbums
      : selected
  )
    .filter(
      album =>
        photoUrl(
          album.cover
        )
    )
    .slice(
      0,
      8
    );


const homeTitle =
  isSq
    ? 'Ergys Shehu — Fotograf, Videograf & Regjisor | Shqipëri'
    : 'Ergys Shehu — Photographer, Videographer & Director | Albania';


const homeDescription =
  isSq
    ? (
        settings.seoDescriptionSq ||
        settings.seoDescription
      )
    : settings.seoDescription;
---

<Layout
  home
  lang={lang}
  title={homeTitle}
  name={settings.name}
  description={homeDescription}
  image={
    hero &&
    photoUrl(
      hero,
      1800
    )
  }
>
  <div
    class="cinematic-intro"
    data-intro
    aria-hidden="true"
  >
    <div class="intro-brand">
      <strong>
        ERGYS
      </strong>

      <span>
        SHEHU
      </span>
    </div>

    <span class="intro-line"></span>

    <div class="intro-meta">
      <span>
        A VISUAL STORY AWAITS
      </span>

      <span>
        01 / 04
      </span>
    </div>

    <div class="intro-curtain intro-curtain-left"></div>
    <div class="intro-curtain intro-curtain-right"></div>
  </div>


  <div class="hero-scroll-scene">

    {
      heroSlides.length > 0 && (
        <HomeHero
          settings={settings}
          heroSlides={heroSlides}
          isSq={isSq}
        />
      )
    }


    {
      filmstripAlbums.length > 0 && (
        <FilmstripSection
          albums={filmstripAlbums}
          isSq={isSq}
          lang={lang}
        />
      )
    }


    <SelectedWorkSection
      albums={albums}
      selected={selected}
      isSq={isSq}
      lang={lang}
    />
  </div>


  {
    recognitions.length > 0 && (
      <RecognitionSection
        items={recognitions}
        isSq={isSq}
        lang={lang}
      />
    )
  }


  {
    reel && (
      <MotionSection
        reel={reel}
        isSq={isSq}
      />
    )
  }


  <LatestWork/>


  {
    journalFeature.length > 0 && (
      <JournalFeature
        posts={journalFeature}
        isSq={isSq}
        lang={lang}
      />
    )
  }


  <ArtistSection
    settings={settings}
    isSq={isSq}
    lang={lang}
  />


  <HomeContact
    settings={settings}
    isSq={isSq}
  />


  <script>
    import { initHomeIntro } from '../scripts/home-intro';
    import { initHomeHero } from '../scripts/home-hero';
    import { initFilmstrip } from '../scripts/filmstrip';
    import { initWorkFilters } from '../scripts/work-filters';

    initHomeIntro();
    initHomeHero();
    initFilmstrip();
    initWorkFilters();
  </script>
</Layout>
