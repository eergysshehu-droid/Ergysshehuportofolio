---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import LatestWork from '../components/LatestWork.astro';

import {
  content,
  photoUrl,
  photoSet,
  photoPosition,
  safeUrl
} from '../lib/content';

import {
  journal
} from '../lib/journal';

import {
  defaults,
  recognitions
} from '../lib/editorial';

import {
  languageFromPath,
  localizedPath
} from '../lib/i18n';

const lang =
  languageFromPath(
    Astro.url.pathname
  );

const isSq =
  lang === 'sq';

const {
  settings: saved,
  albums
} = await content();

const journalFeature =
  (await journal())
    .slice(
      0,
      3
    );

const journalDate = (
  iso: string
) =>
  new Date(
    iso
  ).toLocaleDateString(
    'en-GB',
    {
      day:
        'numeric',

      month:
        'long',

      year:
        'numeric'
    }
  );

const journalMonthsSq = [
  'janar',
  'shkurt',
  'mars',
  'prill',
  'maj',
  'qershor',
  'korrik',
  'gusht',
  'shtator',
  'tetor',
  'nëntor',
  'dhjetor'
];

const journalDateSq = (
  iso: string
) => {
  const d =
    new Date(
      iso
    );

  return `${d.getDate()} ${journalMonthsSq[d.getMonth()]} ${d.getFullYear()}`;
};

const settings = {
  ...defaults,

  ...Object.fromEntries(
    Object.entries(
      saved
    ).filter(
      (
        [, value]
      ) =>
        value != null
    )
  )
};

const featuredAlbums =
  albums.filter(
    album =>
      album.featured
  );

const hero =
  saved.heroImage ||
  featuredAlbums[0]?.cover;

const selected = [
  ...featuredAlbums,

  ...albums.filter(
    album =>
      !album.featured
  )
];

const reel =
  safeUrl(
    saved.reelUrl
  );

const heroSeen =
  new Set<string>();

const photoKey = (
  photo?: {
    localBase?: string;
    src?: string;

    asset?: {
      _ref: string;
    };
  }
) =>
  photo?.localBase ||
  photo?.src ||
  photo?.asset?._ref ||
  '';


// The hero is a full-bleed, wide cinematic strip — a tall portrait crop
// (object-fit:cover) into that shape almost always crops badly. Only
// landscape/near-square covers are eligible for the rotation.

const isHeroShaped = (
  photo?: {
    width?: number;
    height?: number;
  }
) =>
  Boolean(
    photo?.width &&
    photo?.height &&
    photo.width /
      photo.height >=
      0.95
  );


const heroPosition = (
  photo?: {
    hotspot?: {
      x?: number;
      y?: number;
    };
  }
) =>
  photo?.hotspot?.x != null &&
  photo?.hotspot?.y != null
    ? `${(
        photo.hotspot.x *
        100
      ).toFixed(
        1
      )}% ${(
        photo.hotspot.y *
        100
      ).toFixed(
        1
      )}%`
    : '50% 43%';


const heroEligible =
  featuredAlbums.filter(
    album =>
      photoUrl(
        album.cover
      ) &&
      isHeroShaped(
        album.cover
      )
  );


const heroCandidates =
  heroEligible.length
    ? heroEligible
    : featuredAlbums.filter(
        album =>
          photoUrl(
            album.cover
          )
      );


const heroSlides =
  heroCandidates
    .filter(
      album => {
        const key =
          photoKey(
            album.cover
          );

        if (
          !key ||
          heroSeen.has(
            key
          )
        ) {
          return false;
        }

        heroSeen.add(
          key
        );

        return true;
      }
    )
    .slice(
      0,
      5
    )
    .map(
      album => ({
        photo:
          album.cover!,

        title:
          isSq
            ? (
                album.titleSq ||
                album.title
              )
            : album.title,

        href:
          localizedPath(
            `/portfolio/${album.slug}/`,
            lang
          )
      })
    );


if (
  hero &&
  photoUrl(
    hero
  ) &&
  isHeroShaped(
    hero
  )
) {
  const key =
    photoKey(
      hero
    );

  if (
    key &&
    !heroSeen.has(
      key
    )
  ) {
    heroSeen.add(
      key
    );

    heroSlides.unshift({
      photo:
        hero,

      title:
        featuredAlbums[0]
          ? (
              isSq
                ? (
                    featuredAlbums[0].titleSq ||
                    featuredAlbums[0].title
                  )
                : featuredAlbums[0].title
            )
          : settings.name,

      href:
        featuredAlbums[0]
          ? localizedPath(
              `/portfolio/${featuredAlbums[0].slug}/`,
              lang
            )
          : '#selected'
    });

    heroSlides.length =
      Math.min(
        heroSlides.length,
        5
      );
  }
}


const filmstripAlbums =
  (
    featuredAlbums.length >=
      4
      ? featuredAlbums
      : selected
  )
    .filter(
      album =>
        photoUrl(
          album.cover
        )
    )
    .slice(
      0,
      8
    );


const homeTitle =
  isSq
    ? 'Ergys Shehu — Fotograf, Videograf & Regjisor | Shqipëri'
    : 'Ergys Shehu — Photographer, Videographer & Director | Albania';


const homeDescription =
  isSq
    ? (
        settings.seoDescriptionSq ||
        settings.seoDescription
      )
    : settings.seoDescription;
---

<Layout
  home
  lang={lang}
  title={homeTitle}
  name={settings.name}
  description={homeDescription}
  image={
    hero &&
    photoUrl(
      hero,
      1800
    )
  }
>
  <div
    class="cinematic-intro"
    data-intro
    aria-hidden="true"
  >
    <div class="intro-brand">
      <strong>
        ERGYS
      </strong>

      <span>
        SHEHU
      </span>
    </div>

    <span class="intro-line"></span>

    <div class="intro-meta">
      <span>
        A VISUAL STORY AWAITS
      </span>

      <span>
        01 / 04
      </span>
    </div>

    <div class="intro-curtain intro-curtain-left"></div>
    <div class="intro-curtain intro-curtain-right"></div>
  </div>


  <div class="hero-scroll-scene">

    <section
      class="opening cinematic-opening"
      aria-label="Selected photography"
      data-hero-rotator
    >
      <div class="opening-image">
        {
          heroSlides.map(
            (
              slide,
              i
            ) => (
              <picture
                class:list={[
                  'opening-frame',

                  {
                    'is-active':
                      i === 0
                  }
                ]}
                data-href={
                  slide.href
                }
                data-title={
                  slide.title
                }
                style={`--slide-pos:${heroPosition(slide.photo)}`}
              >
                {
                  i === 0 &&
                  slide.photo.localBase && (
                    <source
                      media="(max-width:700px)"
                      srcset="/images/dance-mobile.webp"
                    />
                  )
                }

                <img
                  src={
                    photoUrl(
                      slide.photo,
                      1800
                    )
                  }
                  srcset={
                    photoSet(
                      slide.photo
                    )
                  }
                  sizes="100vw"
                  alt={
                    isSq
                      ? (
                          slide.photo.altSq ||
                          slide.photo.alt ||
                          slide.title
                        )
                      : (
                          slide.photo.alt ||
                          slide.title
                        )
                  }
                  loading={
                    i === 0
                      ? undefined
                      : 'lazy'
                  }
                  fetchpriority={
                    i === 0
                      ? 'high'
                      : undefined
                  }
                  width={
                    slide.photo.width
                  }
                  height={
                    slide.photo.height
                  }
                />
              </picture>
            )
          )
        }
      </div>

      <div
        class="hero-light-sweep"
        data-hero-sweep
        aria-hidden="true"
      ></div>

      <h1 class="sr-only">
        {settings.name}
      </h1>

      <div class="hero-topline">
        <span
          data-en="Photographer / Director"
          data-sq="Fotograf / Regjisor"
        >
          {
            isSq
              ? 'Fotograf / Regjisor'
              : 'Photographer / Director'
          }
        </span>

        <span
          data-en="Albania · Available worldwide"
          data-sq="Shqipëri · I disponueshëm në mbarë botën"
        >
          {
            isSq
              ? 'Shqipëri · I disponueshëm në mbarë botën'
              : 'Albania · Available worldwide'
          }
        </span>
      </div>

      <div class="hero-feature">
        <a
          class="hero-project"
          href={
            heroSlides[0]?.href ||
            '#selected'
          }
          data-slide-link
          aria-label={`Selected work: ${heroSlides[0]?.title || ''}`}
        >
          <span
            class="hero-project-label"
            data-en="Selected work"
            data-sq="Punë e përzgjedhur"
          >
            {
              isSq
                ? 'Punë e përzgjedhur'
                : 'Selected work'
            }
          </span>

          <span class="hero-project-title">
            <span class="title-mask">
              <span data-slide-title>
                {
                  heroSlides[0]
                    ?.title
                }
              </span>
            </span>

            <span
              class="hero-project-arrow"
              aria-hidden="true"
            >
              ↗
            </span>
          </span>
        </a>

        {
          heroSlides.length >
            1 && (
            <div
              class="hero-meta"
              aria-hidden="true"
            >
              <span data-slide-count>
                01
              </span>

              {' / '}

              {
                String(
                  heroSlides.length
                ).padStart(
                  2,
                  '0'
                )
              }
            </div>
          )
        }

        {
          heroSlides.length >
            1 && (
            <div
              class="hero-progress"
              aria-hidden="true"
            >
              <span data-hero-progress></span>
            </div>
          )
        }

        <div class="hero-controls">
          <a
            class="hero-explore"
            href={
              heroSlides[0]?.href ||
              '#selected'
            }
            data-slide-link
            data-en="Explore the story"
            data-sq="Eksploro historinë"
          >
            {
              isSq
                ? 'Eksploro historinë'
                : 'Explore the story'
            }
          </a>

          {
            heroSlides.length >
              1 && (
              <div class="hero-nav-arrows">
                <button
                  type="button"
                  data-slide-prev
                  aria-label="Previous project"
                >
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M10 3L5 8l5 5"/>
                  </svg>
                </button>

                <span aria-hidden="true"></span>

                <button
                  type="button"
                  data-slide-next
                  aria-label="Next project"
                >
                  <svg
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M6 3l5 5-5 5"/>
                  </svg>
                </button>
              </div>
            )
          }
        </div>
      </div>

      <a
        class="scroll-indicator"
        href="#selected"
      >
        <span
          data-en="Scroll"
          data-sq="Zbrit"
        >
          {
            isSq
              ? 'Zbrit'
              : 'Scroll'
          }
        </span>

        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 6l5 5 5-5"/>
        </svg>
      </a>
    </section>


    {
      filmstripAlbums.length >
        0 && (
        <section class="filmstrip-section">
          <svg
            class="filmstrip-curve"
            viewBox="0 0 1000 100"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path d="M 0 100 C 20 88, 45 74, 75 66 C 105 59, 145 56, 195 56 L 805 56 C 855 56, 895 53, 925 46 C 955 38, 980 24, 1000 12 L 1000 100 Z"/>
          </svg>

          <div
            class="filmstrip-heading"
            data-reveal
          >
            <p
              class="kicker"
              data-en="FEATURED WORKS"
              data-sq="PUNË TË VEÇANTA"
            >
              {
                isSq
                  ? 'PUNË TË VEÇANTA'
                  : 'FEATURED WORKS'
              }
            </p>

            <h2
              data-en="Stories that feel real."
              data-sq="Histori që ndihen të vërteta."
            >
              {
                isSq
                  ? 'Histori që ndihen të vërteta.'
                  : 'Stories that feel real.'
              }
            </h2>

            <p
              class="filmstrip-copy"
              data-en="Photography, film and creative direction for people, brands and meaningful moments."
              data-sq="Fotografi, film dhe drejtim kreativ për njerëz, brande dhe momente që kanë kuptim."
            >
              {
                isSq
                  ? 'Fotografi, film dhe drejtim kreativ për njerëz, brande dhe momente që kanë kuptim.'
                  : 'Photography, film and creative direction for people, brands and meaningful moments.'
              }
            </p>

            <a
              class="filmstrip-view-all"
              href={
                localizedPath(
                  '/projects/',
                  lang
                )
              }
              data-en="VIEW ALL WORKS"
              data-sq="SHIKO GJITHË PUNËN"
            >
              {
                isSq
                  ? 'SHIKO GJITHË PUNËN'
                  : 'VIEW ALL WORKS'
              }

              {' '}

              <span aria-hidden="true">
                →
              </span>
            </a>
          </div>


          <div class="filmstrip-track-wrap">
            <div
              class="filmstrip-track"
              data-filmstrip
            >
              {
                filmstripAlbums.map(
                  (
                    album,
                    i
                  ) => {
                    const albumTitle =
                      isSq
                        ? (
                            album.titleSq ||
                            album.title
                          )
                        : album.title;

                    const albumAlt =
                      isSq
                        ? (
                            album.cover?.altSq ||
                            album.cover?.alt ||
                            albumTitle
                          )
                        : (
                            album.cover?.alt ||
                            albumTitle
                          );

                    return (
                      <a
                        class="filmstrip-item"
                        href={
                          localizedPath(
                            `/portfolio/${album.slug}/`,
                            lang
                          )
                        }
                      >
                        <div
                          class="filmstrip-image"
                          data-image-reveal
                          style={`--focal-point:${photoPosition(album.cover)}`}
                        >
                          <img
                            src={
                              photoUrl(
                                album.cover,
                                1000
                              )
                            }
                            srcset={
                              photoSet(
                                album.cover
                              )
                            }
                            sizes="(max-width:700px) 78vw, 26vw"
                            width={
                              album.cover
                                ?.width
                            }
                            height={
                              album.cover
                                ?.height
                            }
                            alt={
                              albumAlt
                            }
                            loading="lazy"
                            decoding="async"
                          />
                        </div>

                        <span class="filmstrip-counter">
                          {
                            String(
                              i + 1
                            ).padStart(
                              2,
                              '0'
                            )
                          }

                          {' / '}

                          {
                            String(
                              filmstripAlbums.length
                            ).padStart(
                              2,
                              '0'
                            )
                          }
                        </span>
                      </a>
                    );
                  }
                )
              }
            </div>

            <button
              type="button"
              class="filmstrip-next"
              data-filmstrip-next
              aria-label="Next"
            >
              <svg
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 3l5 5-5 5"/>
              </svg>
            </button>
          </div>

          <div
            class="section-veil"
            data-section-veil
            aria-hidden="true"
          ></div>
        </section>
      )
    }


    <section
      class="work-section"
      id="selected"
    >
      <div
        class="work-heading"
        data-reveal
      >
        <div>
          <p
            class="kicker"
            data-en="A SELECTED PERSPECTIVE"
            data-sq="NJË PERSPEKTIVË E PËRZGJEDHUR"
          >
            {
              isSq
                ? 'NJË PERSPEKTIVË E PËRZGJEDHUR'
                : 'A SELECTED PERSPECTIVE'
            }
          </p>

          <h2>
            <span
              data-en="Still."
              data-sq="Statike."
            >
              {
                isSq
                  ? 'Statike.'
                  : 'Still.'
              }
            </span>

            {' '}

            <em
              data-en="Never silent."
              data-sq="Kurrë e heshtur."
            >
              {
                isSq
                  ? 'Kurrë e heshtur.'
                  : 'Never silent.'
              }
            </em>
          </h2>
        </div>

        <span class="work-count">
          {
            String(
              albums.length
            ).padStart(
              2,
              '0'
            )
          }

          {' '}

          <span
            data-en="COLLECTIONS"
            data-sq="KOLEKSIONE"
          >
            {
              isSq
                ? 'KOLEKSIONE'
                : 'COLLECTIONS'
            }
          </span>
        </span>
      </div>


      <div
        class="work-toolbar"
        data-reveal
      >
        <div
          class="filters"
          role="group"
          aria-label="Filter projects"
        >
          <button
            data-filter="all"
            aria-pressed="true"
            data-en="All work"
            data-sq="Gjithë puna"
          >
            {
              isSq
                ? 'Gjithë puna'
                : 'All work'
            }
          </button>

          <button
            data-filter="fashion"
            aria-pressed="false"
            data-en="Fashion"
            data-sq="Modë"
          >
            {
              isSq
                ? 'Modë'
                : 'Fashion'
            }
          </button>

          <button
            data-filter="portraits"
            aria-pressed="false"
            data-en="Portraits"
            data-sq="Portrete"
          >
            {
              isSq
                ? 'Portrete'
                : 'Portraits'
            }
          </button>

          <button
            data-filter="weddings"
            aria-pressed="false"
            data-en="Weddings"
            data-sq="Dasma"
          >
            {
              isSq
                ? 'Dasma'
                : 'Weddings'
            }
          </button>

          <button
            data-filter="projects"
            aria-pressed="false"
            data-en="Personal"
            data-sq="Personale"
          >
            {
              isSq
                ? 'Personale'
                : 'Personal'
            }
          </button>
        </div>

        <a
          class="index-link"
          href={
            localizedPath(
              '/projects/',
              lang
            )
          }
          data-en="PROJECT INDEX ↗"
          data-sq="INDEKSI I PROJEKTEVE ↗"
        >
          {
            isSq
              ? 'INDEKSI I PROJEKTEVE ↗'
              : 'PROJECT INDEX ↗'
          }
        </a>
      </div>

      <ProjectGrid
        albums={selected}
      />

      <p
        class="work-empty"
        hidden
        data-en="No projects in this selection yet."
        data-sq="Ende s'ka projekte në këtë përzgjedhje."
      >
        {
          isSq
            ? "Ende s'ka projekte në këtë përzgjedhje."
            : 'No projects in this selection yet.'
        }
      </p>
    </section>
  </div>


  {
    recognitions.length >
      0 && (
      <section
        class="recognition-section"
        id="recognition"
      >
        <div
          class="recognition-heading"
          data-reveal
        >
          <p
            class="kicker"
            data-en="SELECTED RECOGNITION"
            data-sq="NJOHJE E PËRZGJEDHUR"
          >
            {
              isSq
                ? 'NJOHJE E PËRZGJEDHUR'
                : 'SELECTED RECOGNITION'
            }
          </p>
        </div>

        <div class="recognition-list">
          {
            recognitions.map(
              recognition => {
                const secondary =
                  recognition.project ||
                  recognition.organization ||
                  recognition.note;

                const Tag =
                  recognition.link
                    ? 'a'
                    : 'div';

                const href =
                  recognition.link
                    ? localizedPath(
                        recognition.link,
                        lang
                      )
                    : undefined;

                return (
                  <Tag
                    class="recognition-row"
                    data-reveal
                    {...(
                      href
                        ? {
                            href
                          }
                        : {}
                    )}
                  >
                    <span class="recognition-year">
                      {
                        recognition.year
                      }
                    </span>

                    <span class="recognition-body">
                      <span class="recognition-title">
                        {
                          recognition.title
                        }
                      </span>

                      {
                        secondary && (
                          <span class="recognition-sub">
                            {
                              secondary
                            }
                          </span>
                        )
                      }
                    </span>

                    {
                      recognition.link && (
                        <span
                          class="recognition-arrow"
                          aria-hidden="true"
                        >
                          ↗
                        </span>
                      )
                    }
                  </Tag>
                );
              }
            )
          }
        </div>
      </section>
    )
  }


  {
    reel && (
      <section class="motion-section">
        <p
          class="kicker"
          data-reveal
          data-en="MOVING IMAGE"
          data-sq="IMAZH NË LËVIZJE"
        >
          {
            isSq
              ? 'IMAZH NË LËVIZJE'
              : 'MOVING IMAGE'
          }
        </p>

        <h2
          data-reveal
          data-en="Beyond the still."
          data-sq="Përtej statikes."
        >
          {
            isSq
              ? 'Përtej statikes.'
              : 'Beyond the still.'
          }
        </h2>

        <a
          data-reveal
          href={reel}
          target="_blank"
          rel="noopener noreferrer"
          data-en="WATCH THE REEL ↗"
          data-sq="SHIKO REEL-IN ↗"
        >
          {
            isSq
              ? 'SHIKO REEL-IN ↗'
              : 'WATCH THE REEL ↗'
          }
        </a>
      </section>
    )
  }


  <LatestWork/>


  {
    journalFeature.length >
      0 && (
      <section class="journal-feature">
        <div
          class="journal-feature-heading"
          data-reveal
        >
          <div>
            <p
              class="kicker"
              data-en="THE JOURNAL"
              data-sq="DITARI"
            >
