---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import LatestWork from '../components/LatestWork.astro';
import {content,photoUrl,photoSet,safeUrl} from '../lib/content';
import {defaults} from '../lib/editorial';
const {settings:saved,albums}=await content();
const settings={...defaults,...Object.fromEntries(Object.entries(saved).filter(([,v])=>v!=null))};
const hero=saved.heroImage || albums.find(a=>a.featured)?.cover;
const selected=[...albums.filter(a=>a.featured),...albums.filter(a=>!a.featured)];
const reel=safeUrl(saved.reelUrl);
const heroSeen=new Set<string>();
const heroFrames=[hero,...albums.filter(a=>a.featured).map(a=>a.cover)].filter((p):p is NonNullable<typeof p>=>Boolean(p) && Boolean(photoUrl(p))).filter(p=>{const key=p.localBase||p.src||p.asset?._ref||'';if(!key||heroSeen.has(key))return false;heroSeen.add(key);return true;}).slice(0,5);
---
<Layout home name={settings.name} description={settings.seoDescription} image={hero && photoUrl(hero,1800)}>
<section class="opening" aria-label="Selected photography"><div class="opening-image" data-hero-rotator>{heroFrames.map((frame,i)=><picture class:list={['opening-frame',{'is-active':i===0}]}>{i===0 && frame.localBase && <source media="(max-width:700px)" srcset="/images/dance-mobile.webp"/>}<img src={photoUrl(frame,1800)} srcset={photoSet(frame)} sizes="100vw" alt={frame.alt || settings.name} loading={i===0?undefined:'lazy'} fetchpriority={i===0?'high':undefined} width={frame.width} height={frame.height}/></picture>)}</div><div class="opening-caption"><span>PHOTOGRAPHY & MOVING IMAGE</span><a href="#selected">EXPLORE THE WORK ↓</a></div><h1 class="opening-name">{settings.name}</h1><div class="opening-foot"><span>FASHION · BEAUTY · HUMAN STORIES · EST. 2017</span>{heroFrames.length>1 && <span data-hero-counter aria-hidden="true">01 / {String(heroFrames.length).padStart(2,'0')}</span>}</div></section>
<section class="work-section" id="selected"><div class="work-heading" data-reveal><div><p class="kicker">A SELECTED PERSPECTIVE</p><h2>Still. <em>Never silent.</em></h2></div><span class="work-count">{String(albums.length).padStart(2,'0')} COLLECTIONS</span></div><div class="work-toolbar"><div class="filters" role="group" aria-label="Filter projects"><button data-filter="all" aria-pressed="true">All work</button><button data-filter="fashion" aria-pressed="false">Fashion</button><button data-filter="portraits" aria-pressed="false">Portraits</button><button data-filter="weddings" aria-pressed="false">Weddings</button><button data-filter="projects" aria-pressed="false">Personal</button></div><a class="index-link" href="/projects/">PROJECT INDEX ↗</a></div><ProjectGrid albums={selected}/><p class="work-empty" hidden>No projects in this selection yet.</p></section>
{reel && <section class="motion-section" data-reveal><p class="kicker">MOVING IMAGE</p><h2>Beyond the still.</h2><a href={reel} target="_blank" rel="noopener noreferrer">WATCH THE REEL ↗</a></section>}
<LatestWork/>
<section class="artist-section" id="about" data-reveal><div class="artist-label"><span class="kicker">BEHIND THE LENS</span><span class="artist-number">ES / 01</span></div><div class="artist-copy"><h2>Purity.<br/>Simplicity.<br/><em>Honesty.</em></h2><p>{settings.bio}</p><a class="text-link" href="/about/">THE ARTIST · EN / SQ <span>↗</span></a></div></section>
<section class="contact-section" id="contact" data-reveal><div><p class="kicker">FOR COMMISSIONS & COLLABORATIONS</p><h2>Let’s make<br/><em>something matter.</em></h2></div><div class="contact-details">{settings.email && <a class="email" href={`mailto:${settings.email}`}>{settings.email} ↗</a>}<p>Based in Albania.<br/>Available worldwide.</p>{safeUrl(settings.instagram) && <a href={safeUrl(settings.instagram)} target="_blank" rel="noopener noreferrer">INSTAGRAM ↗</a>}</div></section>
<script>
const heroRoot=document.querySelector<HTMLElement>('[data-hero-rotator]');
const heroFrameEls=heroRoot?Array.from(heroRoot.querySelectorAll<HTMLElement>('.opening-frame')):[];
const heroCounter=document.querySelector<HTMLElement>('[data-hero-counter]');
if(heroFrameEls.length>1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
  let active=0;
  setInterval(()=>{
    heroFrameEls[active].classList.remove('is-active');
    active=(active+1)%heroFrameEls.length;
    heroFrameEls[active].classList.add('is-active');
    if(heroCounter)heroCounter.textContent=String(active+1).padStart(2,'0')+' / '+String(heroFrameEls.length).padStart(2,'0');
  },7000);
}
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));let count=0;document.querySelectorAll<HTMLElement>('[data-kind]').forEach(card=>{card.hidden=button.dataset.filter!=='all'&&card.dataset.kind!==button.dataset.filter;if(!card.hidden)count++});const empty=document.querySelector<HTMLElement>('.work-empty');if(empty)empty.hidden=count>0;}));
</script></Layout>
