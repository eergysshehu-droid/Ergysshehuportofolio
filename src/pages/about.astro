---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/about.css';
import {
  content,
  photoUrl,
  photoSet,
  safeUrl
} from '../lib/content';

import {
  defaults,
  biography,
  PERSON_ID,
  WEBSITE_ID
} from '../lib/editorial';

import {
  languageFromPath,
  localizedPath,
  localizedHref
} from '../lib/i18n';

const { settings } = await content();

const lang = languageFromPath(Astro.url.pathname);
const isSq = lang === 'sq';
const awardPhoto = settings.aboutAwardImage || settings.portrait;

const pageTitle = isSq
  ? 'Ergys Shehu — Fotograf, Videograf dhe Regjisor i Vlerësuar me Çmime'
  : 'Ergys Shehu — Award-Winning Photographer, Videographer & Director';

const aboutDescription = isSq
  ? 'Ergys Shehu është fotograf, videograf dhe regjisor shqiptar i vlerësuar me çmime, me përvojë në modë, portrete, dasma, ngjarje, fushata komerciale, videoklipe, projekte kulturore dhe bashkëpunime krijuese në Shqipëri dhe ndërkombëtarisht.'
  : 'Ergys Shehu is an award-winning photographer, videographer and director from Albania working across fashion, portraits, weddings, events, commercial campaigns, music videos, cultural projects and creative collaborations.';

const pageUrl = new URL(localizedPath('/about/', lang), 'https://ergysshehu.com').href;

const profilePageLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${pageUrl}#profilepage`,
  url: pageUrl,
  name: pageTitle,
  description: aboutDescription,
  inLanguage: lang,
  isPartOf: { '@id': WEBSITE_ID },
  mainEntity: { '@id': PERSON_ID }
};
---

<Layout
  lang={lang}
  title={pageTitle}
  description={aboutDescription}
  name={settings.name}
  image={awardPhoto ? photoUrl(awardPhoto, 1200) : undefined}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(profilePageLd)} />

  <section class="collection-intro about-intro v19-orbit-card">
    <div class="about-intro-copy">
      <a class="back-link" data-reveal href={localizedPath('/', lang)}>
        {isSq ? '← Punë të përzgjedhura' : '← Selected work'}
      </a>

      <p class="kicker" data-reveal>
        {isSq ? 'FOTOGRAF / REGJISOR / ARTIST VIZUAL' : 'PHOTOGRAPHER / DIRECTOR / VISUAL ARTIST'}
      </p>

      <h1 data-reveal>Ergys Shehu</h1>

      <p class="about-intro-bio" data-reveal>
        {isSq
          ? (settings.bioSq || settings.bio || defaults.bioSq || defaults.bio)
          : (settings.bio || defaults.bio)}
      </p>

      <div class="about-intro-meta" data-reveal>
        <div>
          <strong>{isSq ? 'SHQIPËRI / NDËRKOMBËTARISHT' : 'ALBANIA / WORLDWIDE'}</strong>
          <span>
            {isSq
              ? 'Fotografi · Film & drejtim kreativ · Pikturë & arte dekorative · Kurim kulturor'
              : 'Photography · Film & creative direction · Painting & decorative arts · Cultural curation'}
          </span>
        </div>

        <a href={localizedHref('/book/#contact', lang)}>
          {isSq ? 'Kontakto ↗' : 'Enquiries ↗'}
        </a>
      </div>
    </div>

    {awardPhoto && (
      <div class="about-intro-award" data-image-reveal>
        <img
          src={photoUrl(awardPhoto, 1200)}
          srcset={photoSet(awardPhoto)}
          sizes="(max-width: 700px) 86vw, 33vw"
          alt={isSq ? (awardPhoto.altSq || awardPhoto.alt || 'Ergys Shehu') : (awardPhoto.alt || 'Ergys Shehu')}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}
  </section>

  <section class="biography-layout collection-body about-biography about-biography-single">
    <div class="about-story about-story-wide" data-reveal>
      <details class="bio-language" open={!isSq}>
        <summary>English <span>EN</span></summary>
        <p lang="en">{settings.biographyEn || biography.en}</p>
      </details>

      <details class="bio-language" open={isSq}>
        <summary>Shqip <span>SQ</span></summary>
        <p lang="sq">{settings.biographySq || biography.sq}</p>
      </details>

      <blockquote>
        “{isSq ? (settings.artistQuoteSq || settings.artistQuote || biography.quote) : (settings.artistQuote || biography.quote)}”
        <cite>— Ergys Shehu</cite>
      </blockquote>

      <div class="bio-milestones">
        <p><span>2017</span>{isSq ? 'Themeloi ALERDIGITALMEDIA' : 'Founded ALERDIGITALMEDIA'}</p>
        <p><span>2020</span>“Loving Art” · Netët e Klipit Shqiptar</p>
        <p><span>2026</span>Best Director & Best Female Performance · “Kujtimi”</p>
        <p>
          {safeUrl(defaults.kult360)
            ? <a href={safeUrl(defaults.kult360)} target="_blank" rel="noopener noreferrer"><span>KULT 360</span>{isSq ? 'Drejtor Ekzekutiv ↗' : 'Executive Director ↗'}</a>
            : <><span>KULT 360</span>{isSq ? 'Drejtor Ekzekutiv' : 'Executive Director'}</>}
        </p>
      </div>
    </div>
  </section>

  <section class="about-cta v19-orbit-card" data-reveal>
    <p class="about-cta-kicker">
      {isSq ? 'PROJEKTE / KOMISIONE / BASHKËPUNIME' : 'PROJECTS / COMMISSIONS / COLLABORATIONS'}
    </p>

    <div class="about-cta-grid">
      <h2>{isSq ? 'Le të krijojmë diçka që mbahet mend.' : 'Let’s make something worth remembering.'}</h2>

      <div class="about-cta-copy">
        <p>
          {isSq
            ? 'I hapur për projekte të përzgjedhura në fotografi, film, modë, portrete, fushata dhe bashkëpunime krijuese në Shqipëri dhe ndërkombëtarisht.'
            : 'Available for selected photography, film, fashion, portrait, campaign and creative collaborations in Albania and worldwide.'}
        </p>

        <a class="about-cta-link" href={localizedHref('/book/#contact', lang)}>
          <span>{isSq ? 'Le të flasim' : 'Let’s talk'}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
