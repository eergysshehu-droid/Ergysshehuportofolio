---
import Layout from '../layouts/Layout.astro';

import {
  languageFromPath,
  localizedPath
} from '../lib/i18n';

const lang =
  languageFromPath(
    Astro.url.pathname
  );

const isSq =
  lang === 'sq';
---

<Layout
  lang={lang}
  title={
    isSq
      ? 'Faqja nuk u gjet — Ergys Shehu'
      : 'Page not found — Ergys Shehu'
  }
  noindex
>
  <section class="collection-intro">
    <p class="kicker">
      404
    </p>

    <h1>
      {
        isSq
          ? 'Jashtë kuadrit.'
          : 'Out of frame.'
      }
    </h1>

    <p>
      {
        isSq
          ? 'Kjo faqe nuk u gjet.'
          : 'This page could not be found.'
      }
    </p>

    <a
      class="cta-row"
      href={
        localizedPath(
          '/',
          lang
        )
      }
    >
      <span
        class="circle-btn"
        aria-hidden="true"
      >
        ↗
      </span>

      <span>
        {
          isSq
            ? 'KTHEHU TE PORTOFOLI'
            : 'BACK TO PORTFOLIO'
        }
      </span>
    </a>
  </section>
</Layout>
