---
import Layout from '../layouts/Layout.astro';

import {
  languageFromPath,
  localizedPath
} from '../lib/i18n';

const lang =
  languageFromPath(
    Astro.url.pathname
  );

const isSq =
  lang === 'sq';
---

<Layout
  lang={lang}
  title={
    isSq
      ? 'Faqja nuk u gjet — Ergys Shehu'
      : 'Page not found — Ergys Shehu'
  }
  noindex
>
  <section class="collection-intro">
    <p class="kicker">
      404
    </p>

    <h1
      data-en="Out of frame."
      data-sq="Jashtë kuadrit."
    >
      {
        isSq
          ? 'Jashtë kuadrit.'
          : 'Out of frame.'
      }
    </h1>

    <p
      data-en="This page could not be found."
      data-sq="Kjo faqe nuk u gjet."
    >
      {
        isSq
          ? 'Kjo faqe nuk u gjet.'
          : 'This page could not be found.'
      }
    </p>

    <a
      class="cta-row"
      data-404-home
      href={
        localizedPath(
          '/',
          lang
        )
      }
    >
      <span class="circle-btn">
        ↗
      </span>

      <span
        data-en="BACK TO PORTFOLIO"
        data-sq="KTHEHU TE PORTOFOLI"
      >
        {
          isSq
            ? 'KTHEHU TE PORTOFOLI'
            : 'BACK TO PORTFOLIO'
        }
      </span>
    </a>
  </section>

  <script is:inline>
    (() => {
      /*
       * Static Astro builds one physical 404 document. Cloudflare serves that
       * document while keeping the originally requested URL in the browser.
       * Resolve SQ from the real request pathname before Layout's shared
       * language runtime runs, so /sq/... 404s keep Albanian UI.
       */
      const isSq404 =
        window.location.pathname === '/sq/' ||
        window.location.pathname.startsWith('/sq/');

      if (!isSq404) return;

      document.documentElement.lang = 'sq';
      document.title = 'Faqja nuk u gjet — Ergys Shehu';

      const home = document.querySelector('[data-404-home]');

      if (home) {
        home.setAttribute('href', '/sq/');
      }
    })();
  </script>
</Layout>
