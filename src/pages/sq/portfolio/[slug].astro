---
import ProjectPage from '../../portfolio/[slug].astro';

import {
  content,
  type Album,
  type Settings
} from '../../../lib/content';

export async function getStaticPaths() {
  const {
    albums,
    settings
  } = await content();

  return albums.map(
    (
      album,
      index
    ) => ({
      params: {
        slug:
          album.slug
      },

      props: {
        album,
        settings,

        nextAlbum:
          albums.length > 1
            ? albums[
                (
                  index +
                  1
                ) %
                albums.length
              ]
            : undefined
      }
    })
  );
}

interface Props {
  album: Album;
  settings: Settings;
  nextAlbum?: Album;
}

const props =
  Astro.props as Props;
---

<ProjectPage {...props} />
