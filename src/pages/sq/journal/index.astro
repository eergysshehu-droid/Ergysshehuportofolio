---
import Layout from '../../../layouts/Layout.astro';

import {
  content,
  photoUrl,
  photoSet,
  photoPosition
} from '../../../lib/content';

import {
  journal
} from '../../../lib/journal';

import {
  defaults
} from '../../../lib/editorial';

const {settings: saved} =
  await content();

const settings = {
  ...defaults,
  ...Object.fromEntries(
    Object.entries(saved)
      .filter(([, value]) =>
        value != null
      )
  )
};

const posts =
  await journal();

const monthsSq = [
  'janar',
  'shkurt',
  'mars',
  'prill',
  'maj',
  'qershor',
  'korrik',
  'gusht',
  'shtator',
  'tetor',
  'nëntor',
  'dhjetor'
];

const formatDateSq = (
  iso: string
) => {
  const date =
    new Date(iso);

  return `${date.getDate()} ${monthsSq[date.getMonth()]} ${date.getFullYear()}`;
};

const dateLine = (
  post: {
    category?: string;
    categorySq?: string;
    publishedAt: string;
  }
) => {
  const category =
    post.categorySq ||
    post.category;

  return `${
    category
      ? category + ' / '
      : ''
  }${formatDateSq(post.publishedAt)}`;
};
---

<Layout
  lang="sq"
  title={`Ditari — ${settings.name}`}
  name={settings.name}
  description={
    settings.seoDescriptionSq ||
    'Arkivi editorial i Ergys Shehu për fotografi, regji, kulturë, çmime dhe punë të publikuara.'
  }
>
  <section class="collection-intro">
    <a
      class="back-link"
      data-reveal
      href="/sq/"
    >
      ← Ballina
    </a>

    <p
      class="kicker"
      data-reveal
    >
      DITARI / {String(posts.length).padStart(2, '0')} SHKRIME
    </p>

    <h1 data-reveal>
      Ditari.
    </h1>

    <p data-reveal>
      Fotografi, regji, njohje dhe punë e publikuar — arkivi pas portofolit.
    </p>
  </section>

  <section class="journal-list">
    {
      posts.length
        ? posts.map(post => {
            const title =
              post.titleSq ||
              post.title;

            const excerpt =
              post.excerptSq ||
              post.excerpt;

            const date =
              dateLine(post);

            return (
              <a
                class="journal-card"
                data-reveal
                href={`/sq/journal/${post.slug}/`}
              >
                {
                  post.cover &&
                  photoUrl(post.cover) && (
                    <div
                      class="journal-card-image"
                      data-image-reveal
                      style={`--focal-point:${photoPosition(post.cover)}`}
                    >
                      <img
                        src={photoUrl(
                          post.cover,
                          900
                        )}
                        srcset={photoSet(
                          post.cover
                        )}
                        sizes="(max-width:700px) 90vw, 42vw"
                        width={
                          post.cover.width
                        }
                        height={
                          post.cover.height
                        }
                        alt={
                          post.cover.altSq ||
                          post.cover.alt ||
                          title
                        }
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )
                }

                <div class="journal-card-copy">
                  <span class="journal-date">
                    {date}
                  </span>

                  <h2>
                    {title}
                  </h2>

                  <p>
                    {excerpt}
                  </p>

                  <span class="journal-read">
                    Lexo{' '}
                    <span aria-hidden="true">
                      ↗
                    </span>
                  </span>
                </div>
              </a>
            );
          })
        : (
          <div
            class="collection-empty"
            data-reveal
          >
            <p class="kicker">
              SË SHPEJTI
            </p>

            <h2>
              Shkrimi i parë po vjen së shpejti.
            </h2>
          </div>
        )
    }
  </section>
</Layout>
